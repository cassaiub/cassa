---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/immersive/AnimatedHero.astro";
import AnimatedBand from "../components/immersive/AnimatedBand.astro";
import Reveal from "../components/immersive/Reveal.astro";
import Prose from "../components/immersive/Prose.astro";
import { withBase } from "../data/site-nav.ts";
import { BANGLA_SERIES } from "../data/bangla-series.ts";
---

<BaseLayout
  title="Outreach — CASSA"
  description="CASSA's public outreach: the Durbin astronomy programme, the Bangladesh Olympiad on Astronomy & Astrophysics (BDOAA), and a Bengali-language popular-astronomy writing programme."
  current="/outreach"
>
  <AnimatedHero
    theme="galaxy"
    eyebrow="Outreach"
    title="Outreach"
    lede="Bringing astronomy to the public — through Durbin, the Bangladesh Olympiad on Astronomy & Astrophysics, and writing the cosmos in Bangla."
  />

  <!-- Intro (elevated, right after the dark hero) -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Our mission</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>Astronomy, shared widely</h2>
          <p>
            Outreach is one of CASSA's three founding missions. It runs through two national
            programmes — <strong>Durbin</strong> and the <strong>Bangladesh Olympiad on Astronomy &amp;
            Astrophysics (BDOAA)</strong> — both supervised by the Center's Directors, alongside a
            Bengali-language popular-astronomy writing programme and public astronomy nights at the
            rooftop <a href={withBase('/research/core')}>IUB CORE</a> observatory.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- Durbin -->
  <section class="section section--elev-2">
    <div class="wrap">
      <Reveal><p class="eyebrow">Programme</p></Reveal>
      <Reveal delay={60}><h2 class="oa-h2">Durbin</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            <strong>Durbin</strong> — Bangla for binoculars or a telescope — is CASSA's volunteer-based
            astronomy outreach initiative, built around astrophotography, immersive content, school
            visits, and public "Astronomy Nights." It was founded on <strong>9 March 2023</strong> by
            <strong>Dr. Lamiya Mowla</strong>, seeded by the University of Toronto's Dunlap Institute for
            Astronomy &amp; Astrophysics. From May 2026 it is supported by a British Council Bangladesh
            arts grant through Women of the World.
          </p>
          <p>
            Volunteers form fixed teams each cycle to develop lasting materials from Durbin
            astrophotography, operate telescopes at public events and remote imaging camps, and produce
            prints and visual-art installations of deep-sky imagery. Completers receive a Letter of
            Experience.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- In Bangla band -->
  <AnimatedBand theme="cosmic">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">In Bangla</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:24ch">Writing the cosmos in our own language</h2>
    </Reveal>
  </AnimatedBand>

  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Bengali article series</p></Reveal>
      <Reveal delay={60}>
        <Prose>
          <p>
            CASSA writes astronomy for a Bengali-reading public across two article series — from new
            research explained simply, to popular-science writing. Read them all in the
            <a href={withBase('/outreach/bangla')}>Bangla section →</a>
          </p>
        </Prose>
      </Reveal>
      <div class="oa-series">
        {BANGLA_SERIES.map((s, i) => (
          <Reveal class="oa-series__card-wrap" delay={90 + i * 50}>
            <a class="oa-series__card" href={withBase(`/outreach/bangla#${s.id}`)}>
              <span class="oa-series__name" lang="bn">{s.name}</span>
              <span class="oa-series__roman">{s.roman}</span>
              <span class="oa-series__desc">{s.desc}</span>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- BDOAA -->
  <section class="section">
    <div class="wrap">
      <Reveal><p class="eyebrow">Programme</p></Reveal>
      <Reveal delay={60}><h2 class="oa-h2">BDOAA</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            The <strong>Bangladesh Olympiad on Astronomy and Astrophysics (BDOAA)</strong> is CASSA's
            national educational programme, with its office at the CASSA rooftop and national rounds
            funded by IUB's Department of Physical Sciences since 2020. Through regional and national
            rounds it selects the K–12 team that represents Bangladesh at the
            <strong> International Olympiad on Astronomy and Astrophysics (IOAA)</strong> and IOAA Junior,
            and runs workshops and conferences by and for school students.
          </p>
          <p>
            All outreach with minors is governed by CASSA's safeguarding policy, with a
            zero-tolerance-to-inaction stance and trained safeguarding focal points at every event.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .oa-h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); letter-spacing: -.015em; margin: .3rem 0 0; color: var(--ink); }

  .oa-series { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
  @media (max-width: 620px) { .oa-series { grid-template-columns: 1fr; } }
  .oa-series__card {
    display: flex; flex-direction: column; gap: .3rem; height: 100%;
    background: var(--bg-elev-2); border: 1px solid var(--line); border-left: 3px solid var(--accent-2);
    border-radius: 14px; padding: 1.1rem 1.25rem; transition: border-color .2s, transform .2s;
  }
  .oa-series__card:hover { border-color: color-mix(in srgb, var(--accent-2) 45%, transparent); transform: translateY(-2px); }
  [data-theme="light"] .oa-series__card { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }
  .oa-series__name { font-size: 1.25rem; font-weight: 700; color: var(--ink); line-height: 1.3; }
  .oa-series__roman { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--accent-2); }
  .oa-series__desc { font-size: .9rem; color: var(--ink-soft); line-height: 1.6; margin-top: .15rem; }
</style>
