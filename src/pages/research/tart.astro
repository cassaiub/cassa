---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import SkyCanvas from "../../components/SkyCanvas.tsx";
import AnimatedBand from "../../components/immersive/AnimatedBand.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import Prose from "../../components/immersive/Prose.astro";
import HeroIdent from "../../components/immersive/HeroIdent.astro";
import { withBase } from "../../data/site-nav.ts";
import tartArray from "../../assets/heroes/tart-array.webp";

// ── Open-source links (verified live, June 2026) ──────────────────────────
const docs = [
  { href: "https://tart.elec.ac.nz/doc/", name: "Documentation home", desc: "The full TART docs hub" },
  { href: "https://tart.elec.ac.nz/doc/docs/intro/", name: "TART in 5 minutes", desc: "A quick overview of how it works" },
  { href: "https://tart.elec.ac.nz/doc/docs/basics/get-tart-data/", name: "Getting data from TART", desc: "Download visibilities from the API" },
  { href: "https://tart.elec.ac.nz/doc/docs/basics/making-images/", name: "Making images", desc: "Turn visibilities into all-sky images" },
  { href: "https://tart.elec.ac.nz/doc/docs/basics/tart-api/", name: "The TART API", desc: "REST endpoints for every telescope" },
  { href: "https://pypi.org/project/tart-tools/", name: "tart-tools on PyPI", desc: "pip3 install tart-tools" },
];

const repos = [
  { href: "https://github.com/tart-telescope", name: "tart-telescope (GitHub org)", desc: "Hardware, firmware, web app & infrastructure" },
  { href: "https://github.com/tmolteno/tart_modules", name: "tart_modules", desc: "Core Python library + command-line tools" },
  { href: "https://github.com/tmolteno/TART", name: "TART", desc: "PCB designs & FPGA firmware — the hardware root" },
  { href: "https://github.com/tart-telescope/tart2ms", name: "tart2ms", desc: "Convert TART data to CASA Measurement Sets" },
  { href: "https://github.com/tart-telescope/sbc_code", name: "sbc_code", desc: "On-telescope software + the REST API server" },
  { href: "https://github.com/tart-telescope/web_app", name: "web_app", desc: "The live telescope dashboard front-end" },
  { href: "https://github.com/tart-telescope/notebooks", name: "notebooks", desc: "Example Jupyter notebooks using TART data" },
];
---

<BaseLayout
  title="TART — CASSA Research"
  description="TART (Transient Array Radio Telescope) is CASSA's radio instrument at IUB CORE — Bangladesh's first radio telescope and the country's only aperture-synthesis radio array, with its 24-antenna array fabricated at the IUB Fab Lab and assembled during CASSA Workshop 2."
  current="/research/tart"
>
  <!-- ── Hero — the real TART array floating over a galaxy sky ──────────── -->
  <header class="hero hero--sky tart-hero" data-tart-hero>
    <HeroIdent />
    <div class="hero__media"><SkyCanvas theme="galaxy" client:load /></div>

    <!-- Floating array: the actual fabricated TART structure -->
    <div class="tart-hero__stage" data-tart-parallax aria-hidden="true">
      <div class="tart-hero__halo"></div>
      <Image
        class="tart-hero__array"
        src={tartArray}
        alt=""
        widths={[700, 1100, 1800]}
        sizes="(max-width: 760px) 92vw, 60vw"
        fetchpriority="high"
        loading="eager"
      />
    </div>

    <div class="hero__scrim tart-hero__scrim"></div>

    <div class="wrap hero__inner">
      <p class="eyebrow">Research · Facilities</p>
      <h1 class="hero__title">TART</h1>
      <p class="hero__lede">
        Transient Array Radio Telescope — CASSA's radio instrument at IUB CORE
        (Campus Observatory for Research and Education), and Bangladesh's first radio
        telescope. A 24-antenna aperture-synthesis array built at IUB — the only
        synthesis-array radio telescope in the country.
      </p>
    </div>

    <div class="hero__cue" aria-hidden="true"><span></span></div>
  </header>

  <!-- ── Facility sub-nav strip ─────────────────────────────────────────── -->
  <nav style="background:var(--bg-elev);border-bottom:1px solid var(--line)">
    <div class="wrap" style="display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;padding-block:.85rem">
      <a href={withBase('/research')} style="color:var(--ink-faint);font-size:.85rem;padding:.3rem .7rem;border-radius:999px">← Research</a>
      {[
        { href: "/research/core", label: "IUB CORE" },
        { href: "/research/hpc", label: "Timaeus HPC" },
        { href: "/research/tart", label: "TART" },
      ].map(s => (
        <a href={withBase(s.href)} style={`font-size:.85rem;padding:.3rem .75rem;border-radius:999px;${s.href === '/research/tart' ? 'background:var(--accent);color:#1a1206;font-weight:600' : 'color:var(--ink-soft);border:1px solid var(--line)'}`}>{s.label}</a>
      ))}
    </div>
  </nav>

  <!-- ── Section 1: Overview ────────────────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Radio Telescope</p></Reveal>
      <Reveal delay={70}>
        <h2 class="section-h2">About TART</h2>
      </Reveal>
      <Reveal delay={120}>
        <Prose>
          <p>
            TART — the Transient Array Radio Telescope — is CASSA's radio
            instrument, housed at IUB CORE on the rooftop of the Main Academic
            Building. Every one of its <strong>24 all-sky GPS antennas</strong> is correlated
            with every other to form <strong>276 baselines</strong>, and an open-source
            aperture-synthesis pipeline turns those into a full-sky radio image about
            <strong>once a minute</strong>. It is operated by CASSA as part of the RAIN
            (Radio Astronomy Instrumentation) research area.
          </p>
        </Prose>
      </Reveal>

      <div class="pg">
        {[
          { label: "Full Name", value: "Transient Array Radio Telescope (TART)" },
          { label: "Location", value: "IUB CORE, Main Academic Building rooftop, IUB Bashundhara" },
          { label: "Array", value: "24 GPS/GNSS antennas · L1 band, 1.575 GHz · 276 baselines · full-sky image every minute" },
          { label: "First Light", value: "18 November 2025, during CASSA Workshop 2" },
        ].map((card, i) => (
          <Reveal class="card" delay={i * 80}>
            <p class="eyebrow" style="font-size:.75rem">{card.label}</p>
            <p style="color:var(--ink-soft);margin-top:.6rem;font-size:.97rem;line-height:1.6">{card.value}</p>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── AnimatedBand — How it was built ────────────────────────────────── -->
  <AnimatedBand theme="cosmic">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">How it was built</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:22ch">
        An international partnership, assembled at IUB
      </h2>
    </Reveal>
  </AnimatedBand>

  <!-- ── Section: How it was built (build narrative + partnership) ──────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">The build · a partnership</p></Reveal>
      <Reveal delay={70}>
        <h2 class="section-h2">An international partnership</h2>
      </Reveal>
      <Reveal delay={120}>
        <Prose>
          <p>
            TART at IUB is the product of an international collaboration. The receivers and
            digital electronics — the heart of the instrument — were designed and supplied by
            the open-source TART project at the University of Otago, New Zealand. The antenna
            array was fabricated at the IUB Fab Lab, and CASSA provided the rooftop site,
            student researchers, and project coordination, with funding from IUB.
          </p>
          <p>
            After more than six months of work — held up for a time by electronic
            complications — the instrument was assembled and brought online during
            <a href={withBase('/teaching/workshops/cw2-en')}>CASSA Workshop 2</a>,
            <em>"Installing a Radio Telescope to Image the Invisible"</em> (17–21 November 2025).
            It detected its first radio signals on 18 November 2025, under the supervision of
            Dr. Tim Molteno, who brought the final electronic components that completed the
            build. Thirty students from eleven universities took part in the hands-on assembly.
          </p>
          <p style="font-size:.95rem">
            Read the full story:
            <a href={withBase('/news/tart-installation')} style="color:var(--accent)">IUB launches Bangladesh's first TART →</a>
          </p>
        </Prose>
      </Reveal>

      <div class="credits-grid">
        {[
          {
            label: "Receivers & electronics",
            value: "Dr. Tim Molteno and his team at the University of Otago, New Zealand — the open-source TART project that designed and supplied the receivers and electronics.",
          },
          {
            label: "Array structure",
            value: "Designed and fabricated at the IUB Fabrication Laboratory (Fab Lab) by Shoaib Mirza, with students Yusa Islam and Md. Shahadat Hossain Shahal.",
          },
          {
            label: "Space, location & student expertise",
            value: "CASSA — the rooftop site at IUB CORE, project leadership, and the student researchers who built and now operate the telescope.",
          },
          {
            label: "Funding",
            value: "The Department of Physical Sciences, IUB, together with CASSA.",
          },
        ].map((card, i) => (
          <Reveal class="card" delay={i * 80}>
            <p class="eyebrow" style="font-size:.72rem;color:var(--accent)">{card.label}</p>
            <p style="color:var(--ink-soft);margin-top:.65rem;font-size:.98rem;line-height:1.65">{card.value}</p>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Section 4: Live from TART (embedded map + viewer) ──────────────── -->
  <section class="section section--elev-2">
    <div class="wrap">
      <Reveal><p class="eyebrow">Live data</p></Reveal>
      <Reveal delay={70}>
        <h2 class="section-h2">Live from TART</h2>
      </Reveal>
      <Reveal delay={120}>
        <Prose>
          <p>
            TART images the entire sky about once a minute and shares it live across a
            worldwide network of low-cost array telescopes. Explore the global network below —
            Bangladesh's <code>bd-iub</code> node joins telescopes across Africa and New Zealand.
          </p>
        </Prose>
      </Reveal>
    </div>

    <!-- Full-bleed worldwide network map -->
    <Reveal delay={160}>
      <div class="embed embed--full">
        <div class="wrap embed-head">
          <h3>Worldwide TART network</h3>
          <a href="https://map.elec.ac.nz/" target="_blank" rel="noopener">Open the interactive map ↗</a>
        </div>
        <div class="map-shell embed-frame--full">
          <iframe
            class="embed-frame map-shell__frame"
            src="https://map.elec.ac.nz/"
            title="Live map of the worldwide TART network"
            loading="lazy"
            scrolling="no"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <div class="map-guard" data-map-guard aria-hidden="true">
            <span class="map-guard__hint">Hold <kbd>Ctrl</kbd> and scroll to zoom · drag to pan</span>
          </div>
        </div>
        <p class="wrap embed-cap">
          Each marker is a live TART node sharing full-sky data. Bangladesh's
          <code>bd-iub</code> is the network's newest member, alongside telescopes across
          Africa and New Zealand.
        </p>
      </div>
    </Reveal>
  </section>

  <!-- ── AnimatedBand — Science ─────────────────────────────────────────── -->
  <AnimatedBand theme="lensing">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Science</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:22ch">
        What TART observes
      </h2>
    </Reveal>
  </AnimatedBand>

  <!-- ── Section 5: Science ─────────────────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Science Capabilities</p></Reveal>
      <Reveal delay={70}>
        <h2 class="section-h2">Radio science with TART</h2>
      </Reveal>
      <Reveal delay={120}>
        <Prose>
          <p>
            TART is the foundation of CASSA's in-house radio observation programme and a
            hands-on training ground for student researchers. As part of the RAIN research
            area, it is a testbed for the calibration workflows, primary-beam characterisation,
            and data-reduction pipelines that carry directly across to far larger arrays such as
            LOFAR and the Square Kilometre Array (SKA).
          </p>
        </Prose>
      </Reveal>

      <div class="pg">
        {[
          {
            label: "Transient Detection",
            desc: "Catching short-lived radio events — cosmic rays and other transients — that optical telescopes miss",
          },
          {
            label: "Ionospheric Science",
            desc: "Measuring the total electron content (TEC) of Earth's ionosphere using GNSS signals",
          },
          {
            label: "Calibration Research",
            desc: "Using the many GPS satellites overhead as bright references to characterise the array's beam and gains",
          },
          {
            label: "Pipeline Development",
            desc: "Building synthesis-imaging and calibration pipelines that scale to LOFAR and the SKA",
          },
        ].map((card, i) => (
          <Reveal class="card" delay={i * 90}>
            <h3 style="font-size:1.1rem;color:var(--ink)">{card.label}</h3>
            <p style="color:var(--ink-soft);margin-top:.7rem;font-size:.97rem;line-height:1.65">{card.desc}</p>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Section 6: Open source — code & tutorials ──────────────────────── -->
  <section class="section">
    <div class="wrap">
      <Reveal><p class="eyebrow">Open source</p></Reveal>
      <Reveal delay={70}>
        <h2 class="section-h2">Build with TART</h2>
      </Reveal>
      <Reveal delay={120}>
        <Prose>
          <p>
            TART is fully open source — hardware, FPGA firmware, and imaging software, all
            under GPLv3 and stewarded by the Electronics Research Foundation in New Zealand.
            Every visibility and image is public, so the whole pipeline is reproducible end to
            end. Install the Python tools with <code>pip3 install tart-tools</code>.
          </p>
        </Prose>
      </Reveal>

      <div class="links-grid">
        <Reveal delay={160}>
          <div class="card">
            <p class="eyebrow" style="font-size:.72rem;color:var(--accent)">Tutorials & documentation</p>
            <ul class="link-list">
              {docs.map(l => (
                <li>
                  <a class="link-row" href={l.href} target="_blank" rel="noopener">
                    <span class="link-name">{l.name} ↗</span>
                    <span class="link-desc">{l.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </Reveal>

        <Reveal delay={210}>
          <div class="card">
            <p class="eyebrow" style="font-size:.72rem;color:var(--accent)">Code on GitHub</p>
            <ul class="link-list">
              {repos.map(l => (
                <li>
                  <a class="link-row" href={l.href} target="_blank" rel="noopener">
                    <span class="link-name">{l.name} ↗</span>
                    <span class="link-desc">{l.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <script is:inline>
    /* Hero parallax — the floating array drifts with the pointer and scroll */
    (() => {
      const hero = document.querySelector('[data-tart-hero]');
      const stage = hero && hero.querySelector('[data-tart-parallax]');
      if (!hero || !stage || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let mx = 0, my = 0;
      const apply = () => {
        const sc = Math.min(window.scrollY, window.innerHeight) * 0.16;
        stage.style.transform = `translate3d(${mx}px, ${my + sc}px, 0)`;
      };
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        mx = ((e.clientX - r.left) / r.width - 0.5) * 28;
        my = ((e.clientY - r.top) / r.height - 0.5) * 18;
        apply();
      });
      hero.addEventListener('pointerleave', () => { mx = 0; my = 0; apply(); });
      window.addEventListener('scroll', apply, { passive: true });
      apply();
    })();
  </script>

  <script is:inline>
    (() => {
      const guard = document.querySelector('[data-map-guard]');
      if (!guard) return;
      let flashTimer;
      // Plain scroll passes through to the page; flash the "hold Ctrl" hint.
      guard.addEventListener('wheel', (e) => {
        if (e.ctrlKey || e.metaKey) return;
        guard.classList.add('is-flash');
        clearTimeout(flashTimer);
        flashTimer = setTimeout(() => guard.classList.remove('is-flash'), 1200);
      }, { passive: true });
      // Holding Ctrl/⌘ hands interaction (zoom + pan) to the map.
      const setPass = (on) => guard.classList.toggle('is-pass', on);
      window.addEventListener('keydown', (e) => { if (e.key === 'Control' || e.key === 'Meta') setPass(true); });
      window.addEventListener('keyup', (e) => { if (e.key === 'Control' || e.key === 'Meta') setPass(false); });
      window.addEventListener('blur', () => setPass(false));
    })();
  </script>

</BaseLayout>

<style>
  /* ── Floating TART-array hero ───────────────────────────────────────── */
  .tart-hero__scrim {
    background:
      linear-gradient(to top, rgba(2,4,12,.92) 0%, rgba(2,4,12,.55) 32%, rgba(2,4,12,.12) 60%, transparent 100%);
    z-index:-2;
  }
  /* Day theme: the galaxy canvas repaints pale (SkyCanvas), so the scrim
     flips pale too — :global() because data-theme lives on <html>. */
  :global([data-theme="light"]) .tart-hero__scrim {
    background:
      linear-gradient(to top, rgba(244,246,251,.92) 0%, rgba(244,246,251,.5) 32%, rgba(244,246,251,.1) 60%, transparent 100%);
  }
  .tart-hero__stage {
    position:absolute; inset:0; z-index:-1; pointer-events:none;
    display:grid; place-items:center; padding-bottom:14vh;
    transition:transform .25s ease-out;
  }
  .tart-hero__halo, .tart-hero__array { grid-area:1/1; }
  .tart-hero__halo {
    width:min(78vw,1000px); aspect-ratio:1; border-radius:50%;
    background:radial-gradient(circle, rgba(96,148,236,.30), rgba(96,148,236,.07) 46%, transparent 70%);
    filter:blur(8px); animation:tartPulse 9s ease-in-out infinite;
  }
  .tart-hero__array {
    width:min(58vw,720px); height:auto; object-fit:contain;
    filter:drop-shadow(0 34px 60px rgba(0,0,0,.55)) drop-shadow(0 0 46px rgba(120,170,255,.20));
    animation:tartFloat 15s ease-in-out infinite;
    will-change:transform;
  }
  @keyframes tartFloat {
    0%,100% { transform:translateY(-2.5%) rotate(-1.3deg); }
    50%     { transform:translateY(2.5%)  rotate(1.3deg); }
  }
  @keyframes tartPulse {
    0%,100% { opacity:.65; transform:scale(1); }
    50%     { opacity:1;   transform:scale(1.06); }
  }
  @media (max-width:760px) {
    .tart-hero__stage { padding-bottom:30vh; place-items:start center; padding-top:12vh; }
    .tart-hero__array { width:90vw; }
    .tart-hero__halo  { width:96vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tart-hero__array, .tart-hero__halo, .tart-hero__stage { animation:none; transition:none; }
  }

  .pg { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-top:2rem; }
  @media (max-width:860px) { .pg { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:540px) { .pg { grid-template-columns:1fr; } }
  .section-h2 { font-size:clamp(1.6rem,3.4vw,2.3rem); letter-spacing:-.015em; margin:.3rem 0 0; color:var(--ink); }

  /* Credits — 2×2 grid */
  .credits-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; margin-top:2rem; }
  @media (max-width:640px) { .credits-grid { grid-template-columns:1fr; } }

  /* Embedded live map + viewer */
  .embed { margin-top:1.75rem; }
  .embed-head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.5rem; margin-bottom:.7rem; }
  .embed-head h3 { font-size:1.05rem; color:var(--ink); margin:0; }
  .embed-head a { font-size:.85rem; color:var(--accent); white-space:nowrap; }
  .embed-frame { width:100%; height:560px; border:1px solid var(--line); border-radius:14px; background:var(--bg-elev); display:block; }
  @media (max-width:640px) { .embed-frame { height:440px; } }
  .embed-cap { margin-top:.65rem; font-size:.85rem; color:var(--ink-faint); line-height:1.55; }

  /* Wide worldwide network map — taller & immersive, with small side gutters */
  .embed-frame--full { height:min(85vh,920px); width:calc(100% - 2 * clamp(2rem,7vw,6rem)); margin-inline:clamp(2rem,7vw,6rem); }
  @media (max-width:640px) { .embed-frame--full { height:72vh; } }

  /* Scroll-guard: page scrolls over the map; hold Ctrl/⌘ to interact (zoom/pan) */
  .map-shell { position:relative; border-radius:14px; overflow:hidden; }
  .map-shell__frame { width:100%; height:100%; border:1px solid var(--line); border-radius:14px; transition:filter .35s ease; }
  /* The TART map is hard-wired dark (CARTO dark tiles, no theme API). It can't
     be driven cross-origin, so in light mode we invert it to match the site. */
  :global([data-theme="light"]) .map-shell__frame { filter:invert(1) hue-rotate(180deg) brightness(1.05) contrast(.92); }
  .map-guard { position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:center; pointer-events:auto; cursor:default; }
  .map-guard.is-pass { pointer-events:none; }   /* Ctrl held → interaction reaches the map */
  .map-guard__hint { margin-bottom:1.1rem; padding:.5rem .9rem; border-radius:999px; background:rgba(8,10,20,.72); color:#fff; font-size:.85rem; opacity:0; transform:translateY(.4rem); transition:opacity .2s, transform .2s; }
  .map-guard.is-flash .map-guard__hint { opacity:1; transform:none; }
  .map-guard__hint kbd { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.82em; background:rgba(255,255,255,.18); padding:.05em .4em; border-radius:5px; }

  /* Open-source link columns */
  .links-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; margin-top:2rem; align-items:start; }
  @media (max-width:760px) { .links-grid { grid-template-columns:1fr; } }
  .link-list { list-style:none; margin:1rem 0 0; padding:0; display:flex; flex-direction:column; gap:.1rem; }
  .link-row { display:flex; flex-direction:column; gap:.12rem; padding:.6rem .7rem; margin-inline:-.7rem; border-radius:10px; text-decoration:none; transition:background-color .15s; }
  .link-row:hover, .link-row:focus-visible { background:var(--line); }
  .link-name { color:var(--ink); font-size:.97rem; font-weight:600; }
  .link-row:hover .link-name, .link-row:focus-visible .link-name { color:var(--accent); }
  .link-desc { color:var(--ink-faint); font-size:.85rem; line-height:1.45; }

  code { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.88em; background:var(--line); padding:.12em .42em; border-radius:6px; color:var(--ink); }
</style>
