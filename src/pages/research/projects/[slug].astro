---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AnimatedHero from "../../../components/immersive/AnimatedHero.astro";
import Reveal from "../../../components/immersive/Reveal.astro";
import Prose from "../../../components/immersive/Prose.astro";
import { withBase } from "../../../data/site-nav.ts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.status !== "draft");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const fullName = d.acronym && d.title.includes(":") ? d.title.slice(d.title.indexOf(":") + 1).trim() : "";
const stage = d.stage ?? "ongoing";
const stageLabel = stage === "completed" ? "Completed" : "Ongoing";
const supers = [...(d.coSupervisors ?? []), ...(d.supervisor ? [d.supervisor] : [])];
const links = Object.entries(d.links ?? {});
const isExternal = (href: string) => /^https?:\/\//.test(href) || href.startsWith("mailto:");
---

<BaseLayout
  title={`${d.acronym ?? d.title} — CASSA Research Projects`}
  description={d.summary}
  current="/research/projects"
>
  <AnimatedHero
    theme="cosmic"
    eyebrow="Research · Projects"
    title={d.acronym ?? d.title}
    lede={fullName || d.summary}
  />

  <section class="section section--elev">
    <div class="wrap">
      <Reveal>
        <a class="pback" href={withBase("/research/projects")}><span aria-hidden="true">←</span> All research projects</a>
      </Reveal>

      <div class="pdetail">
        <Reveal class="pbody">
          <Prose>
            <Content />
          </Prose>
        </Reveal>

        <Reveal class="pmeta" delay={80}>
          {supers.length > 0 && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">{supers.length > 1 ? "Supervisors" : "Supervisor"}</p>
              <ul class="pmeta__list">{supers.map((s) => <li>{s}</li>)}</ul>
            </div>
          )}
          {d.leads.length > 0 && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">{d.leads.length === 1 ? "Lead" : "Leads"}</p>
              <ul class="pmeta__list">
                {d.leads.map((l) => <li>{l}</li>)}
              </ul>
            </div>
          )}
          {d.mentors.length > 0 && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">{d.mentors.length === 1 ? "Mentor" : "Mentors"}</p>
              <ul class="pmeta__list">
                {d.mentors.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          )}
          {d.team.length > 0 && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">Team</p>
              <ul class="pmeta__list">
                {d.team.map((l) => <li>{l}</li>)}
              </ul>
            </div>
          )}
          {d.alumni.length > 0 && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">Alumni</p>
              <ul class="pmeta__list">
                {d.alumni.map((l) => <li>{l}</li>)}
              </ul>
            </div>
          )}
          {d.startDate && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">Timeline</p>
              <p class="pmeta__dates">{d.startDate}{d.endDate ? ` – ${d.endDate}` : (stage === "completed" ? "" : " – present")}</p>
            </div>
          )}
          <div class="pmeta__block">
            <p class="pmeta__lbl">Status</p>
            <span class={`pmeta__stage pmeta__stage--${stage}`}>{stageLabel}</span>
          </div>
          {links.length > 0 && (
            <div class="pmeta__block">
              <p class="pmeta__lbl">Links</p>
              <ul class="pmeta__list pmeta__links">
                {links.map(([label, href]) => (
                  <li>
                    <a
                      href={isExternal(href) ? href : withBase(href)}
                      target={isExternal(href) && !href.startsWith("mailto:") ? "_blank" : undefined}
                      rel={isExternal(href) && !href.startsWith("mailto:") ? "noopener noreferrer" : undefined}
                    >{label} <span aria-hidden="true">→</span></a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pback { display: inline-block; color: var(--ink-faint); font-size: 0.9rem; transition: color 0.2s; }
  .pback:hover { color: var(--accent); }

  .pdetail {
    display: grid; gap: clamp(1.8rem, 4vw, 3.2rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    align-items: start; margin-top: 1.8rem;
  }
  @media (max-width: 820px) { .pdetail { grid-template-columns: minmax(0, 1fr); } }
  .pbody :global(.prose-cassa) { margin-inline: 0; }

  /* Sidebar — an elegant sectioned "credits" panel: hairline-divided blocks,
     supervisor + lead first, then team/alumni, then status. */
  .pmeta {
    display: flex; flex-direction: column;
    background:
      radial-gradient(120% 60% at 100% 0%, color-mix(in srgb, var(--accent) 6%, transparent), transparent 55%),
      var(--bg-elev);
    border: 1px solid var(--line); border-radius: 18px;
    padding: 0.4rem 1.5rem 0.7rem; position: sticky; top: 5.5rem;
  }
  :global([data-theme="light"]) .pmeta { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 12px 30px rgba(12,18,34,.05); }
  @media (max-width: 820px) { .pmeta { position: static; } }

  .pmeta__block { padding: 1.15rem 0; border-top: 1px solid var(--line); }
  .pmeta__block:first-child { border-top: 0; }
  .pmeta__lbl {
    margin: 0 0 0.6rem; font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 700; color: var(--ink-faint);
  }

  .pmeta__stage {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
    padding: 0.3rem 0.65rem 0.3rem 0.55rem; border-radius: 999px; border: 1px solid var(--line);
  }
  .pmeta__stage::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .pmeta__stage--ongoing {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .pmeta__stage--completed { color: var(--ink-faint); }

  .pmeta__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .pmeta__list li { color: var(--ink); font-size: 0.92rem; line-height: 1.45; }
  .pmeta__dates { margin: 0; color: var(--ink); font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .pmeta__links a { color: var(--ink-soft); font-size: 0.92rem; transition: color 0.2s; }
  .pmeta__links a:hover { color: var(--accent); }
</style>
