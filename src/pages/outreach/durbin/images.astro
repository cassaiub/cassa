---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AnimatedHero from "../../../components/immersive/AnimatedHero.astro";
import Reveal from "../../../components/immersive/Reveal.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { withBase } from "../../../data/site-nav.ts";

const all = await getCollection("astrophotography", ({ data }) => data.status !== "draft");

const objType = (e: (typeof all)[number]) =>
  e.data.categories.find((c) => !["Durbin", "Featured"].includes(c)) ?? e.data.categories[0] ?? "Other";

const CAT_ORDER = ["Galaxies", "Nebulae", "Globular clusters", "Stars and systems", "Galaxy groups and clusters", "Solar System", "Comets", "Intergalactic medium"];
const ord = (c: string) => (CAT_ORDER.indexOf(c) + 1 || 99);

all.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const cats = [...new Set(all.map(objType))].sort((a, b) => ord(a) - ord(b));
---

<BaseLayout
  title="Astrophotographic Images — CASSA"
  description="Deep-sky astrophotography from CASSA's Durbin programme — galaxies, nebulae, clusters, comets and planets imaged with the Center's telescopes."
  current="/outreach"
>
  <AnimatedHero
    theme="galaxy"
    eyebrow="Outreach · Durbin"
    title="Astrophotographic Images"
    lede="Deep-sky objects imaged by CASSA's Durbin volunteers — galaxies, nebulae, clusters, comets and planets."
  />

  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">The collection</p></Reveal>
      <Reveal delay={60}><h2 class="gx-h2">{all.length} objects</h2></Reveal>

      <Reveal delay={110}>
        <nav class="nffilter" aria-label="Filter by object type">
          <button class="nf-chip" data-filter="all" aria-pressed="true">All</button>
          {cats.map((c) => (
            <button class="nf-chip" data-filter={c} aria-pressed="false">{c}</button>
          ))}
        </nav>
      </Reveal>

      <ul class="ggrid">
        {all.map((e, i) => (
          <li data-cat={objType(e)}>
            <a class="gtile" href={withBase(`/outreach/durbin/images/${e.id}`)} data-reveal style={`--reveal-delay:${Math.min(i, 10) * 25}ms`}>
              <span class="gtile__media">
                <Image src={e.data.image} alt={e.data.imageAlt ?? e.data.title} widths={[300, 480, 600]} sizes="(max-width:560px) 50vw, (max-width:980px) 33vw, 260px" loading="lazy" />
              </span>
              <span class="gtile__bar">
                <span class="gtile__name">{e.data.title}</span>
                <span class="gtile__tag">{objType(e)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .gx-h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); letter-spacing: -.015em; margin: .3rem 0 0; color: var(--ink); font-variant-numeric: tabular-nums; }

  .ggrid { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  @media (max-width: 560px) { .ggrid { grid-template-columns: repeat(2, 1fr); gap: .7rem; } }

  .gtile { display: block; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--bg-elev-2); transition: border-color .2s, transform .2s; }
  .gtile:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); transform: translateY(-3px); }
  [data-theme="light"] .gtile { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }
  .gtile__media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #05070d; }
  .gtile__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .gtile:hover .gtile__media :global(img) { transform: scale(1.06); }
  .gtile__bar { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .8rem 1rem; }
  .gtile__name { color: var(--ink); font-weight: 600; font-size: .96rem; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gtile:hover .gtile__name { color: var(--accent); }
  .gtile__tag { flex-shrink: 0; font-size: .54rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; padding: .28em .6em; border-radius: 999px; color: var(--accent-2); border: 1px solid color-mix(in srgb, var(--accent-2) 45%, transparent); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .gtile, .gtile__media :global(img) { transition: none; }
    .gtile:hover, .gtile:hover .gtile__media :global(img) { transform: none; }
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".nf-chip"));
  const tiles = Array.from(document.querySelectorAll<HTMLElement>("li[data-cat]"));
  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const f = chip.getAttribute("data-filter");
      for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
      for (const t of tiles) t.hidden = !(f === "all" || t.getAttribute("data-cat") === f);
    });
  }
</script>
