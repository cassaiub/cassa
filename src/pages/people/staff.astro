---
const lastName = (n: string) => n.trim().split(/\s+/).at(-1) ?? n;
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import PersonCard from "../../components/PersonCard.astro";
import { withBase } from "../../data/site-nav.ts";

/* ── Subpage navigation ──────────────────────────────────────────────── */
const subNav = [
  { href: "/people/directors",      label: "Directors" },
  { href: "/people/core-associate", label: "Core & Associate" },
  { href: "/people/grad-affiliates", label: "Graduate & Affiliates" },
  { href: "/people/staff",          label: "Staff" },
  { href: "/people/student-ras",    label: "Research Assistants" },
  { href: "/people/interns",        label: "Interns & Undergraduates" },
];
const currentHref = "/people/staff";

/* ── Content query ───────────────────────────────────────────────────── */
const allPeople = await getCollection("people", ({ data }) => data.status === "published");

const staff = allPeople
  .filter((p) => p.data.tier === "Staff")
  .sort((a, b) => lastName(a.data.name).localeCompare(lastName(b.data.name)));
---

<BaseLayout
  title="Administrative Staff — CASSA People"
  description="The operations team that keeps CASSA's science running — from HPC management to outreach project coordination."
  current="/people"
>

  <!-- ── Fullscreen hero ───────────────────────────────────────────────── -->
  <AnimatedHero
    theme="cosmic"
    eyebrow="People · Administrative Staff"
    title="Administrative Staff"
    lede="The operations team that keeps CASSA's science running — from HPC management to outreach project coordination."
  />

  <!-- ── Subpage pill navigation ───────────────────────────────────────── -->
  <div class="subnav-wrap">
    <div class="wrap subnav-inner">
      <a class="back-link" href={withBase("/people")}>← All People</a>
      <nav class="pill-strip" aria-label="People subpages">
        {subNav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={["subnav-pill", { "subnav-pill--active": item.href === currentHref }]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- ── Section A: Administrative & Technical Staff ─────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Operations</p></Reveal>
      <Reveal delay={60}>
        <h2 class="section-h2">Administrative & Technical Staff</h2>
      </Reveal>

      {staff.length > 0 ? (
        <div class="card-grid" style="margin-top:2.2rem">
          {staff.map((p, i) => (
            <Reveal delay={i * 120}>
              <PersonCard
                name={p.data.name}
                title={p.data.title}
                tier={p.data.tier}
                interests={p.data.interests}
                institution={p.data.institution}
                email={p.data.email}
                photo={p.data.photo}
                links={p.data.links}
              />
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal delay={80}>
          <p class="empty-note">Staff profiles will appear here once they are published.</p>
        </Reveal>
      )}

      <Reveal delay={140}>
        <div style="margin-top:3rem;padding:1.6rem;background:var(--bg-elev-2);border-radius:16px;border:1px solid var(--line);max-width:700px">
          <p class="eyebrow" style="font-size:.68rem">About these roles</p>
          <p style="color:var(--ink-soft);margin-top:.8rem;font-size:.95rem;line-height:1.7">
            The Science Manager (Muhammad Jobair Hasan) reports to the Directors and oversees daily observatory and lab operations. The Project Manager, Durbin (Farzana Akter Lima) coordinates the Durbin outreach programme, reporting jointly to both Directors.
          </p>
        </div>
      </Reveal>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Section heading ────────────────────────────────────────────────── */
  .section-h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    letter-spacing: -0.015em;
    margin: 0.3rem 0 0;
    color: var(--ink);
  }

  /* ── Card grid ──────────────────────────────────────────────────────── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.2rem;
  }
  @media (max-width: 860px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .card-grid { grid-template-columns: 1fr; } }

  /* ── Subpage nav strip ──────────────────────────────────────────────── */
  .subnav-wrap {
    background: var(--bg-elev);
    border-bottom: 1px solid var(--line);
    padding: 0.85rem 0;
  }

  .subnav-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .pill-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .subnav-pill {
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .subnav-pill:hover:not(.subnav-pill--active) {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .subnav-pill--active {
    background: var(--accent);
    color: #1a1206;
    font-weight: 600;
    border-color: transparent;
  }

  /* ── Empty state ────────────────────────────────────────────────────── */
  .empty-note {
    color: var(--ink-faint);
    font-size: 0.95rem;
    margin-top: 2rem;
    max-width: 60ch;
  }
</style>
