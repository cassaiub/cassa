---
const lastName = (n: string) => n.trim().split(/\s+/).at(-1) ?? n;
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import PersonCard from "../../components/PersonCard.astro";
import { withBase } from "../../data/site-nav.ts";

/* ── Content ──────────────────────────────────────────────────────────── */
const allPeople = await getCollection("people", ({ data }) => data.status === "published");

const uras = allPeople
  .filter((p) => p.data.tier === "Undergraduate Research Assistant")
  .sort((a, b) => lastName(a.data.name).localeCompare(lastName(b.data.name)));

/* ── Subpage nav ──────────────────────────────────────────────────────── */
const CURRENT_HREF = "/people/undergraduate-ras";
const subNav = [
  { href: "/people/director",             label: "Office of the Director" },
  { href: "/people/core-members",         label: "Core Members" },
  { href: "/people/associate-members",    label: "Associate Members" },
  { href: "/people/affiliates",           label: "Affiliates" },
  { href: "/people/research-assistants",  label: "Research Assistants" },
  { href: "/people/undergraduate-ras",    label: "Undergraduate RAs" },
  { href: "/people/research-interns",     label: "Research Interns" },
];
---

<BaseLayout
  title="Undergraduate RAs — CASSA People"
  description="The undergraduate research assistants on duty at CASSA — IUB's paid on-campus posts for currently enrolled undergraduates."
  current="/people/undergraduate-ras"
>
  <!-- ── Fullscreen hero ──────────────────────────────────────────────── -->
  <AnimatedHero
    theme="galaxy"
    eyebrow="People · Undergraduate RAs"
    title="Undergraduate RAs"
    lede="IUB's paid on-campus posts for currently enrolled undergraduates, working inside CASSA's research programmes."
  />

  <!-- ── Subpage navigation pill-strip ────────────────────────────────── -->
  <nav style="border-bottom:1px solid var(--line);background:var(--bg-elev)">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:.5rem;padding-block:.85rem">
      <a href={withBase('/people')} style="color:var(--ink-faint);font-size:.85rem;padding:.3rem .7rem;border-radius:999px">← All People</a>
      {subNav.map(s => (
        <a
          href={withBase(s.href)}
          style={`font-size:.85rem;padding:.3rem .75rem;border-radius:999px;${
            s.href === CURRENT_HREF
              ? 'background:var(--accent);color:#1a1206;font-weight:600'
              : 'color:var(--ink-soft);border:1px solid var(--line)'
          }`}
        >{s.label}</a>
      ))}
    </div>
  </nav>

  <!-- ── Section A: Undergraduate Research Assistants ─────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Undergraduate RAs</p></Reveal>
      <Reveal delay={60}>
        <h2 style="font-size:clamp(1.6rem,3.4vw,2.3rem);letter-spacing:-.015em;margin:.3rem 0 0;color:var(--ink)">
          Undergraduate Research Assistants
        </h2>
      </Reveal>

      {uras.length > 0 ? (
        <div class="pg">
          {uras.map((p, i) => (
            <Reveal delay={(i % 3) * 80}>
              <PersonCard
                name={p.data.name}
                title={p.data.title}
                tier={p.data.tier}
                interests={p.data.interests}
                institution={p.data.institution}
                email={p.data.email}
                photo={p.data.photo}
                links={p.data.links}
              />
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal delay={80}>
          <p style="color:var(--ink-faint);font-size:.95rem;margin-top:2rem;max-width:60ch">
            No Undergraduate Research Assistants are on duty at the moment — the cohort turns over
            each semester.
          </p>
        </Reveal>
      )}

      <Reveal delay={160}>
        <p style="color:var(--ink-faint);font-size:.85rem;margin-top:1.8rem;max-width:65ch">
          URA positions are open to undergraduate students from IUB and partner institutions.
        </p>
      </Reveal>
    </div>
  </section>

</BaseLayout>

<style>
.pg {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 2.2rem;
}
@media (max-width: 860px) { .pg { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .pg { grid-template-columns: 1fr; } }
</style>
