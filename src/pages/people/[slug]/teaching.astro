---
/* Per-person teaching page. Immersive overview of every course taught — stats,
   data-driven charts (students/year, a term×year load heatmap, courses by
   enrolment) and an expandable per-course breakdown. Dynamic + gated: only
   people whose ProfileData has a `teaching` block get this route. NO grades. */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AnimatedHero from "../../../components/immersive/AnimatedHero.astro";
import Reveal from "../../../components/immersive/Reveal.astro";
import { withBase } from "../../../data/site-nav.ts";
import { PROFILES } from "../../../data/people/profiles.ts";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return Object.keys(PROFILES)
    .filter((slug) => PROFILES[slug].teaching)
    .map((slug) => people.find((p) => p.id === slug))
    .filter((e): e is NonNullable<typeof e> => Boolean(e))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const profile = PROFILES[entry.id];
const teaching = profile.teaching!;

const TORD: Record<string, number> = { Spring: 1, Summer: 2, Autumn: 3, Fall: 3, Winter: 4 };
const TERMS = ["Spring", "Summer", "Autumn"];
const sumStu = (offs: { students: number }[]) => offs.reduce((s, o) => s + o.students, 0);

/* Per-course aggregates */
const courses = teaching.courses
  .map((c) => {
    const students = sumStu(c.offerings);
    const trimSet = new Set(c.offerings.map((o) => `${o.term} ${o.year}`));
    // group offerings by trimester for the breakdown
    const byTrim = new Map<string, { term: string; year: number; sections: number; students: number; rooms: Set<string> }>();
    for (const o of c.offerings) {
      const k = `${o.year}-${TORD[o.term] ?? 9}-${o.term}`;
      if (!byTrim.has(k)) byTrim.set(k, { term: o.term, year: o.year, sections: 0, students: 0, rooms: new Set() });
      const t = byTrim.get(k)!;
      t.sections++; t.students += o.students; if (o.room) t.rooms.add(o.room);
    }
    const trimesters = [...byTrim.values()].sort((a, b) => a.year - b.year || (TORD[a.term] ?? 9) - (TORD[b.term] ?? 9));
    return { ...c, students, sections: c.offerings.length, nTrim: trimSet.size, trimesters };
  })
  .sort((a, b) => b.students - a.students || b.sections - a.sections);

/* Global stats */
const allOff = teaching.courses.flatMap((c) => c.offerings);
const totalStudents = sumStu(allOff);
const totalSections = allOff.length;
const yrs = allOff.map((o) => o.year);
const yearMin = Math.min(...yrs), yearMax = Math.max(...yrs);
const yearsArr = Array.from({ length: yearMax - yearMin + 1 }, (_, i) => yearMin + i);
const allTrim = new Set(allOff.map((o) => `${o.term} ${o.year}`));

/* Chart 1 — students per year */
const studentsByYear: Record<number, number> = {};
for (const o of allOff) studentsByYear[o.year] = (studentsByYear[o.year] ?? 0) + o.students;
const maxYearStu = Math.max(1, ...Object.values(studentsByYear));

/* Chart 2 — term × year load heatmap (sections + students per cell) */
type Cell = { sections: number; students: number };
const grid: Record<string, Cell> = {};
for (const o of allOff) {
  const k = `${o.year}|${o.term}`;
  if (!grid[k]) grid[k] = { sections: 0, students: 0 };
  grid[k].sections++; grid[k].students += o.students;
}
const maxCellSec = Math.max(1, ...Object.values(grid).map((c) => c.sections));

/* Chart 3 — courses by enrolment */
const maxCourseStu = Math.max(1, ...courses.map((c) => c.students));

const STATS = [
  { n: courses.length.toString(), label: "Unique courses" },
  { n: totalSections.toString(), label: "Sections taught" },
  { n: totalStudents.toLocaleString(), label: "Student enrolments" },
  { n: allTrim.size.toString(), label: "Trimesters active" },
  { n: `${yearMin}–${yearMax}`, label: "Span", raw: true },
];

const last = entry.data.name.split(/\s+/).at(-1);
---

<BaseLayout
  title={`Teaching — ${entry.data.name}`}
  description={`Every course taught by ${entry.data.name} at IUB since ${yearMin}, with enrolment.`}
  current={`/people/${entry.id}`}
>
  <AnimatedHero
    theme="galaxy"
    eyebrow="People · Teaching"
    title={`${last}'s Teaching`}
    lede={teaching.intro ?? `Courses taught by ${entry.data.name}.`}
  />

  <!-- ── Back-link strip ──────────────────────────────────────────────── -->
  <nav style="border-bottom:1px solid var(--line);background:var(--bg-elev)">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:.5rem;padding-block:.85rem">
      <a href={withBase(`/people/${entry.id}`)} style="color:var(--ink-faint);font-size:.85rem;padding:.3rem .7rem;border-radius:999px">← Back to {last}'s profile</a>
      <a href={withBase('/people')} style="color:var(--ink-faint);font-size:.85rem;padding:.3rem .7rem;border-radius:999px">All People</a>
    </div>
  </nav>

  <!-- ── At a glance ──────────────────────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">At a glance</p></Reveal>
      <Reveal delay={50}>
        <div class="t-stats">
          {STATS.map((s) => (
            <div class="t-stat">
              <span class="t-stat__n">{s.n}</span>
              <span class="t-stat__l">{s.label}</span>
            </div>
          ))}
        </div>
      </Reveal>

      <!-- Charts — two columns: (enrolments/year + courses by enrolment) | load heatmap -->
      <div class="charts">
        <div class="charts-left">
        <Reveal class="chart-card" delay={90}>
          <p class="eyebrow chart-h">Student enrolments per year</p>
          <div class="bars" role="img" aria-label="Bar chart of student enrolments per year">
            {yearsArr.map((y) => {
              const v = studentsByYear[y] ?? 0;
              return (
                <div class="bar-col">
                  <div class="bar" style={`height:${Math.max(2, Math.round((v / maxYearStu) * 100))}%`} data-label={`${v} students · ${y}`}>
                    <span class="bar-v">{v}</span>
                  </div>
                  <span class="bar-x">{y}</span>
                </div>
              );
            })}
          </div>
        </Reveal>

        <Reveal class="chart-card" delay={120}>
          <p class="eyebrow chart-h">Courses by total enrolment</p>
          <div class="hbars">
            {courses.map((c) => (
              <div class="hbar">
                <span class="hbar__lbl" title={c.name}>{c.code}</span>
                <span class="hbar__track">
                  <span class="hbar__fill" style={`width:${Math.max(1.5, Math.round((c.students / maxCourseStu) * 100))}%`}></span>
                </span>
                <span class="hbar__n">{c.students.toLocaleString()}</span>
              </div>
            ))}
          </div>
        </Reveal>

        </div>

        <Reveal class="chart-card" delay={150}>
          <p class="eyebrow chart-h">Teaching load — sections per trimester</p>
          <div class="heat">
            <div class="heat__corner"></div>
            {TERMS.map((t) => <div class="heat__colh">{t}</div>)}
            {yearsArr.map((y) => (
              <>
                <div class="heat__rowh">{y}</div>
                {TERMS.map((t) => {
                  const c = grid[`${y}|${t}`];
                  const sec = c?.sections ?? 0;
                  const a = sec ? 0.12 + 0.78 * (sec / maxCellSec) : 0;
                  return (
                    <div
                      class:list={["heat__cell", { "is-empty": !sec }]}
                      style={sec ? `background:color-mix(in srgb, var(--accent) ${Math.round(a * 100)}%, var(--bg-elev-2))` : ""}
                      data-label={sec ? `${t} ${y} · ${sec} section${sec !== 1 ? "s" : ""} · ${c!.students} students` : `${t} ${y} · none`}
                    >{sec || ""}</div>
                  );
                })}
              </>
            ))}
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ── Course-by-course ─────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap wrap--narrow">
      <Reveal><p class="eyebrow">Courses</p></Reveal>
      <Reveal delay={50}><h2 class="sec-h2">{courses.length} unique courses</h2></Reveal>

      <div class="courses">
        {courses.map((c, i) => (
          <Reveal delay={Math.min(i * 40, 280)}>
            <details class="course" open={i === 0}>
              <summary class="course__sum">
                <span class="course__head">
                  <span class="course__code">{c.code}</span>
                  <span class="course__name">{c.name}</span>
                  {c.coListed.length > 0 && (
                    <span class="course__co">
                      cross-listed: {c.coListed.map((x, j) => (
                        <>{j > 0 ? ", " : ""}{x.code}{x.since ? ` (since ${x.since})` : ""}</>
                      ))}
                    </span>
                  )}
                </span>
                <span class="course__meta">
                  <span class="course__stat"><strong>{c.students.toLocaleString()}</strong> students</span>
                  <span class="course__stat course__stat--dim">{c.sections} {c.sections === 1 ? "section" : "sections"} · {c.nTrim} {c.nTrim === 1 ? "trimester" : "trimesters"}</span>
                  <svg class="course__chev" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <div class="course__body">
                <table class="trim-table">
                  <thead>
                    <tr><th>Trimester</th><th>Sections</th><th>Students</th><th>Room(s)</th></tr>
                  </thead>
                  <tbody>
                    {c.trimesters.map((t) => (
                      <tr>
                        <td class="tt-term">{t.term} {t.year}</td>
                        <td class="tt-num">{t.sections}</td>
                        <td class="tt-num tt-stu">{t.students}</td>
                        <td class="tt-rooms">{[...t.rooms].join(", ") || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </Reveal>
        ))}
      </div>

      <Reveal>
        <p class="foot-note">
          Compiled from Google Classroom ({teaching.snapshot}). Enrolment is the number of
          students in each section; a student taking two of these courses is counted in each.
          Grades are not included.
        </p>
      </Reveal>
    </div>
  </section>

  <style>
    .wrap--narrow { max-width: 940px; }
    .sec-h2 { font-size: clamp(1.5rem, 3.2vw, 2.1rem); letter-spacing: -0.015em; margin: 0.3rem 0 0; color: var(--ink); }

    /* Stats */
    .t-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.9rem; margin-top: 1.8rem; }
    .t-stat { background: var(--bg-elev-2); border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem 1rem; display: flex; flex-direction: column; gap: 0.3rem; }
    .t-stat__n { font-size: clamp(1.5rem, 3.5vw, 2.2rem); font-weight: 700; letter-spacing: -0.02em; color: var(--accent); line-height: 1; font-variant-numeric: tabular-nums; }
    .t-stat__l { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--ink-faint); }
    @media (max-width: 760px) { .t-stats { grid-template-columns: repeat(2, 1fr); } }
    [data-theme="light"] .t-stat { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 6px 16px rgba(12,18,34,.04); }

    /* Chart cards — two columns: left stacks two charts, right is the heatmap */
    .charts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; align-items: start; margin-top: 1.3rem; }
    .charts-left { display: flex; flex-direction: column; gap: 1.3rem; min-width: 0; }
    @media (max-width: 820px) { .charts { grid-template-columns: 1fr; } }
    .chart-card { background: var(--bg-elev-2); border: 1px solid var(--line); border-radius: 16px; padding: 1.4rem 1.4rem 1.2rem; }
    [data-theme="light"] .chart-card { box-shadow: 0 1px 3px rgba(12,18,34,.05), 0 6px 16px rgba(12,18,34,.04); }
    .chart-h { margin: 0 0 1.3rem; }

    /* Bars (students per year) */
    .bars { display: flex; align-items: flex-end; gap: 6px; height: 220px; }
    .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%; justify-content: flex-end; min-width: 0; }
    .bar { width: 100%; max-width: 46px; background: var(--accent); border-radius: 5px 5px 0 0; position: relative; opacity: 0.88; transition: opacity 0.15s; min-height: 2px; }
    .bar:hover { opacity: 1; }
    .bar-v { position: absolute; top: -1.2rem; left: 0; right: 0; text-align: center; font-size: 0.7rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
    .bar-x { font-size: 0.72rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }

    /* Heatmap (term × year) */
    .heat { display: grid; grid-template-columns: 2.6rem repeat(3, 1fr); gap: 5px; max-width: 560px; }
    .heat__corner { }
    .heat__colh, .heat__rowh { font-size: 0.7rem; color: var(--ink-faint); font-weight: 600; display: flex; align-items: center; }
    .heat__colh { justify-content: center; text-transform: uppercase; letter-spacing: 0.06em; }
    .heat__rowh { justify-content: flex-end; padding-right: 0.3rem; font-variant-numeric: tabular-nums; }
    .heat__cell {
      aspect-ratio: 16 / 9; min-height: 30px; border-radius: 7px; border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.82rem; font-weight: 700; color: var(--accent-ink, #1a1206);
      position: relative; cursor: default; font-variant-numeric: tabular-nums;
    }
    .heat__cell.is-empty { background: var(--bg-elev); color: transparent; border-style: dashed; opacity: 0.5; }
    [data-theme="light"] .heat__cell:not(.is-empty) { color: #fff; }

    /* Horizontal bars (courses by enrolment) */
    .hbars { display: flex; flex-direction: column; gap: 0.5rem; }
    .hbar { display: grid; grid-template-columns: 5.5rem 1fr 3rem; align-items: center; gap: 0.7rem; }
    .hbar__lbl { font-size: 0.82rem; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hbar__track { height: 12px; background: var(--bg-elev); border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
    .hbar__fill { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
    .hbar__n { font-size: 0.8rem; color: var(--ink-soft); text-align: right; font-variant-numeric: tabular-nums; }

    /* Hover tooltip (bars + heatmap cells) */
    .bar[data-label]:hover::after, .heat__cell[data-label]:hover::after {
      content: attr(data-label); position: absolute; left: 50%; bottom: 100%;
      transform: translateX(-50%); margin-bottom: 8px; padding: 0.35em 0.6em;
      background: var(--ink); color: var(--bg); font-size: 0.72rem; font-weight: 600;
      white-space: nowrap; border-radius: 6px; pointer-events: none; z-index: 10;
    }

    /* Course accordion */
    .courses { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.6rem; }
    .course { background: var(--bg-elev); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; transition: border-color 0.2s; }
    .course[open], .course:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
    [data-theme="light"] .course { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 4px 12px rgba(12,18,34,.04); }
    .course__sum { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.2rem; cursor: pointer; list-style: none; }
    .course__sum::-webkit-details-marker { display: none; }
    .course__sum:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .course__head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; min-width: 0; }
    .course__code { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); border-radius: 6px; padding: 0.2em 0.5em; white-space: nowrap; }
    .course__name { color: var(--ink); font-weight: 600; font-size: 1.02rem; }
    .course__co { font-size: 0.72rem; color: var(--ink-faint); border: 1px solid var(--line); border-radius: 999px; padding: 0.1em 0.6em; }
    .course__meta { display: inline-flex; align-items: center; gap: 0.9rem; flex-shrink: 0; }
    .course__stat { font-size: 0.82rem; color: var(--ink-soft); white-space: nowrap; }
    .course__stat strong { color: var(--ink); }
    .course__stat--dim { color: var(--ink-faint); font-size: 0.78rem; }
    @media (max-width: 620px) { .course__stat--dim { display: none; } }
    .course__chev { color: var(--ink-faint); transition: transform 0.2s ease; flex-shrink: 0; }
    .course[open] .course__chev { transform: rotate(90deg); color: var(--accent); }

    .course__body { padding: 0 0.6rem 0.8rem; border-top: 1px solid var(--line); }
    .trim-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .trim-table th { text-align: left; padding: 0.6rem 0.7rem; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); font-weight: 600; white-space: nowrap; }
    .trim-table td { padding: 0.5rem 0.7rem; border-top: 1px solid var(--line); color: var(--ink-soft); vertical-align: top; }
    .tt-term { color: var(--ink); font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .tt-num { text-align: right; width: 1%; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .tt-stu { color: var(--accent); font-weight: 600; }
    .tt-rooms { color: var(--ink-faint); font-size: 0.82rem; }

    .foot-note { margin-top: 1.6rem; font-size: 0.82rem; color: var(--ink-faint); line-height: 1.6; max-width: 70ch; }

    @media (prefers-reduced-motion: reduce) { .course__chev, .bar { transition: none; } }
  </style>
</BaseLayout>
