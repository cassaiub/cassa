---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import PersonCard from "../../components/PersonCard.astro";
import { withBase } from "../../data/site-nav.ts";

/* ── Content ──────────────────────────────────────────────────────────── */
const lastName = (n: string) => n.trim().split(/\s+/).at(-1) ?? n;
const ras = (
  await getCollection("people", ({ data }) =>
    data.tier === "Research Assistant" && data.status === "published"
  )
).sort((a, b) => lastName(a.data.name).localeCompare(lastName(b.data.name)));

/* ── Subpage nav ──────────────────────────────────────────────────────── */
const CURRENT_HREF = "/people/student-ras";
const subNav = [
  { href: "/people/directors",       label: "Directors" },
  { href: "/people/core-associate",  label: "Core & Associate" },
  { href: "/people/grad-affiliates", label: "Graduate & Affiliates" },
  { href: "/people/staff",           label: "Staff" },
  { href: "/people/student-ras",     label: "Research Assistants" },
  { href: "/people/interns",         label: "Interns & Undergraduates" },
];
---

<BaseLayout
  title="Student Research Assistants — CASSA People"
  description="Graduate and postbac researchers embedded in active CASSA projects — building the next generation of Bangladeshi astrophysicists."
  current="/people"
>
  <!-- ── Fullscreen hero ──────────────────────────────────────────────── -->
  <AnimatedHero
    theme="lensing"
    eyebrow="People · Research Assistants"
    title="Student Research Assistants"
    lede="Graduate and postbac researchers embedded in active CASSA projects — building the next generation of Bangladeshi astrophysicists."
  />

  <!-- ── Subpage navigation pill-strip ────────────────────────────────── -->
  <nav style="border-bottom:1px solid var(--line);background:var(--bg-elev)">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:.5rem;padding-block:.85rem">
      <a href={withBase('/people')} style="color:var(--ink-faint);font-size:.85rem;padding:.3rem .7rem;border-radius:999px">← All People</a>
      {subNav.map(s => (
        <a
          href={withBase(s.href)}
          style={`font-size:.85rem;padding:.3rem .75rem;border-radius:999px;${
            s.href === CURRENT_HREF
              ? 'background:var(--accent);color:#1a1206;font-weight:600'
              : 'color:var(--ink-soft);border:1px solid var(--line)'
          }`}
        >{s.label}</a>
      ))}
    </div>
  </nav>

  <!-- ── Research Assistants section ──────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Active RAs</p></Reveal>
      <Reveal delay={60}>
        <h2 style="font-size:clamp(1.6rem,3.4vw,2.3rem);letter-spacing:-.015em;margin:.3rem 0 0;color:var(--ink)">
          Research Assistants
        </h2>
      </Reveal>

      <div class="pg">
        {ras.map((p, i) => (
          <Reveal delay={(i % 4) * 80}>
            <PersonCard
              name={p.data.name}
              title={p.data.title}
              tier={p.data.tier}
              interests={p.data.interests}
              institution={p.data.institution}
              email={p.data.email}
              photo={p.data.photo}
              links={p.data.links}
            />
          </Reveal>
        ))}
      </div>

      <Reveal delay={160}>
        <div style="margin-top:3rem">
          <p class="eyebrow" style="font-size:.7rem;margin-bottom:1rem">Active projects</p>
          <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;font-size:.9rem;max-width:800px">
              <thead>
                <tr style="border-bottom:2px solid var(--line-strong)">
                  <th style="text-align:left;padding:.6rem 1rem .6rem 0;color:var(--ink);font-weight:700">RA</th>
                  <th style="text-align:left;padding:.6rem 1rem;color:var(--ink);font-weight:700">Project</th>
                  <th style="text-align:left;padding:.6rem 0 .6rem 1rem;color:var(--ink);font-weight:700">Supervisor</th>
                </tr>
              </thead>
              <tbody style="color:var(--ink-soft)">
                <tr style="border-bottom:1px solid var(--line)">
                  <td style="padding:.65rem 1rem .65rem 0">Ahmad Al-Imtiaz</td>
                  <td style="padding:.65rem 1rem"><span class="pill" style="font-size:.75rem">Sparkler</span></td>
                  <td style="padding:.65rem 0 .65rem 1rem">Dr. Lamiya Mowla</td>
                </tr>
                <tr style="border-bottom:1px solid var(--line)">
                  <td style="padding:.65rem 1rem .65rem 0">Nafis Sadik Nihal</td>
                  <td style="padding:.65rem 1rem"><span class="pill" style="font-size:.75rem">Dolphin</span></td>
                  <td style="padding:.65rem 0 .65rem 1rem">Dr. Anowar Shajib</td>
                </tr>
                <tr style="border-bottom:1px solid var(--line)">
                  <td style="padding:.65rem 1rem .65rem 0">Md Shahadat Hossain Shahal</td>
                  <td style="padding:.65rem 1rem"><span class="pill" style="font-size:.75rem">RGC</span></td>
                  <td style="padding:.65rem 0 .65rem 1rem">Dr. Khan Muhammad Bin Asad</td>
                </tr>
                <tr>
                  <td style="padding:.65rem 1rem .65rem 0">Deba Priyo Guha</td>
                  <td style="padding:.65rem 1rem"><span class="pill" style="font-size:.75rem">Supernova Cosmology</span></td>
                  <td style="padding:.65rem 0 .65rem 1rem">Dr. Syed Ashraf Uddin</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
.pg {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 2.2rem;
}
@media (max-width: 860px) { .pg { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .pg { grid-template-columns: 1fr; } }
</style>
