---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import AnimatedBand from "../../components/immersive/AnimatedBand.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import PersonCard from "../../components/PersonCard.astro";
import { personalSite } from "../../data/people/personal-site.ts";
import { withBase } from "../../data/site-nav.ts";

/* ── Content ──────────────────────────────────────────────────────────── */
const lastName = (n: string) => n.trim().split(/\s+/).at(-1) ?? n;
const TIER_ORDER = ["Core Member", "Associate Member"];

const members = (
  await getCollection("people", ({ data }) =>
    (data.tier === "Core Member" || data.tier === "Associate Member") &&
    data.status === "published"
  )
).sort((a, b) => {
  const td = TIER_ORDER.indexOf(a.data.tier) - TIER_ORDER.indexOf(b.data.tier);
  return td !== 0 ? td : lastName(a.data.name).localeCompare(lastName(b.data.name));
});

const coreMembers = members.filter((p) => p.data.tier === "Core Member");
const associateMembers = members.filter((p) => p.data.tier === "Associate Member");

/* ── Subpage nav ──────────────────────────────────────────────────────── */
const CURRENT_HREF = "/people/core-associate";
const subNav = [
  { href: "/people/directors",       label: "Directors" },
  { href: "/people/core-associate",  label: "Core & Associate" },
  { href: "/people/grad-affiliates", label: "Graduate & Affiliates" },
  { href: "/people/staff",           label: "Staff" },
  { href: "/people/student-ras",     label: "Research Assistants" },
  { href: "/people/interns",         label: "Interns & Undergraduates" },
];
---

<BaseLayout
  title="Core & Associate Members — CASSA People"
  description="Founding and active research members driving CASSA's research."
  current="/people"
>
  <!-- ── Fullscreen hero ──────────────────────────────────────────────── -->
  <AnimatedHero
    theme="lensing"
    eyebrow="People · Members"
    title="Core & Associate Members"
    lede="Founding and active research members driving CASSA's research."
  />

  <!-- ── Subpage navigation pill-strip ────────────────────────────────── -->
  <nav style="border-bottom:1px solid var(--line);background:var(--bg-elev)">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:.5rem;padding-block:.85rem">
      <a href={withBase('/people')} style="color:var(--ink-faint);font-size:.85rem;padding:.3rem .7rem;border-radius:999px">← All People</a>
      {subNav.map(s => (
        <a
          href={withBase(s.href)}
          style={`font-size:.85rem;padding:.3rem .75rem;border-radius:999px;${
            s.href === CURRENT_HREF
              ? 'background:var(--accent);color:var(--accent-ink,#1a1206);font-weight:600'
              : 'color:var(--ink-soft);border:1px solid var(--line)'
          }`}
        >{s.label}</a>
      ))}
    </div>
  </nav>

  <!-- ── Section A: Core Members ──────────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Core Members</p></Reveal>
      <Reveal delay={60}>
        <h2 style="font-size:clamp(1.6rem,3.4vw,2.3rem);letter-spacing:-.015em;margin:.3rem 0 0;color:var(--ink)">
          Core Members
        </h2>
      </Reveal>

      {coreMembers.length > 0 ? (
        <div class="pg">
          {coreMembers.map((p, i) => (
            <Reveal delay={i * 80}>
              <PersonCard
                name={p.data.name}
                title={p.data.title}
                tier={p.data.tier}
                interests={p.data.interests}
                institution={p.data.institution}
                education={p.data.education}
                research={p.data.research}
                email={p.data.email}
                photo={p.data.photo}
                links={p.data.links}
                website={personalSite(p.id, p.data)}
              />
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal delay={80}>
          <p style="color:var(--ink-faint);font-size:.95rem;margin-top:2rem;max-width:60ch">
            Core member profiles will appear here once they are published.
          </p>
        </Reveal>
      )}
    </div>
  </section>

  <!-- ── Interstitial animated band ───────────────────────────────────── -->
  <AnimatedBand theme="galaxy">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Members</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:24ch">Eight Associate Members driving CASSA's research</h2>
    </Reveal>
  </AnimatedBand>

  <!-- ── Section B: Associate Members ────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <Reveal><p class="eyebrow">Associate Members</p></Reveal>
      <Reveal delay={60}>
        <h2 style="font-size:clamp(1.6rem,3.4vw,2.3rem);letter-spacing:-.015em;margin:.3rem 0 0;color:var(--ink)">
          Associate Members
        </h2>
      </Reveal>

      {associateMembers.length > 0 ? (
        <div class="pg">
          {associateMembers.map((p, i) => (
            <Reveal delay={(i % 3) * 80}>
              <PersonCard
                name={p.data.name}
                title={p.data.title}
                tier={p.data.tier}
                interests={p.data.interests}
                institution={p.data.institution}
                education={p.data.education}
                research={p.data.research}
                email={p.data.email}
                photo={p.data.photo}
                links={p.data.links}
                website={personalSite(p.id, p.data)}
              />
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal delay={80}>
          <p style="color:var(--ink-faint);font-size:.95rem;margin-top:2rem;max-width:60ch">
            Associate member profiles will appear here once they are published.
          </p>
        </Reveal>
      )}

      <Reveal>
        <p style="color:var(--ink-faint);font-size:.85rem;margin-top:1.8rem">
          Six of the eight Associate Members hold "Founding" status per the CASSA Constitution v2.0 Appendix A. Tonima Tasnim Ananna and Tabassum Shahriar Tanvir are Associate Members without Founding designation.
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
.pg {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 2rem;
}
@media (max-width: 860px) { .pg { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .pg { grid-template-columns: 1fr; } }
</style>
