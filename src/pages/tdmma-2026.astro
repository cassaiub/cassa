        ].map(([k, v], i) => (
          <Reveal delay={100 + i * 60}>
            <div class="fact"><span class="fact__k">{k}</span><span class="fact__v">{v}</span></div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The five days ────────────────────────────────────────────────── -->
  <!-- ── Programme calendar ───────────────────────────────────────────── -->
  <section class="section section--elev" id="programme">
    <div class="wrap">
      <Reveal><p class="eyebrow">Programme</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>The week, hour by hour</h2></Reveal>
      <Reveal delay={100}>
        <div class="legend" aria-hidden="true">
          {(["lec", "tut", "disc", "cer"] as const)
            .filter((k) => all.some((x) => x.k === k))
            .map((k) => <span class={`lg s--${k}`}>{typeLabel[k]}</span>)}
          <span class="lg s--brk">Break</span>
        </div>
      </Reveal>
    </div>

    <Reveal delay={140}>
      <div class="cal-scroll wrap" role="region" aria-label="Workshop programme calendar" tabindex="0">
        <div class="cal" style={`grid-template-rows:auto ${rowsTemplate}`}>
          {/* Day headers — each column is titled by its day's theme, so the
              calendar alone carries the arc of the week. */}
          <div class="cal__corner"><span>Time</span></div>
          {DAYS.map((d, i) => (
            <div class="cal__day">
              <span class="cal__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="cal__wd">{d.wd} · {d.date}</span>
              <span class="cal__short">{d.short}</span>
              <span class="cal__theme">{d.theme}</span>
            </div>
          ))}

          {/* slot rules + per-slot time labels on the rail */}
          {BOUNDS.map((b, i) => (
            <Fragment>
              <div class="cal__rule" style={`grid-row:${row(b)}`} aria-hidden="true"></div>
              <div class="cal__time" style={`grid-row:${row(b)} / span ${boundSpan(i)}`}>{b}</div>
            </Fragment>
          ))}

          {/* week-wide breaks (identical across all five days) */}
          {commonBreaks.map((b) => (
            <div class="s s--brk s--span" style={`grid-row:${row(b.s)} / ${row(b.e)}`}>
              <span class="s__title">{b.t}</span>
            </div>
          ))}

          {/* sessions, one column per day — click opens the detail drawer */}
          {DAYS.map((d, di) =>
            d.sessions.filter((x) => !isCommonBreak(x)).map((x, si) => (
              <button
                type="button"
                class:list={["s", `s--${x.k}`, x.k !== "brk" && { "s--sm": mins(x.e) - mins(x.s) <= 30, "s--xs": mins(x.e) - mins(x.s) <= 15 }]}
                style={`grid-column:${di + 2};grid-row:${row(x.s)} / ${row(x.e)};--d:${di * 70 + si * 45}ms`}
                data-session
                data-title={x.t}
                data-day={`${d.wd} · ${d.date} — ${d.theme}`}
                data-time={`${x.s}–${x.e}`}
                data-type={typeLabel[x.k]}
                data-role={tbdRole[x.k] ?? ""}
                data-who={x.who ?? ""}
                data-topics={(x.d ?? []).join("¦")}
                data-link={x.link ? withBase(x.link.href) : ""}
                data-link-label={x.link?.label ?? ""}
                aria-haspopup="dialog"
              >
                <span class="s__title">{x.t}</span>
              </button>
            ))
          )}
        </div>
      </div>
    </Reveal>

    <div class="wrap">
      <div class="stats">
        {[
          ["5", "days"],
          [String(nSes), "sessions"],
          [String(nLec), "lectures"],
          [String(nTut), "hands-on tutorials"],
        ].map(([n, l], i) => (
          <Reveal delay={150 + i * 60}>
            <div class="stat"><span class="stat__n">{n}</span><span class="stat__l">{l}</span></div>
          </Reveal>
        ))}
      </div>
      <Reveal delay={160}>
        <p class="cal-note">
          Click a session for details; on phones, swipe the calendar sideways.
          Session speakers will be announced before the workshop.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- Session-detail drawer (opened by any [data-session] cell) -->
  <div id="session-drawer" class="sdrawer" hidden>
    <div class="sdrawer__scrim" data-sdrawer-close></div>
    <aside class="sdrawer__panel" role="dialog" aria-modal="true" aria-label="Session details" tabindex="-1">
      <button type="button" class="sdrawer__close" data-sdrawer-close aria-label="Close session details">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <p class="sdrawer__type" data-sd="type"></p>
      <h3 class="sdrawer__title" data-sd="title"></h3>
      <dl class="sdrawer__meta">
        <div><dt>Day</dt><dd data-sd="day"></dd></div>
        <div><dt>Time</dt><dd data-sd="time"></dd></div>
        <div data-sd-role-row><dt data-sd="role">Speaker</dt><dd data-sd="who">To be announced</dd></div>
      </dl>
      <div class="sdrawer__topics">
        <p class="sdrawer__topics-h">In this session</p>
        <ul data-sd-topics></ul>
      </div>
      <a class="sdrawer__link" data-sd-link hidden>→ <span data-sd="linkLabel"></span></a>
      <button type="button" class="sdrawer__pdf" disabled>
        Session materials (PDF) — available after the workshop
      </button>
    </aside>
  </div>

  <!-- ── Venue ────────────────────────────────────────────────────────── -->
  <section class="section" id="venue">
    <div class="wrap">
      <Reveal><p class="eyebrow">Venue & logistics</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>Where the week happens</h2>
          <p>
            The workshop runs at <strong>Independent University, Bangladesh</strong>
            — Plot 16, Block B, Aftabuddin Ahmed Road, Bashundhara Residential
            Area, Dhaka 1245 — home of CASSA. Sessions run 10:00 AM to 6:00 PM
            with a 90-minute lunch break; the exact room will be announced to
            registered participants. The week falls in the semester break, and
            participants completing the workshop receive certificates at the
            closing ceremony.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- ── Speakers ─────────────────────────────────────────────────────── -->
  <section class="section section--elev" id="speakers">
    <div class="wrap">
      <Reveal><p class="eyebrow">Resource people</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Invited speakers</h2></Reveal>
      <div class="spk">
        {SPEAKERS.map((p, i) => (
          <Reveal delay={100 + i * 50}>
            <article class="spk__card">
              <img class="spk__photo" src={withBase(p.photo)} alt={p.name} width="480" height="480" loading="lazy" />
              <div class="spk__body">
                <h3 class="spk__name">
                  <a
                    href={p.web}
                    target={p.ext ? "_blank" : undefined}
                    rel={p.ext ? "noopener" : undefined}
                  >{p.name}{p.ext && <span class="spk__ext" aria-hidden="true"> ↗</span>}</a>
                </h3>
                <p class="spk__aff">{p.aff}</p>
                {p.email && <a class="spk__mail" href={`mailto:${p.email}`}>{p.email}</a>}
              </div>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Organisers ───────────────────────────────────────────────────── -->
  <section class="section" id="organisers">
    <div class="wrap">
      <Reveal><p class="eyebrow">Organisation</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Organisers</h2></Reveal>
      <div class="orgs">
        {COMMITTEES.map((g, gi) => (
          <Reveal delay={100 + gi * 60}>
            <div class="org">
              <h3 class="org__title">{g.title}</h3>
              <ul class="org__list">
                {g.people.map((p) => (
                  <li>
                    <span class="org__name">{p.name}</span>
                    <span class="org__aff">{p.aff}</span>
                    {p.email && <a class="org__mail" href={`mailto:${p.email}`}>{p.email}</a>}
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Registration ─────────────────────────────────────────────────── -->
  <section class="section section--elev" id="apply">
    <div class="wrap cta">
      <Reveal><p class="eyebrow">Take part</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Applications & registration</h2></Reveal>
      <Reveal delay={100}>
        <p class="cta__p">
          Applications are open until <strong>18 August 2026</strong> — the workshop
          is designed for
          <strong> university students from Bangladesh and beyond</strong>, and a
          few seats may go to exceptional high-school applicants, subject to
          availability. Selected participants confirm their seat by paying a
          registration fee of <strong>BDT&nbsp;5,000 online</strong>; waivers of
          <strong>20% or 50%</strong> are available on the basis of merit and need.
        </p>
      </Reveal>
      <Reveal delay={115}>
        <div class="cta__count">
          <Countdown client:idle closesAt={APPLY_CLOSES} />
        </div>
      </Reveal>
      <Reveal delay={130}>
        <div class="dl">
          {DEADLINES.map(([k, v]) => (
            <div class="dl__item">
              <span class="dl__k">{k}</span>
              <span class="dl__v">{v}</span>
            </div>
          ))}
        </div>
      </Reveal>
      <Reveal delay={160}>
        <p class="cta__p cta__p--note">
          A second sponsor and host of the event will be announced soon.
        </p>
      </Reveal>
      <Reveal delay={190}>
        <p class="cta__row">
          <a class="btn" href="https://inside.cassa.bd/forms/event/2026-07-12-b">Apply now</a>
          <a class="cta__mail" href="mailto:cassa@iub.edu.bd?subject=TDMMA%20Workshop%202026">Questions? cassa@iub.edu.bd</a>
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  /* Page submenu — highlights the section currently in view and, on narrow
     screens where the bar scrolls sideways, keeps that link visible. */
  (function () {
    var bar = document.querySelector(".subnav");
    if (!bar) return;
    var rail = bar.querySelector(".subnav__links");
    var links = Array.prototype.slice.call(bar.querySelectorAll("[data-sec]"));
    if (!links.length) return;
    var sections = links
      .map(function (a) { return document.getElementById(a.getAttribute("data-sec")); })
      .filter(Boolean);
    var current = null;
    function update() {
      var mark = window.innerHeight * 0.4;
      var active = null;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= mark) active = sections[i].id;
      }
      links.forEach(function (a) {
        a.classList.toggle("is-active", a.getAttribute("data-sec") === active);
      });
      if (active === current) return;
      current = active;
      /* Only the overflowing link rail scrolls; the Apply pill sits outside it. */
      if (!rail || rail.scrollWidth <= rail.clientWidth + 1) return;
      var link = links.filter(function (a) { return a.getAttribute("data-sec") === active; })[0];
      if (link && rail.contains(link)) {
        rail.scrollTo({
          left: link.offsetLeft - (rail.clientWidth - link.offsetWidth) / 2,
          behavior: "smooth",
        });
      }
    }
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();

  /* Session drawer — mirrors the PersonDrawer interaction contract:
     click-to-open, scrim/×/Esc to close, focus restored to the trigger,
     reduced-motion skips the slide transition. */
  (function () {
    var drawer = document.getElementById("session-drawer");
    if (!drawer) return;
    var panel = drawer.querySelector(".sdrawer__panel");
    var closeBtn = drawer.querySelector(".sdrawer__close");
    var roleRow = drawer.querySelector("[data-sd-role-row]");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    var lastFocus = null;
    function fill(name, value) {
      var el = drawer.querySelector('[data-sd="' + name + '"]');
      if (el) el.textContent = value;
    }
    function open(btn) {
      fill("type", btn.getAttribute("data-type") || "");
      fill("title", btn.getAttribute("data-title") || "");
      fill("day", btn.getAttribute("data-day") || "");
      fill("time", btn.getAttribute("data-time") || "");
      var role = btn.getAttribute("data-role") || "";
      if (roleRow) roleRow.hidden = !role;
      if (role) fill("role", role);
      fill("who", btn.getAttribute("data-who") || "To be announced");
      var list = drawer.querySelector("[data-sd-topics]");
      if (list) {
        list.textContent = "";
        (btn.getAttribute("data-topics") || "")
          .split("¦")
          .filter(Boolean)
          .forEach(function (topic) {
            var li = document.createElement("li");
            li.textContent = topic;
            list.appendChild(li);
          });
      }
      var linkEl = drawer.querySelector("[data-sd-link]");
      if (linkEl) {
        var href = btn.getAttribute("data-link") || "";
        linkEl.hidden = !href;
        if (href) {
          linkEl.setAttribute("href", href);
          fill("linkLabel", btn.getAttribute("data-link-label") || "Learn more");
        }
      }
      lastFocus = btn;
      drawer.hidden = false;
      requestAnimationFrame(function () { drawer.classList.add("is-open"); });
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }
    function close() {
      if (drawer.hidden) return;
      drawer.classList.remove("is-open");
      document.body.style.overflow = "";
      var done = false;
      var finish = function () { if (done) return; done = true; drawer.hidden = true; };
      if (reduce.matches) finish();
      else { if (panel) panel.addEventListener("transitionend", finish, { once: true }); setTimeout(finish, 420); }
      if (lastFocus && lastFocus.focus) lastFocus.focus();
      lastFocus = null;
    }
    document.addEventListener("click", function (e) {
      var opener = e.target.closest && e.target.closest("[data-session]");
      if (opener) { e.preventDefault(); open(opener); return; }
      if (e.target.closest && e.target.closest("[data-sdrawer-close]")) { e.preventDefault(); close(); }
    });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
  })();
</script>

<style is:global>
  /* This page only: the site nav scrolls away with the hero — the page submenu
     below is the one sticky bar. (Global default is position: fixed.) */
  #site-nav { position: absolute; }
</style>

<style>
  /* ── Page submenu ──
     Rides directly under the hero, then pins to the viewport top — the site
     nav scrolls away on this page (see the is:global block above). */
  .subnav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .subnav__row { display: flex; align-items: center; gap: 1rem; height: 54px; }
  /* Wordmark — the page's own identity on the pinned bar */
  .subnav__brand {
    flex-shrink: 0;
    display: inline-flex; align-items: baseline; gap: 0.28rem;
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    letter-spacing: -0.015em; color: var(--ink); line-height: 1;
    padding-right: clamp(0.7rem, 2vw, 1.3rem);
    border-right: 1px solid var(--line);
  }
  .subnav__brand span { color: var(--accent); }
  .subnav__links {
    display: flex; align-items: center; gap: clamp(0.9rem, 2.4vw, 2rem);
    min-width: 0; flex: 1 1 auto;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .subnav__links::-webkit-scrollbar { display: none; }
  .subnav__link {
    position: relative; flex-shrink: 0;
    display: inline-flex; align-items: center; height: 54px;
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;
    color: var(--ink-faint); white-space: nowrap;
    transition: color 0.2s ease;
  }
  /* Accent rule that rides the bar's bottom border on the active section */
  .subnav__link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
    background: var(--accent); border-radius: 2px;
    transform: scaleX(0); transform-origin: center;
    transition: transform 0.25s ease;
  }
  .subnav__link:hover { color: var(--ink); }
  .subnav__link.is-active { color: var(--accent); }
  .subnav__link.is-active::after { transform: scaleX(1); }

  /* Apply stays a pill, outside the scrolling rail — always reachable */
  .subnav__cta {
    flex-shrink: 0;
    font-size: 0.8rem; font-weight: 600; white-space: nowrap;
    color: var(--accent-ink); background: var(--accent);
    padding: 0.42rem 1rem; border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .subnav__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  /* Sections stop under the pinned submenu when jumped to */
  #about, #programme, #venue, #speakers, #organisers, #apply { scroll-margin-top: 70px; }

  @media (max-width: 640px) {
    .subnav__row { gap: 0.7rem; }
    .subnav__links { gap: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .subnav__link, .subnav__link::after, .subnav__cta { transition: none; }
    .subnav__cta:hover { transform: none; }
  }

  /* ── About: lede beside the four-sciences rail ── */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    gap: clamp(2.2rem, 5vw, 4.8rem);
    align-items: start;
    margin-top: 0.4rem;
  }
  /* The prose fills its column instead of self-centering at 68ch */
  .about__lede :global(.prose-cassa) { max-width: none; margin-inline: 0; }
  .about__sci {
    border-left: 1px solid var(--line);
    padding-left: clamp(1.4rem, 2.6vw, 2.2rem);
  }
  .about__sci-h {
    margin: 0.6rem 0 0;
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.18em;
    font-weight: 700; color: var(--ink-faint);
  }
  .sci { list-style: none; counter-reset: sci; margin: 0.4rem 0 0; padding: 0; }
  .sci > li {
    counter-increment: sci;
    position: relative;
    padding: 1.05rem 0 1.1rem 3.1rem;
    border-top: 1px solid var(--line);
  }
  .sci > li:first-child { border-top: 0; }
  .sci > li::before {
    content: counter(sci, decimal-leading-zero);
    position: absolute; left: 0; top: 1.05rem;
    font-family: var(--font-display); font-weight: 800; font-size: 1.75rem; line-height: 1;
    letter-spacing: -0.03em; color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .sci__day {
    display: block;
    font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 700; color: var(--accent);
  }
  .sci__t {
    display: block; margin-top: 0.25rem;
    font-weight: 700; font-size: 0.98rem; line-height: 1.35;
    letter-spacing: -0.01em; color: var(--ink);
  }
  .sci__d { margin: 0.4rem 0 0; font-size: 0.85rem; line-height: 1.62; color: var(--ink-soft); }
  .sci__coda {
    margin: 0; padding-top: 1.05rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem; line-height: 1.62; color: var(--ink-faint);
  }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .about__sci { border-left: 0; padding-left: 0; }
  }

  /* ── Fact cards ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0.9rem;
    margin-top: 2.8rem;
  }
  .fact {
    height: 100%;
    display: flex; flex-direction: column; gap: 0.35rem;
    background: var(--bg-elev-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.95rem 1.05rem;
  }
  .fact__k {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 600; color: var(--accent);
  }
  .fact__v { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; }

  /* ── Stat tiles (under the calendar) ── */
  .stats { display: flex; flex-wrap: wrap; gap: 2.2rem 3.4rem; margin-top: 2.6rem; }
  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat__n {
    font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em;
    font-size: clamp(2.1rem, 4.5vw, 3rem); line-height: 1; color: var(--accent);
  }
  .stat__l { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint); }

  /* ── Session-type palette (dark defaults; ink-dark equivalents for day) ── */
  .s--lec  { --sc: #7fb2ff; }
  .s--tut  { --sc: #7fd8a6; }
  .s--disc { --sc: #c39bf0; }
  .s--cer  { --sc: var(--accent); }
  .s--brk  { --sc: color-mix(in srgb, var(--ink) 42%, transparent); }
  :global([data-theme="light"]) .s--lec  { --sc: #2f6bd8; }
  :global([data-theme="light"]) .s--tut  { --sc: #1d7f4e; }
  :global([data-theme="light"]) .s--disc { --sc: #7444b8; }

  /* Tentative-programme notice — deliberately prominent, above the legend */
  .cal-tentative {
    margin: 1.5rem 0 0; max-width: 64ch;
    padding: 0.8rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border-radius: 0 12px 12px 0;
    font-size: 0.94rem; line-height: 1.65; color: var(--ink-soft);
  }
  .cal-tentative strong { color: var(--ink); }

  /* ── Legend ── */
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.6rem; }
  .lg {
    font-size: 0.74rem; color: var(--ink-soft);
    padding: 0.32rem 0.75rem 0.32rem 0.6rem;
    border: 1px solid var(--line); border-radius: 999px;
    display: inline-flex; align-items: center; gap: 0.45rem;
  }
  .lg::before {
    content: ""; width: 0.62rem; height: 0.62rem; border-radius: 3px;
    background: var(--sc); flex-shrink: 0;
