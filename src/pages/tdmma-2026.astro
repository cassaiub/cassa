<script is:inline>
  /* Right-rail TOC — highlights the section currently in view. */
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll(".toc a[data-toc]"));
    if (!links.length) return;
    var sections = links
      .map(function (a) { return document.getElementById(a.getAttribute("data-toc")); })
      .filter(Boolean);
    function update() {
      var mark = window.innerHeight * 0.4;
      var active = null;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= mark) active = sections[i].id;
      }
      links.forEach(function (a) {
        a.classList.toggle("is-active", a.getAttribute("data-toc") === active);
      });
    }
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();

  /* Session drawer — mirrors the PersonDrawer interaction contract:
     click-to-open, scrim/×/Esc to close, focus restored to the trigger,
     reduced-motion skips the slide transition. */
  (function () {
    var drawer = document.getElementById("session-drawer");
    if (!drawer) return;
    var panel = drawer.querySelector(".sdrawer__panel");
    var closeBtn = drawer.querySelector(".sdrawer__close");
    var roleRow = drawer.querySelector("[data-sd-role-row]");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    var lastFocus = null;
    function fill(name, value) {
      var el = drawer.querySelector('[data-sd="' + name + '"]');
      if (el) el.textContent = value;
    }
    function open(btn) {
      fill("type", btn.getAttribute("data-type") || "");
      fill("title", btn.getAttribute("data-title") || "");
      fill("day", btn.getAttribute("data-day") || "");
      fill("time", btn.getAttribute("data-time") || "");
      var role = btn.getAttribute("data-role") || "";
      if (roleRow) roleRow.hidden = !role;
      if (role) fill("role", role);
      fill("who", btn.getAttribute("data-who") || "To be announced");
      var list = drawer.querySelector("[data-sd-topics]");
      if (list) {
        list.textContent = "";
        (btn.getAttribute("data-topics") || "")
          .split("¦")
          .filter(Boolean)
          .forEach(function (topic) {
            var li = document.createElement("li");
            li.textContent = topic;
            list.appendChild(li);
          });
      }
      var linkEl = drawer.querySelector("[data-sd-link]");
      if (linkEl) {
        var href = btn.getAttribute("data-link") || "";
        linkEl.hidden = !href;
        if (href) {
          linkEl.setAttribute("href", href);
          fill("linkLabel", btn.getAttribute("data-link-label") || "Learn more");
        }
      }
      lastFocus = btn;
      drawer.hidden = false;
      requestAnimationFrame(function () { drawer.classList.add("is-open"); });
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }
    function close() {
      if (drawer.hidden) return;
      drawer.classList.remove("is-open");
      document.body.style.overflow = "";
      var done = false;
      var finish = function () { if (done) return; done = true; drawer.hidden = true; };
      if (reduce.matches) finish();
      else { if (panel) panel.addEventListener("transitionend", finish, { once: true }); setTimeout(finish, 420); }
      if (lastFocus && lastFocus.focus) lastFocus.focus();
      lastFocus = null;
    }
    document.addEventListener("click", function (e) {
      var opener = e.target.closest && e.target.closest("[data-session]");
      if (opener) { e.preventDefault(); open(opener); return; }
      if (e.target.closest && e.target.closest("[data-sdrawer-close]")) { e.preventDefault(); close(); }
    });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
  })();
</script>

<style>
  /* ── Right-rail TOC — bare lines; labels appear on hover/focus ── */
  .toc {
    position: fixed; right: clamp(0.7rem, 1.8vw, 1.6rem); top: 50%;
    transform: translateY(-50%); z-index: 60;
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem;
  }
  .toc a {
    display: flex; align-items: center; justify-content: flex-end; gap: 0.6rem;
    padding: 0.22rem 0;
  }
  .toc__line {
    width: 1.3rem; height: 2px; border-radius: 2px; flex-shrink: 0;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    transition: width 0.25s ease, background 0.25s ease;
  }
  .toc a:hover .toc__line, .toc a:focus-visible .toc__line { background: var(--accent); }
  .toc a.is-active .toc__line { width: 2.1rem; background: var(--accent); }
  .toc__label {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-soft); white-space: nowrap;
    background: color-mix(in srgb, var(--bg-elev) 86%, transparent);
    border: 1px solid var(--line); border-radius: 999px;
    padding: 0.24rem 0.7rem;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    opacity: 0; transform: translateX(8px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
  }
  .toc:hover .toc__label, .toc:focus-within .toc__label { opacity: 1; transform: none; }
  .toc a.is-active .toc__label { color: var(--accent); }
  /* Sections stop under the fixed nav when jumped to */
  #about, #days, #programme, #venue, #committees, #apply { scroll-margin-top: 72px; }
  @media (max-width: 900px) { .toc { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .toc__line, .toc__label { transition: none; }
  }

  /* ── Fact cards ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0.9rem;
    max-width: 68ch;
    margin: 2.6rem auto 0;
  }
  .fact {
    height: 100%;
    display: flex; flex-direction: column; gap: 0.35rem;
    background: var(--bg-elev-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.95rem 1.05rem;
  }
  .fact__k {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 600; color: var(--accent);
  }
  .fact__v { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; }

  /* ── Day-theme cards ── */
  .days {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 215px), 1fr));
    gap: 1rem;
    margin-top: 2.4rem;
  }
  .day {
    position: relative; overflow: clip; height: 100%;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.15rem 1.2rem 1.25rem;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .day:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); transform: translateY(-2px); }
  .day__num {
    position: absolute; top: -0.9rem; right: 0.15rem;
    font-family: var(--font-display); font-weight: 800; font-size: 4.6rem; line-height: 1;
    letter-spacing: -0.04em; color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--ink) 12%, transparent);
    pointer-events: none; user-select: none;
  }
  .day__date {
    margin: 0; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 600; color: var(--accent);
  }
  .day__theme { margin: 0.5rem 0 0; font-size: 1.02rem; line-height: 1.35; letter-spacing: -0.01em; color: var(--ink); }
  .day__topics { margin: 0.6rem 0 0; font-size: 0.8rem; line-height: 1.55; color: var(--ink-faint); }

  /* ── Stat tiles ── */
  .stats { display: flex; flex-wrap: wrap; gap: 2.2rem 3.4rem; margin-top: 2.8rem; }
  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat__n {
    font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em;
    font-size: clamp(2.1rem, 4.5vw, 3rem); line-height: 1; color: var(--accent);
  }
  .stat__l { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint); }

  /* ── Session-type palette (dark defaults; ink-dark equivalents for day) ── */
  .s--lec  { --sc: #7fb2ff; }
  .s--tut  { --sc: #7fd8a6; }
  .s--disc { --sc: #c39bf0; }
  .s--cer  { --sc: var(--accent); }
  .s--brk  { --sc: color-mix(in srgb, var(--ink) 42%, transparent); }
  :global([data-theme="light"]) .s--lec  { --sc: #2f6bd8; }
  :global([data-theme="light"]) .s--tut  { --sc: #1d7f4e; }
  :global([data-theme="light"]) .s--disc { --sc: #7444b8; }

  /* ── Legend ── */
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.6rem; }
  .lg {
    font-size: 0.74rem; color: var(--ink-soft);
    padding: 0.32rem 0.75rem 0.32rem 0.6rem;
    border: 1px solid var(--line); border-radius: 999px;
    display: inline-flex; align-items: center; gap: 0.45rem;
  }
  .lg::before {
    content: ""; width: 0.62rem; height: 0.62rem; border-radius: 3px;
    background: var(--sc); flex-shrink: 0;
  }

  /* ── The calendar grid ──
     Days on columns, 10:00–18:00 on rows in 15-min units (32 rows + header).
     Sessions are grid-placed by time, so the irregular slots (Day 1's 10:30
     start, Day 4's 17:15 split, Day 5's closing trio) land exactly. */
  .cal-scroll { overflow-x: auto; margin-top: 2rem; -webkit-overflow-scrolling: touch; }
  .cal {
    --unit: 0.95rem;
    --unit-lunch: 0.38rem; /* lunch rows compressed — the band is indicative */
    display: grid;
    grid-template-columns: 3.6rem repeat(5, minmax(158px, 1fr));
    grid-template-rows: auto repeat(32, var(--unit)); /* overridden inline with lunch-aware rows */
    gap: 0.2rem 0.4rem;
    min-width: 940px;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .cal__corner { grid-column: 1; grid-row: 1; position: sticky; left: 0; z-index: 3; background: var(--bg-elev); }
  .cal__day {
    grid-row: 1;
    display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.55rem 0.75rem 0.7rem;
    border-bottom: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .cal__wd { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.18em; font-weight: 600; color: var(--accent); }
  .cal__date { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em; color: var(--ink); }
  .cal__short { font-size: 0.72rem; color: var(--ink-faint); }

  .cal__rule { grid-column: 1 / -1; border-top: 1px dashed color-mix(in srgb, var(--ink) 8%, transparent); z-index: 0; pointer-events: none; }
  .cal__time {
    grid-column: 1;
    position: sticky; left: 0; z-index: 2;
    background: var(--bg-elev);
    font-variant-numeric: tabular-nums;
    font-size: 0.64rem; line-height: 1; color: var(--ink-faint);
    padding: 0.12rem 0.5rem 0 0;
    text-align: right;
  }

  /* Session cell — a real button; times live on the rail, details in the drawer */
  .s {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; gap: 0.2rem;
    font: inherit; text-align: left; color: inherit; cursor: pointer;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--sc) 19%, var(--bg-elev)),
      color-mix(in srgb, var(--sc) 7%, var(--bg-elev))
    );
    border: 1px solid color-mix(in srgb, var(--sc) 26%, transparent);
    border-left: 3px solid var(--sc);
    border-radius: 10px;
    padding: 0.45rem 0.65rem;
    min-width: 0; overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .s:hover, .s:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--sc) 72%, transparent);
    box-shadow: 0 14px 32px color-mix(in srgb, var(--sc) 20%, transparent);
    z-index: 2;
  }
  .s__title { font-size: 0.9rem; font-weight: 600; line-height: 1.26; letter-spacing: -0.012em; color: var(--ink); }
  .s__who { margin-top: auto; font-size: 0.68rem; color: var(--ink-faint); }
  .s__who b { font-weight: 700; color: var(--sc); letter-spacing: 0.04em; }

  /* Staggered entrance — cells cascade in when the calendar's Reveal fires */
  .s { opacity: 0; }
  :global([data-reveal].is-in) .s { animation: cell-in 0.5s ease both; animation-delay: var(--d, 0ms); }
  @keyframes cell-in {
    from { opacity: 0; transform: translateY(12px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }

  /* Breaks — hairline pills, quiet, not clickable */
  .s--brk {
    justify-content: center; cursor: default;
    background: transparent;
    border: 1px dashed color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 999px;
  }
  .s--brk .s__title {
    font-size: 0.6rem; font-weight: 600; color: var(--ink-faint);
    text-transform: uppercase; letter-spacing: 0.16em;
  }
  .s--brk:hover { transform: none; box-shadow: none; border-color: color-mix(in srgb, var(--ink) 20%, transparent); }
  .s--span { grid-column: 2 / -1; flex-direction: row; align-items: center; justify-content: center; text-align: center; }

  /* ── Session drawer ── */
  .sdrawer { position: fixed; inset: 0; z-index: 1000; }
  .sdrawer[hidden] { display: none; }
  .sdrawer__scrim { position: absolute; inset: 0; background: rgba(3, 6, 14, 0.58); opacity: 0; transition: opacity 0.3s ease; }
  .sdrawer.is-open .sdrawer__scrim { opacity: 1; }
  .sdrawer__panel {
    position: absolute; top: 0; right: 0; height: 100%;
    width: min(420px, 92vw); overflow-y: auto;
    background: var(--bg-elev); border-left: 1px solid var(--line);
    box-shadow: -20px 0 50px rgba(3, 6, 14, 0.4);
    padding: 3.4rem 1.6rem 1.8rem;
    transform: translateX(100%); transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sdrawer.is-open .sdrawer__panel { transform: translateX(0); }
  .sdrawer__close {
    position: absolute; top: 0.8rem; right: 0.8rem; z-index: 1;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    background: var(--bg-elev-2); border: 1px solid var(--line);
    color: var(--ink-soft); cursor: pointer; transition: color 0.2s, border-color 0.2s;
  }
  .sdrawer__close:hover { color: var(--ink); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .sdrawer__type {
    margin: 0; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 600; color: var(--accent);
  }
  .sdrawer__title { margin: 0.5rem 0 0; font-size: 1.25rem; line-height: 1.35; letter-spacing: -0.015em; color: var(--ink); }
  .sdrawer__meta { margin: 1.5rem 0 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .sdrawer__meta div { display: grid; grid-template-columns: 5.8rem minmax(0, 1fr); gap: 0.8rem; }
  .sdrawer__meta dt { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; color: var(--ink-faint); padding-top: 0.15rem; }
  .sdrawer__meta dd { margin: 0; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.5; }
  .sdrawer__topics { margin-top: 1.8rem; }
  .sdrawer__topics-h {
    margin: 0; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.14em;
    font-weight: 600; color: var(--ink-faint);
  }
  .sdrawer__topics ul { list-style: none; margin: 0.7rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .sdrawer__topics li {
    position: relative; padding-left: 1.05rem;
    font-size: 0.88rem; line-height: 1.55; color: var(--ink-soft);
  }
  .sdrawer__topics li::before {
    content: ""; position: absolute; left: 0; top: 0.58em;
    width: 0.42rem; height: 0.42rem; border-radius: 2px;
    background: color-mix(in srgb, var(--accent) 75%, transparent);
  }
  .sdrawer__link {
    display: inline-block; margin-top: 1.4rem;
    font-size: 0.88rem; font-weight: 600; color: var(--accent-2);
  }
  .sdrawer__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Materials button — disabled placeholder; becomes the PDF download after
     the workshop. */
  .sdrawer__pdf {
    display: block; width: 100%; margin-top: 1.8rem;
    font: inherit; font-size: 0.84rem; font-weight: 600;
    color: var(--ink-faint);
    background: var(--bg-elev-2);
    border: 1px dashed var(--line-strong); border-radius: 12px;
    padding: 0.8rem 1rem;
    cursor: not-allowed;
  }
  @media (prefers-reduced-motion: reduce) {
    .sdrawer__scrim, .sdrawer__panel { transition: none; }
  }

  .cal-note { margin-top: 1.4rem; font-size: 0.82rem; color: var(--ink-faint); max-width: 68ch; }

  /* ── Committees ── */
  .coms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
    margin-top: 2.4rem;
    max-width: 60rem;
  }
  .com {
    height: 100%;
    background: var(--bg-elev-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.3rem 1.4rem 1.4rem;
  }
  .com__title {
    margin: 0; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 600; color: var(--accent);
  }
  .com__list { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
