---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/immersive/AnimatedHero.astro";
import Reveal from "../components/immersive/Reveal.astro";
import Prose from "../components/immersive/Prose.astro";
import { withBase } from "../data/site-nav.ts";

const h2 = "font-size:clamp(1.7rem,3.6vw,2.5rem);letter-spacing:-.02em;margin:.3rem 0 0;color:var(--ink)";

/* ── Programme data ───────────────────────────────────────────────────────
   Verbatim from the circulated preliminary schedule (TDMMA_Workshop_
   Schedule_2026.pdf). Session speakers are not yet assigned — every
   lecture/tutorial/discussion renders a TBD line until they are. */
type SType = "lec" | "tut" | "disc" | "cer" | "brk";
/* t: short display title (the cell); d: the topics covered (the drawer);
   link: optional related page shown at the foot of the drawer */
interface Session { s: string; e: string; t: string; k: SType; who?: string; d?: string[]; link?: { href: string; label: string } }
interface Day { wd: string; date: string; short: string; theme: string; topics: string; sessions: Session[] }

const DAYS: Day[] = [
  {
    wd: "Mon", date: "Sep 7", short: "Foundations",
    theme: "Introduction & Foundations of Time-Domain Astronomy",
    topics: "Survey astronomy · alert brokers · stellar endpoints · compact-object physics",
    sessions: [
      /* Restructured to four 90-min blocks a day (user, 2026-07-12): shorter
         coffees (15 min), 90-min lunch, the PDF's paired 45-min topics merged
         into single blocks. */
      { s: "10:00", e: "11:30", t: "Opening & Overview", k: "cer", who: "Syed Ashraf Uddin", d: [
        "Opening ceremony and welcome address",
        "What is time-domain and multi-messenger astronomy",
        "The messengers: light, gravitational waves, neutrinos, cosmic rays",
        "Roadmap of the week",
      ] },
      { s: "11:30", e: "11:45", t: "Coffee Break", k: "brk" },
      { s: "11:45", e: "13:15", t: "The Transient Sky & Survey Astronomy", k: "lec", who: "Syed Ashraf Uddin", d: [
        "The electromagnetic transient sky — variables, novae and explosions",
        "Modern survey astronomy: ZTF and Rubin/LSST",
        "Alert brokers and the follow-up ecosystem",
      ] },
      { s: "13:15", e: "14:45", t: "Lunch Break", k: "brk" },
      { s: "14:45", e: "16:15", t: "Stellar Endpoints & Compact Objects", k: "lec", who: "Andrew L. Miller", d: [
        "Stellar evolution endpoints and their observational signatures",
        "Compact object physics — neutron stars and black holes",
        "Compact objects as engines of the transient sky",
      ] },
      { s: "16:15", e: "16:30", t: "Coffee Break", k: "brk" },
      { s: "16:30", e: "18:00", t: "Hands-on: Alert Brokers", k: "tut", who: "Syed Ashraf Uddin", d: [
        "Navigating alert streams in practice",
        "Hands-on with the ALeRCE and Fink brokers",
        "Building and filtering a follow-up target list",
      ] },
    ],
  },
  {
    wd: "Tue", date: "Sep 8", short: "Gravitational Waves",
    theme: "Gravitational Waves & Multi-Messenger Events",
    topics: "GW detection & sources · data analysis · GW170817 · kilonovae · light-curve hands-on",
    sessions: [
      { s: "10:00", e: "11:30", t: "GW Detection & Sources", k: "lec", who: "Andrew L. Miller", d: [
        "How interferometers hear spacetime: LIGO / Virgo / KAGRA",
        "Binary neutron-star and black-hole mergers as GW sources",
        "Detected populations and what they tell us",
      ] },
      { s: "11:30", e: "11:45", t: "Coffee Break", k: "brk" },
      { s: "11:45", e: "13:15", t: "GW Data Analysis & GW170817", k: "lec", who: "Andrew L. Miller", d: [
        "The GW data-analysis pipeline and parameter estimation",
        "GW170817 — anatomy of the first binary neutron-star multi-messenger event",
        "Lessons from O3 and the outlook for O4 / O5",
      ] },
      { s: "13:15", e: "14:45", t: "Lunch Break", k: "brk" },
      { s: "14:45", e: "16:15", t: "Kilonovae & Short GRBs", k: "lec", who: "Syed Ashraf Uddin", d: [
        "Kilonovae — observations and theoretical models",
        "r-process nucleosynthesis and heavy-element production in mergers",
        "Short gamma-ray bursts as compact binary merger counterparts",
      ] },
      { s: "16:15", e: "16:30", t: "Coffee Break", k: "brk" },
      /* Hands-on rotation (user, 2026-07-12): light-curve analysis closes the
         GW/multi-messenger day — GW170817's kilonova is the worked example. */
      { s: "16:30", e: "18:00", t: "Hands-on: Light Curves", k: "tut", who: "Syed Ashraf Uddin", d: [
        "Reading the light curves of multi-messenger events — GW170817's kilonova as the worked example",
        "Multi-wavelength light-curve analysis for high-energy transients",
        "From raw photometry to physical interpretation",
      ] },
    ],
  },
  {
    wd: "Wed", date: "Sep 9", short: "High-Energy & Neutrinos",
    theme: "High-Energy Transients & Neutrino Astronomy",
    topics: "Long GRBs · tidal disruption events · IceCube · cosmic rays · ML classification hands-on",
    sessions: [
      { s: "10:00", e: "11:30", t: "Long GRBs & Tidal Disruptions", k: "lec", who: "Syed Ashraf Uddin", d: [
        "Long gamma-ray bursts — progenitors, jets and afterglows",
        "Tidal disruption events — theory and multiwavelength observations",
      ] },
      { s: "11:30", e: "11:45", t: "Coffee Break", k: "brk" },
      { s: "11:45", e: "13:15", t: "Neutrino Astronomy with IceCube", k: "lec", who: "Andrew L. Miller", d: [
        "Detecting high-energy neutrinos at the South Pole",
        "Neutrino source searches and multi-messenger connections",
      ] },
      { s: "13:15", e: "14:45", t: "Lunch Break", k: "brk" },
      { s: "14:45", e: "16:15", t: "Neutrino Sources & Cosmic Rays", k: "lec", who: "Andrew L. Miller", d: [
        "Candidate sources — AGN, blazars and starburst galaxies",
        "TXS 0506+056 — a neutrino–blazar multi-messenger case study",
        "AGN variability and changing-look AGN",
        "Ultra-high-energy cosmic rays and their multi-messenger connections",
      ] },
      { s: "16:15", e: "16:30", t: "Coffee Break", k: "brk" },
      /* Hands-on rotation (user, 2026-07-12): ML classification closes the
         high-energy day — classifying the transients covered in its lectures. */
      { s: "16:30", e: "18:00", t: "Hands-on: ML Classification", k: "tut", who: "Andrew L. Miller", d: [
        "Light-curve classification with ParSNIP and RAPID",
        "Training, validating and interpreting a transient classifier",
        "Applying the classifiers to the day's transients — GRBs, TDEs and their impostors",
      ] },
    ],
  },
  {
    wd: "Thu", date: "Sep 10", short: "Transients & Data Science",
    theme: "Stellar Transients & Data Science Methods",
    topics: "Core-collapse & thermonuclear SNe · pulsars & FRBs · ML for transients · TART ionosphere hands-on",
    sessions: [
      { s: "10:00", e: "11:30", t: "Supernovae", k: "lec", who: "Syed Ashraf Uddin", d: [
        "Core-collapse supernovae — explosion mechanisms and multi-messenger signatures",
        "Type Ia supernovae as cosmological standard candles",
      ] },
      { s: "11:30", e: "11:45", t: "Coffee Break", k: "brk" },
      /* Asad's sessions 1 + 2 combined (Jul 4 abstracts) — pulsars and FRBs
         in one block per user, 2026-07-12. */
      { s: "11:45", e: "13:15", t: "Pulsars & Fast Radio Bursts", k: "lec", who: "Khan Muhammad Bin Asad", d: [
        "Pulsars as clock-like radio sources: discovery and timing — beamforming, dedispersion, folding, arrival-time modelling",
        "MeerKAT precision timing and searches (MeerTime, the MeerKAT PTA, TRAPUM) and LOFAR's metre-wavelength view of scattering and the interstellar medium",
        "Pulsar timing arrays as a nanohertz GW detector (the 2023 background); neutron-star masses and the equation of state feeding merger science",
        "Fast radio bursts — millisecond flashes from cosmological distances; dispersion measure as a cosmic ruler; repeaters versus one-offs",
        "MeerKAT's real-time MeerTRAP localizations pinning bursts to host galaxies; LOFAR's 110 MHz detection of repeater FRB 20180916B",
        "The obstacles head-on: dispersion, scattering, scintillation, interference; localizing single bursts and identifying hosts",
        "Ahead to SKA-Mid, DSA-2000, CHORD and BURSTT; the Macquart relation and the magnetar connection to the GW sky",
      ] },
      { s: "13:15", e: "14:45", t: "Lunch Break", k: "brk" },
      { s: "14:45", e: "16:15", t: "Machine Learning for Transients", k: "lec", who: "Andrew L. Miller", d: [
        "ML methods for transient classification",
        "Real-time pipelines and photometric classification in the LSST era",
        "Challenges and opportunities in big-data astronomy",
      ] },
      { s: "16:15", e: "16:30", t: "Coffee Break", k: "brk" },
      /* Asad's session 3 (Jul 4 abstract) — TART lands on the data-methods day,
         straight after his morning Pulsars & FRBs lecture, whose dispersion
         measures this hands-on corrects (rotation, 2026-07-12). */
      { s: "16:30", e: "18:00", t: "Hands-on: Ionosphere with TART", k: "tut", who: "Khan Muhammad Bin Asad",
        link: { href: "/research/tart", label: "CASSA's TART array" }, d: [
        "The ionosphere as the foreground of low-frequency timing and burst work — dispersion-like delays, phase corruption, and scintillation that mimics or masks a source's own variability",
        "CASSA's TART — a 24-antenna rooftop aperture-synthesis array on the IUB campus, observing in the GPS L1 band",
        "Measuring total electron content (TEC) with GNSS signals; capturing scintillation directly with all-sky imaging",
        "Dhaka under the crest of the Equatorial Ionization Anomaly, where TEC gradients and scintillation peak",
        "Mitigation: co-located TEC corrects the morning lecture's pulsar-timing and FRB dispersion measures · Discrimination: separating cosmic from local scintillation",
        "The array behind CASSA's planned radio-astronomy school",
      ] },
    ],
  },
  {
    wd: "Fri", date: "Sep 11", short: "Future Facilities",
    theme: "Future Facilities & Synthesis",
    topics: "Einstein Telescope · Rubin LSST · CTA · GW follow-up · participant talks · closing panel",
    sessions: [
      { s: "10:00", e: "11:30", t: "Next-Generation Facilities", k: "lec", who: "Andrew L. Miller", d: [
        "Next-generation GW detectors — Einstein Telescope, Cosmic Explorer, LISA",
        "Future radio facilities — SKA and ngVLA for transient science",
        "Rubin LSST — science drivers, data products, community access",
        "High-energy multi-messenger astronomy with CTA and Fermi",
      ] },
      { s: "11:30", e: "11:45", t: "Coffee Break", k: "brk" },
      { s: "11:45", e: "13:15", t: "GW Follow-up Strategies", k: "lec", who: "Andrew L. Miller", d: [
        "GW sky localization and low-latency alerts",
        "Electromagnetic follow-up strategies for LIGO / Virgo / KAGRA events",
        "Coordinating multi-messenger observing campaigns",
      ] },
      { s: "13:15", e: "14:45", t: "Lunch Break", k: "brk" },
      { s: "14:45", e: "16:15", t: "Space Observatories & Synergies", k: "lec", who: "Syed Ashraf Uddin", d: [
        "Space-based observatories — SVOM, THESEUS and beyond",
        "Synergies across messengers — integrated science cases for the 2030s",
      ] },
      { s: "16:15", e: "16:30", t: "Coffee Break", k: "brk" },
      { s: "16:30", e: "18:00", t: "Short Talks · Panel · Closing", k: "cer", who: "Syed Ashraf Uddin", d: [
        "Participant short talks",
        "Panel discussion: the future of TDMMA — open questions and opportunities",
        "Closing remarks and certificate distribution",
      ] },
    ],
  },
];

/* Calendar geometry: 10:00–18:00 in 15-min grid rows (row 1 = day headers). */
const mins = (hm: string) => { const [h, m] = hm.split(":").map(Number); return h * 60 + m; };
const row = (hm: string) => (mins(hm) - 600) / 15 + 2;

/* Breaks shared by all five days render once, spanning the full week. */
const isCommonBreak = (x: Session) =>
  x.k === "brk" && DAYS.every((d) => d.sessions.some((y) => y.k === "brk" && y.s === x.s && y.e === x.e));
const commonBreaks = DAYS[0].sessions.filter(isCommonBreak);

const all = DAYS.flatMap((d) => d.sessions);
const nSes = all.filter((x) => x.k !== "brk").length;
const nLec = all.filter((x) => x.k === "lec").length;
const nTut = all.filter((x) => x.k === "tut").length;

/* The time rail carries one label per slot boundary (every distinct session
   start plus the closing 18:00), each spanning down to the next boundary. */
const BOUNDS = [...new Set([...all.map((x) => x.s), "18:00"])].sort((a, b) => mins(a) - mins(b));
const boundSpan = (i: number) => (i === BOUNDS.length - 1 ? 1 : (mins(BOUNDS[i + 1]) - mins(BOUNDS[i])) / 15);

/* Lunch is indicative, not proportional: its 15-min grid rows get a compressed
   height so the 90-min band renders as a slim strip. */
const LUNCH = DAYS[0].sessions.find((x) => x.k === "brk" && mins(x.e) - mins(x.s) > 30)!;
const rowsTemplate = Array.from({ length: 32 }, (_, i) => {
  const m = 600 + i * 15;
  return m >= mins(LUNCH.s) && m < mins(LUNCH.e) ? "var(--unit-lunch)" : "var(--unit)";
}).join(" ");

const tbdRole: Record<string, string> = { lec: "Speaker", tut: "Moderator", disc: "Moderator", cer: "Speaker" };
/* Cells carry initials-style short names; the drawer shows the full name. */
const SHORT: Record<string, string> = {
  "Khan Muhammad Bin Asad": "KMB Asad",
  "Syed Ashraf Uddin": "SA Uddin",
  "Andrew L. Miller": "AL Miller",
};
const shortWho = (w?: string) => (w ? (SHORT[w] ?? w) : undefined);

/* Registration milestones — opening date set by the SOC (user, 2026-07-12);
   the intermediate dates are reasonable placeholders pending confirmation. */
const DEADLINES = [
  ["Application opens", "14 July 2026"],
  ["Application closes", "14 August 2026"],
  ["Participant list announced", "21 August 2026"],
  ["Registration & payment", "by 31 August 2026"],
  ["Workshop begins", "7 September 2026"],
];
const typeLabel: Record<string, string> = { lec: "Lecture", tut: "Tutorial / hands-on", disc: "Discussion · panel", cer: "Ceremony · talks" };

/* ── Committees ── */
const SOC = [
  { name: "Andrew L. Miller", aff: "ICTP-AP · University of Chinese Academy of Sciences, Beijing", email: "andrew.miller.ligo@ucas.ac.cn" },
  { name: "Syed Ashraf Uddin", aff: "Core Member, CASSA · Independent University, Bangladesh", email: "uddinsa@iub.edu.bd" },
  { name: "Khan Muhammad Bin Asad", aff: "Core Member, CASSA · Independent University, Bangladesh", email: "kasad@iub.edu.bd" },
];
const LOC = [
  { name: "Muhammad Jobair Hasan", aff: "Science Manager, CASSA", email: "jobair@iub.edu.bd" },
  { name: "Md Shahadat Hossain Shahal", aff: "Research Assistant, CASSA", email: "shahadatw6@gmail.com" },
];
---

<BaseLayout
  title="TDMMA Workshop 2026 — CASSA"
  description="CASSA's workshop on Time-Domain and Multi-Messenger Astronomy (TDMMA), 7–11 September 2026 at Independent University, Bangladesh — five days of lectures, hands-on tutorials and panels, from GW170817 to the Rubin-LSST era."
  current="/tdmma-2026"
>
  <AnimatedHero
    theme="merger"
    eyebrow="CASSA Workshop · 7–11 September 2026"
    title="Time-Domain & Multi-Messenger Astronomy"
    lede="Five days on the astronomy of a changing sky — gravitational waves, neutrinos, and light from the most violent events in the universe — at Independent University, Bangladesh."
  >
    <Fragment slot="meta">
      <span>Sept 7–11, 2026</span><span aria-hidden="true">·</span>
      <span>10:00 AM – 6:00 PM</span><span aria-hidden="true">·</span>
      <span>IUB, Dhaka</span><span aria-hidden="true">·</span>
      <span>Lectures · Tutorials · Panels</span>
    </Fragment>
  </AnimatedHero>

  <!-- Right-rail TOC: bare lines; labels reveal on hover/focus; active section
       tracked on scroll. Desktop only. -->
  <nav class="toc" aria-label="On this page">
    {[
      ["about", "About"],
      ["days", "The five days"],
      ["programme", "Programme"],
      ["venue", "Venue"],
      ["committees", "Committees"],
      ["apply", "Apply"],
    ].map(([id, label]) => (
      <a href={`#${id}`} data-toc={id}>
        <span class="toc__label">{label}</span>
        <span class="toc__line" aria-hidden="true"></span>
      </a>
    ))}
  </nav>

  <!-- ── Overview ─────────────────────────────────────────────────────── -->
  <section class="section section--elev" id="about">
    <div class="wrap">
      <Reveal><p class="eyebrow">About the workshop</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>One sky, many messengers</h2>
          <p>
            Astronomy no longer watches a still sky. Surveys like ZTF and the
            upcoming Rubin&nbsp;LSST catch the universe changing night by night,
            while gravitational-wave detectors and neutrino observatories listen
            to it through entirely different messengers. <strong>Time-Domain and
            Multi-Messenger Astronomy (TDMMA)</strong> is where those signals
            meet — and this workshop is CASSA's five-day introduction to doing
            science there, from the physics of compact-object mergers to the
            machine-learning pipelines that sort a million alerts a night.
          </p>
          <p>
            The programme is anchored by <strong>Dr.&nbsp;Andrew&nbsp;L.
            Miller</strong> — assistant professor at the International Centre for
            Theoretical Physics Asia-Pacific (ICTP-AP, UCAS Beijing) and a member
            of the LIGO/Virgo collaboration — visiting CASSA as invited lecturer
            for the gravitational-wave portion of the week, alongside CASSA
            faculty and resource people from IUB. Individual session speakers
            will be announced with the final programme.
          </p>
          <p>
            The goal is capacity building: participants leave able to follow a
            gravitational-wave alert, read a kilonova light curve, and start
            research in gravitational-wave astrophysics and time-domain
            astronomy in general.
          </p>
        </Prose>
      </Reveal>

      <div class="facts">
        {[
          ["Dates", "September 7–11, 2026 (Mon–Fri)"],
          ["Hours", "10:00 AM – 6:00 PM · lunch 1:15–2:45 PM"],
          ["Venue", "Independent University, Bangladesh — Bashundhara, Dhaka"],
          ["Format", "Four 90-minute sessions a day — lectures · hands-on tutorials · panels"],
          ["Certificates", "Awarded at the closing ceremony"],
        ].map(([k, v], i) => (
          <Reveal delay={100 + i * 60}>
            <div class="fact"><span class="fact__k">{k}</span><span class="fact__v">{v}</span></div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The five days ────────────────────────────────────────────────── -->
  <section class="section" id="days">
    <div class="wrap">
      <Reveal><p class="eyebrow">The arc of the week</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Five days, five themes</h2></Reveal>
      <div class="days">
        {DAYS.map((d, i) => (
          <Reveal delay={90 + i * 70}>
            <article class="day">
              <span class="day__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <p class="day__date">{d.wd} · {d.date}</p>
              <h3 class="day__theme">{d.theme}</h3>
              <p class="day__topics">{d.topics}</p>
            </article>
          </Reveal>
        ))}
      </div>
      <div class="stats">
        {[
          ["5", "days"],
          [String(nSes), "sessions of 90 minutes"],
          [String(nLec), "lectures"],
          [String(nTut), "hands-on tutorials"],
        ].map(([n, l], i) => (
          <Reveal delay={120 + i * 60}>
            <div class="stat"><span class="stat__n">{n}</span><span class="stat__l">{l}</span></div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Programme calendar ───────────────────────────────────────────── -->
  <section class="section section--elev" id="programme">
    <div class="wrap">
      <Reveal><p class="eyebrow">Preliminary programme</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>The week, hour by hour</h2></Reveal>
      <Reveal delay={100}>
        <div class="legend" aria-hidden="true">
          {(["lec", "tut", "disc", "cer"] as const)
            .filter((k) => all.some((x) => x.k === k))
            .map((k) => <span class={`lg s--${k}`}>{typeLabel[k]}</span>)}
          <span class="lg s--brk">Break</span>
        </div>
      </Reveal>
    </div>

    <Reveal delay={140}>
      <div class="cal-scroll wrap" role="region" aria-label="Workshop programme calendar" tabindex="0">
        <div class="cal" style={`grid-template-rows:auto ${rowsTemplate}`}>
          {/* day headers */}
          <div class="cal__corner" aria-hidden="true"></div>
          {DAYS.map((d) => (
            <div class="cal__day">
              <span class="cal__wd">{d.wd}</span>
              <span class="cal__date">{d.date}</span>
              <span class="cal__short">{d.short}</span>
            </div>
          ))}

          {/* slot rules + per-slot time labels on the rail */}
          {BOUNDS.map((b, i) => (
            <Fragment>
              <div class="cal__rule" style={`grid-row:${row(b)}`} aria-hidden="true"></div>
              <div class="cal__time" style={`grid-row:${row(b)} / span ${boundSpan(i)}`}>{b}</div>
            </Fragment>
          ))}

          {/* week-wide breaks (identical across all five days) */}
          {commonBreaks.map((b) => (
            <div class="s s--brk s--span" style={`grid-row:${row(b.s)} / ${row(b.e)}`}>
              <span class="s__title">{b.t}</span>
            </div>
          ))}

          {/* sessions, one column per day — click opens the detail drawer */}
          {DAYS.map((d, di) =>
            d.sessions.filter((x) => !isCommonBreak(x)).map((x, si) => (
              <button
                type="button"
                class:list={["s", `s--${x.k}`]}
                style={`grid-column:${di + 2};grid-row:${row(x.s)} / ${row(x.e)};--d:${di * 70 + si * 45}ms`}
                data-session
                data-title={x.t}
                data-day={`${d.wd} · ${d.date} — ${d.theme}`}
                data-time={`${x.s}–${x.e}`}
                data-type={typeLabel[x.k]}
                data-role={tbdRole[x.k] ?? ""}
                data-who={x.who ?? ""}
                data-topics={(x.d ?? []).join("¦")}
                data-link={x.link ? withBase(x.link.href) : ""}
                data-link-label={x.link?.label ?? ""}
                aria-haspopup="dialog"
              >
                <span class="s__title">{x.t}</span>
                {tbdRole[x.k] && <span class="s__who">{tbdRole[x.k]} · <b>{shortWho(x.who) ?? "TBD"}</b></span>}
              </button>
            ))
          )}
        </div>
      </div>
    </Reveal>

    <div class="wrap">
      <Reveal delay={160}>
        <p class="cal-note">
          Preliminary schedule — session order, times and speakers may change
          until the final programme is published. Click a session for details;
          on phones, swipe the calendar sideways.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- Session-detail drawer (opened by any [data-session] cell) -->
  <div id="session-drawer" class="sdrawer" hidden>
    <div class="sdrawer__scrim" data-sdrawer-close></div>
    <aside class="sdrawer__panel" role="dialog" aria-modal="true" aria-label="Session details" tabindex="-1">
      <button type="button" class="sdrawer__close" data-sdrawer-close aria-label="Close session details">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <p class="sdrawer__type" data-sd="type"></p>
      <h3 class="sdrawer__title" data-sd="title"></h3>
      <dl class="sdrawer__meta">
