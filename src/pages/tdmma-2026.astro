/* Calendar geometry: 10:00–18:00 in 15-min grid rows (row 1 = day headers). */
const mins = (hm: string) => { const [h, m] = hm.split(":").map(Number); return h * 60 + m; };
const row = (hm: string) => (mins(hm) - 600) / 15 + 2;

/* Breaks shared by all five days render once, spanning the full week. */
const isCommonBreak = (x: Session) =>
  x.k === "brk" && DAYS.every((d) => d.sessions.some((y) => y.k === "brk" && y.s === x.s && y.e === x.e));
const commonBreaks = DAYS[0].sessions.filter(isCommonBreak);

const all = DAYS.flatMap((d) => d.sessions);
const nSes = all.filter((x) => x.k !== "brk").length;
const nLec = all.filter((x) => x.k === "lec").length;
const nTut = all.filter((x) => x.k === "tut").length;

/* The time rail carries one label per slot boundary (every distinct session
   start plus the closing 18:00), each spanning down to the next boundary. */
const BOUNDS = [...new Set([...all.map((x) => x.s), "18:00"])].sort((a, b) => mins(a) - mins(b));
const boundSpan = (i: number) => (i === BOUNDS.length - 1 ? 1 : (mins(BOUNDS[i + 1]) - mins(BOUNDS[i])) / 15);

/* Lunch is indicative, not proportional: its 15-min grid rows get a compressed
   height so the 90-min band renders as a slim strip. */
const LUNCH = DAYS[0].sessions.find((x) => x.k === "brk" && mins(x.e) - mins(x.s) > 30)!;
const rowsTemplate = Array.from({ length: 32 }, (_, i) => {
  const m = 600 + i * 15;
  return m >= mins(LUNCH.s) && m < mins(LUNCH.e) ? "var(--unit-lunch)" : "var(--unit)";
}).join(" ");

/* Speaker names stay out of the calendar cells (user, 2026-07-16) — the
   drawer alone carries the attribution. */
const tbdRole: Record<string, string> = { lec: "Speaker", tut: "Moderator", disc: "Moderator", cer: "Speaker" };

/* Registration milestones — opening date set by the SOC (user, 2026-07-12);
   the intermediate dates are reasonable placeholders pending confirmation.
   The close was moved forward from 14 August to 31 July for logistics (user,
   2026-07-21), then EXTENDED to 7 August (user, 2026-08-02) — the 31 July close
   had already passed, so this reopens applications for a further week. EXTENDED
   again to 14 August (user, 2026-08-09), back to the original close and the date
   the printed A5 brochure carries; the 7 August close had already passed, so
   this reopens applications for a further week. EXTENDED once more to 18 August
   (user, 2026-08-14) — read off the live form's Settings, which is the governing
   value. The announcement and payment dates have never moved; the review window
   narrows from three weeks to three days. */
const DEADLINES = [
  ["Application opens", "14 July 2026"],
  ["Application closes", "18 August 2026"],
  ["Participant list announced", "21 August 2026"],
  ["Registration & payment", "by 31 August 2026"],
  ["Workshop begins", "7 September 2026"],
];

/* The same instant the inside-portal form closes on (end of 18 August, Dhaka) —
   now shared from src/data/tdmma.ts so this page's counter and the home-hero
