   (inside.cassa.bd → Forms → TDMMA Workshop 2026), which is what actually gates
   submission, so the page counter and the form counter never disagree. */
const APPLY_CLOSES = TDMMA_APPLY_CLOSES;
const typeLabel: Record<string, string> = { lec: "Lecture", tut: "Tutorial / hands-on", disc: "Discussion · panel", cer: "Ceremony · talks" };

/* ── People: invited speakers (full-width, prominent) + the two committees ──
   web: each speaker's public page — CASSA profiles for Uddin and Asad,
   personal / institutional sites otherwise (Miller's from his email
   signature). Photos for Miller and Ghosh fetched from those sites
   (2026-07-14); the rest reuse the people-collection portraits.
   Burke added 2026-08-09 (user) — the printed A5 brochure lists seven resource
   people and the page had six. Title/affiliation from his Yale listing and
   personal site, portrait cropped from the full-length photo there (the
   brochure's own thumbnail is only 100px). He sits after the IUB faculty and
   before Ahmed, matching both the seniority order used here and the brochure's
   Burke→Ahmed adjacency. */
const SPEAKERS = [
  { name: "Andrew L. Miller", aff: "Assistant Professor, ICTP-AP · University of Chinese Academy of Sciences, Beijing", email: "andrew.miller.ligo@ucas.ac.cn", web: "https://andrew-l-miller.github.io", ext: true, photo: "/people/miller.webp" },
  { name: "M Arshad Momen", aff: "Professor, IUB · Core Member, CASSA", email: "arshad@iub.edu.bd", web: "https://iub.ac.bd/academics/departments/ps/faculty-and-staff/arshad", ext: true, photo: "/people/momen.webp" },
  { name: "Syed Ashraf Uddin", aff: "Associate Professor, IUB · Core Member, CASSA", email: "uddinsa@iub.edu.bd", web: withBase("/people/uddin"), ext: false, photo: "/people/uddin.webp" },
  { name: "Khan Muhammad Bin Asad", aff: "Assistant Professor, IUB · Core Member, CASSA", email: "kasad@iub.edu.bd", web: withBase("/people/asad"), ext: false, photo: "/people/asad.webp" },
  { name: "Jewel Kumar Ghosh", aff: "Assistant Professor, Department of Physical Sciences, IUB", email: "jewel.ghosh@iub.edu.bd", web: "https://iub.ac.bd/academics/departments/ps/faculty-and-staff/jewel.ghosh", ext: true, photo: "/people/ghosh.webp" },
  { name: "Colin J. Burke", aff: "NSF AAPF Postdoctoral Fellow, Department of Astronomy, Yale University · incoming Assistant Professor, University of North Texas", email: "colin.j.burke@yale.edu", web: "https://burke86.github.io", ext: true, photo: "/people/burke.webp" },
  { name: "Md Redyan Ahmed", aff: "PhD candidate, University of Sydney · Graduate Member, CASSA", email: "mahm0320@uni.sydney.edu.au", web: "https://sites.google.com/view/md-redyan-ahmed", ext: true, photo: "/people/ahmed.webp" },
