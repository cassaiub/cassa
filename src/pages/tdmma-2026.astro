    </div>
  </section>
</BaseLayout>

<script is:inline>
  /* Page submenu — highlights the section currently in view and, on narrow
     screens where the bar scrolls sideways, keeps that link visible. */
  (function () {
    var bar = document.querySelector(".subnav");
    if (!bar) return;
    var rail = bar.querySelector(".subnav__links");
    var links = Array.prototype.slice.call(bar.querySelectorAll("[data-sec]"));
    if (!links.length) return;
    var sections = links
      .map(function (a) { return document.getElementById(a.getAttribute("data-sec")); })
      .filter(Boolean);
    var current = null;
    function update() {
      var mark = window.innerHeight * 0.4;
      var active = null;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= mark) active = sections[i].id;
      }
      links.forEach(function (a) {
        a.classList.toggle("is-active", a.getAttribute("data-sec") === active);
      });
      if (active === current) return;
      current = active;
      /* Only the overflowing link rail scrolls; the Apply pill sits outside it. */
      if (!rail || rail.scrollWidth <= rail.clientWidth + 1) return;
      var link = links.filter(function (a) { return a.getAttribute("data-sec") === active; })[0];
      if (link && rail.contains(link)) {
        rail.scrollTo({
          left: link.offsetLeft - (rail.clientWidth - link.offsetWidth) / 2,
          behavior: "smooth",
        });
      }
    }
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();

  /* Session drawer — mirrors the PersonDrawer interaction contract:
     click-to-open, scrim/×/Esc to close, focus restored to the trigger,
     reduced-motion skips the slide transition. */
  (function () {
    var drawer = document.getElementById("session-drawer");
    if (!drawer) return;
    var panel = drawer.querySelector(".sdrawer__panel");
    var closeBtn = drawer.querySelector(".sdrawer__close");
    var roleRow = drawer.querySelector("[data-sd-role-row]");
    var taRow = drawer.querySelector("[data-sd-ta-row]");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    var lastFocus = null;
    function fill(name, value) {
      var el = drawer.querySelector('[data-sd="' + name + '"]');
      if (el) el.textContent = value;
    }
    function open(btn) {
      fill("type", btn.getAttribute("data-type") || "");
      fill("title", btn.getAttribute("data-title") || "");
      fill("day", btn.getAttribute("data-day") || "");
      fill("time", btn.getAttribute("data-time") || "");
      var role = btn.getAttribute("data-role") || "";
      if (roleRow) roleRow.hidden = !role;
      if (role) fill("role", role);
      fill("who", btn.getAttribute("data-who") || "To be announced");
      var ta = btn.getAttribute("data-ta") || "";
      if (taRow) taRow.hidden = !ta;
      if (ta) fill("ta", ta);
      var list = drawer.querySelector("[data-sd-topics]");
      if (list) {
        list.textContent = "";
        (btn.getAttribute("data-topics") || "")
          .split("¦")
          .filter(Boolean)
          .forEach(function (topic) {
            var li = document.createElement("li");
            li.textContent = topic;
            list.appendChild(li);
          });
      }
      var linkEl = drawer.querySelector("[data-sd-link]");
      if (linkEl) {
        var href = btn.getAttribute("data-link") || "";
        linkEl.hidden = !href;
        if (href) {
          linkEl.setAttribute("href", href);
          fill("linkLabel", btn.getAttribute("data-link-label") || "Learn more");
        }
      }
      lastFocus = btn;
      drawer.hidden = false;
      requestAnimationFrame(function () { drawer.classList.add("is-open"); });
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }
    function close() {
      if (drawer.hidden) return;
      drawer.classList.remove("is-open");
      document.body.style.overflow = "";
      var done = false;
      var finish = function () { if (done) return; done = true; drawer.hidden = true; };
      if (reduce.matches) finish();
      else { if (panel) panel.addEventListener("transitionend", finish, { once: true }); setTimeout(finish, 420); }
      if (lastFocus && lastFocus.focus) lastFocus.focus();
      lastFocus = null;
    }
    document.addEventListener("click", function (e) {
      var opener = e.target.closest && e.target.closest("[data-session]");
      if (opener) { e.preventDefault(); open(opener); return; }
      if (e.target.closest && e.target.closest("[data-sdrawer-close]")) { e.preventDefault(); close(); }
    });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
  })();
</script>

<style is:global>
  /* This page only: the site nav scrolls away with the hero — the page submenu
     below is the one sticky bar. (Global default is position: fixed.) */
  #site-nav { position: absolute; }
</style>

<style>
  /* ── Page submenu ──
     Rides directly under the hero, then pins to the viewport top — the site
     nav scrolls away on this page (see the is:global block above). */
  .subnav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .subnav__row { display: flex; align-items: center; gap: 1rem; height: 54px; }
  /* Wordmark — the page's own identity on the pinned bar */
  .subnav__brand {
    flex-shrink: 0;
    display: inline-flex; align-items: baseline; gap: 0.28rem;
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    letter-spacing: -0.015em; color: var(--ink); line-height: 1;
    padding-right: clamp(0.7rem, 2vw, 1.3rem);
    border-right: 1px solid var(--line);
  }
  .subnav__brand span { color: var(--accent); }
  .subnav__links {
    display: flex; align-items: center; gap: clamp(0.9rem, 2.4vw, 2rem);
    min-width: 0; flex: 1 1 auto;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .subnav__links::-webkit-scrollbar { display: none; }
  .subnav__link {
    position: relative; flex-shrink: 0;
    display: inline-flex; align-items: center; height: 54px;
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;
    color: var(--ink-faint); white-space: nowrap;
    transition: color 0.2s ease;
  }
  /* Accent rule that rides the bar's bottom border on the active section */
  .subnav__link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
    background: var(--accent); border-radius: 2px;
    transform: scaleX(0); transform-origin: center;
    transition: transform 0.25s ease;
  }
  .subnav__link:hover { color: var(--ink); }
  .subnav__link.is-active { color: var(--accent); }
  .subnav__link.is-active::after { transform: scaleX(1); }

  /* Apply stays a pill, outside the scrolling rail — always reachable */
  .subnav__cta {
    flex-shrink: 0;
    font-size: 0.8rem; font-weight: 600; white-space: nowrap;
    color: var(--accent-ink); background: var(--accent);
    padding: 0.42rem 1rem; border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .subnav__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  /* Sections stop under the pinned submenu when jumped to */
  #about, #programme, #venue, #speakers, #organisers, #apply { scroll-margin-top: 70px; }

  @media (max-width: 640px) {
    .subnav__row { gap: 0.7rem; }
    .subnav__links { gap: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .subnav__link, .subnav__link::after, .subnav__cta { transition: none; }
    .subnav__cta:hover { transform: none; }
  }

  /* ── About: lede beside the four-sciences rail ── */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    gap: clamp(2.2rem, 5vw, 4.8rem);
    align-items: start;
    margin-top: 0.4rem;
  }
  /* The prose fills its column instead of self-centering at 68ch */
  .about__lede :global(.prose-cassa) { max-width: none; margin-inline: 0; }
  .about__sci {
    border-left: 1px solid var(--line);
    padding-left: clamp(1.4rem, 2.6vw, 2.2rem);
  }
  .about__sci-h {
    margin: 0.6rem 0 0;
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.18em;
    font-weight: 700; color: var(--ink-faint);
  }
  .sci { list-style: none; counter-reset: sci; margin: 0.4rem 0 0; padding: 0; }
  .sci > li {
    counter-increment: sci;
    position: relative;
    padding: 1.05rem 0 1.1rem 3.1rem;
    border-top: 1px solid var(--line);
  }
  .sci > li:first-child { border-top: 0; }
  .sci > li::before {
    content: counter(sci, decimal-leading-zero);
    position: absolute; left: 0; top: 1.05rem;
    font-family: var(--font-display); font-weight: 800; font-size: 1.75rem; line-height: 1;
    letter-spacing: -0.03em; color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .sci__day {
    display: block;
    font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 700; color: var(--accent);
  }
  .sci__t {
    display: block; margin-top: 0.25rem;
    font-weight: 700; font-size: 0.98rem; line-height: 1.35;
    letter-spacing: -0.01em; color: var(--ink);
  }
  .sci__d { margin: 0.4rem 0 0; font-size: 0.85rem; line-height: 1.62; color: var(--ink-soft); }
  .sci__coda {
    margin: 0; padding-top: 1.05rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem; line-height: 1.62; color: var(--ink-faint);
  }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .about__sci { border-left: 0; padding-left: 0; }
  }

  /* ── Fact cards ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0.9rem;
    margin-top: 2.8rem;
  }
  .fact {
    height: 100%;
    display: flex; flex-direction: column; gap: 0.35rem;
    background: var(--bg-elev-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.95rem 1.05rem;
  }
  .fact__k {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 600; color: var(--accent);
  }
  .fact__v { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; }

  /* ── Stat tiles (under the calendar) ── */
  .stats { display: flex; flex-wrap: wrap; gap: 2.2rem 3.4rem; margin-top: 2.6rem; }
  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat__n {
    font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em;
    font-size: clamp(2.1rem, 4.5vw, 3rem); line-height: 1; color: var(--accent);
  }
  .stat__l { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint); }

  /* ── Session-type palette (dark defaults; ink-dark equivalents for day) ── */
  .s--lec  { --sc: #7fb2ff; }
  .s--tut  { --sc: #7fd8a6; }
  .s--disc { --sc: #c39bf0; }
  .s--cer  { --sc: var(--accent); }
  .s--brk  { --sc: color-mix(in srgb, var(--ink) 42%, transparent); }
  :global([data-theme="light"]) .s--lec  { --sc: #2f6bd8; }
  :global([data-theme="light"]) .s--tut  { --sc: #1d7f4e; }
  :global([data-theme="light"]) .s--disc { --sc: #7444b8; }

  /* Tentative-programme notice — deliberately prominent, above the legend */
  .cal-tentative {
    margin: 1.5rem 0 0; max-width: 64ch;
    padding: 0.8rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border-radius: 0 12px 12px 0;
    font-size: 0.94rem; line-height: 1.65; color: var(--ink-soft);
  }
  .cal-tentative strong { color: var(--ink); }

  /* ── Legend ── */
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.6rem; }
  .lg {
    font-size: 0.74rem; color: var(--ink-soft);
    padding: 0.32rem 0.75rem 0.32rem 0.6rem;
    border: 1px solid var(--line); border-radius: 999px;
    display: inline-flex; align-items: center; gap: 0.45rem;
  }
  .lg::before {
    content: ""; width: 0.62rem; height: 0.62rem; border-radius: 3px;
    background: var(--sc); flex-shrink: 0;
  }

  /* ── The calendar grid ──
     Days on columns, 10:00 to the week's last event on rows in 15-min units.
     Sessions are grid-placed by time, so the irregular slots (Day 1's 10:30
     start, Day 4's 17:15 split, Day 5's closing trio) land exactly. */
  .cal-scroll { overflow-x: auto; margin-top: 2rem; -webkit-overflow-scrolling: touch; }
  .cal {
    --unit: 1.5rem; /* 45-min sessions span 3 units — a two-line title plus the instructor line */
    --unit-lunch: 0.38rem; /* lunch rows compressed — the band is indicative */
    display: grid;
    grid-template-columns: 3.6rem repeat(5, minmax(158px, 1fr));
    grid-template-rows: auto repeat(32, var(--unit)); /* always overridden inline: derived row count, lunch-aware heights */
    gap: 0.2rem 0.4rem;
    min-width: 940px;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .cal__corner {
    grid-column: 1; grid-row: 1;
    position: sticky; left: 0; z-index: 3;
    background: var(--bg-elev);
    display: flex; align-items: flex-end; justify-content: flex-end;
    padding: 0 0.55rem 0.75rem 0;
  }
  .cal__corner span {
    font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 700; color: var(--ink-faint);
  }
  .cal__day {
    grid-row: 1;
    position: relative; overflow: clip;
    display: flex; flex-direction: column; gap: 0.12rem;
    padding: 0.7rem 0.8rem 0.75rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 9%, var(--bg-elev-2)), var(--bg-elev-2));
    border: 1px solid var(--line);
    border-bottom: 2px solid var(--accent);
    border-radius: 14px 14px 0 0;
  }
  .cal__num {
    position: absolute; top: -0.7rem; right: 0.2rem;
    font-family: var(--font-display); font-weight: 800; font-size: 3.4rem; line-height: 1;
    letter-spacing: -0.04em; color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--ink) 13%, transparent);
    pointer-events: none; user-select: none;
  }
  .cal__wd {
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    letter-spacing: -0.01em; color: var(--ink); line-height: 1.2;
  }
  .cal__short {
    font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em;
    font-weight: 700; color: var(--accent);
  }
  .cal__theme { margin-top: 0.3rem; font-size: 0.78rem; line-height: 1.4; color: var(--ink-soft); }
  /* The building that day sits in — the week splits after Thursday. */
  .cal__venue {
    margin-top: 0.4rem; display: flex; align-items: center; gap: 0.3rem;
    font-size: 0.66rem; letter-spacing: 0.05em; font-weight: 600;
    color: var(--ink-faint);
  }
  .cal__venue span { color: var(--accent-2); font-size: 0.55rem; }

  .cal__rule { grid-column: 1 / -1; border-top: 1px solid color-mix(in srgb, var(--ink) 5%, transparent); z-index: 0; pointer-events: none; }
  .cal__time {
    grid-column: 1;
    position: sticky; left: 0; z-index: 2;
    background: var(--bg-elev);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem; font-weight: 600; line-height: 1; color: var(--ink-soft);
    padding: 0.18rem 0.55rem 0 0;
    text-align: right;
  }

  /* Session cell — a real button; times live on the rail, details in the drawer.
     Kept quiet: a flat tint and a type-coloured left bar, no outline — the bar
     and the legend carry the colour coding. */
  .s {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; gap: 0.2rem;
    font: inherit; text-align: left; color: inherit; cursor: pointer;
    background: color-mix(in srgb, var(--sc) 9%, var(--bg-elev));
    border: 0;
    border-left: 3px solid var(--sc);
    border-radius: 8px;
    padding: 0.5rem 0.7rem;
    min-width: 0; overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, background-color 0.22s ease;
  }
  .s:hover, .s:focus-visible {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--sc) 16%, var(--bg-elev));
    box-shadow: 0 12px 28px color-mix(in srgb, var(--sc) 18%, transparent);
    z-index: 2;
  }
  .s__title { font-size: 0.82rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.008em; color: var(--ink); }

  /* Instructor footer (user, 2026-09-06) — every teaching cell names who is
     leading it. Pinned to the bottom of the cell by margin-top:auto so the
     names line up along the foot of a row of cells however tall each is, and
     separated from the title by a hairline in the session-type colour. The TA,
     where there is one, wraps onto its own quieter line. */
  .s__who {
    margin-top: auto; padding-top: 0.3rem;
    border-top: 1px solid color-mix(in srgb, var(--sc) 24%, transparent);
    display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.34rem;
    min-width: 0;
  }
  .s__dot { width: 0.36rem; height: 0.36rem; border-radius: 50%; background: var(--sc); flex-shrink: 0; }
  .s__name {
    font-size: 0.69rem; font-weight: 700; letter-spacing: 0.005em; color: var(--ink-soft);
    min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .s__ta {
    flex-basis: 100%; padding-left: 0.7rem;
    font-size: 0.62rem; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-faint);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .s:hover .s__name, .s:focus-visible .s__name { color: var(--ink); }

  /* Compact variants — 30-min slots get tighter padding and smaller type, and
     drop the hairline so title and instructor still both fit; the 15-min case
     centres a single ellipsised line so nothing ever crops mid-glyph. */
  .s--sm { padding: 0.28rem 0.65rem; gap: 0.08rem; }
  .s--sm .s__title { font-size: 0.72rem; line-height: 1.25; }
  .s--sm .s__who { padding-top: 0.12rem; border-top: 0; gap: 0 0.28rem; }
  .s--sm .s__name { font-size: 0.63rem; font-weight: 600; }
  .s--sm .s__dot { width: 0.3rem; height: 0.3rem; }
  .s--xs { padding: 0.1rem 0.6rem; justify-content: center; }
  .s--xs .s__title { font-size: 0.66rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .s--xs .s__who { display: none; }

  /* Staggered entrance — cells cascade in when the calendar's Reveal fires */
  .s { opacity: 0; }
  :global([data-reveal].is-in) .s { animation: cell-in 0.5s ease both; animation-delay: var(--d, 0ms); }
  @keyframes cell-in {
    from { opacity: 0; transform: translateY(12px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }

  /* Breaks — a centred label between two fading hairlines, quiet, not clickable */
  .s--brk {
    justify-content: center; cursor: default;
    background: transparent; border: 0; border-radius: 0;
  }
  .s--brk .s__title {
    flex-shrink: 0;
    font-size: 0.6rem; font-weight: 600; color: var(--ink-faint);
    text-transform: uppercase; letter-spacing: 0.2em;
  }
  .s--brk:hover { transform: none; box-shadow: none; background: transparent; }
  /* A break shared by a run of days — the columns it spans are set inline,
     since the week no longer breaks in step (see BREAK_SPANS). */
  .s--span {
    flex-direction: row; align-items: center; justify-content: center; text-align: center;
    gap: 1rem;
  }
  .s--span::before, .s--span::after {
    content: ""; flex: 1; height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 16%, transparent));
  }
  .s--span::after { background: linear-gradient(270deg, transparent, color-mix(in srgb, var(--ink) 16%, transparent)); }

  /* ── Session drawer ── */
  .sdrawer { position: fixed; inset: 0; z-index: 1000; }
  .sdrawer[hidden] { display: none; }
  .sdrawer__scrim { position: absolute; inset: 0; background: rgba(3, 6, 14, 0.58); opacity: 0; transition: opacity 0.3s ease; }
  .sdrawer.is-open .sdrawer__scrim { opacity: 1; }
  .sdrawer__panel {
    position: absolute; top: 0; right: 0; height: 100%;
    width: min(420px, 92vw); overflow-y: auto;
    background: var(--bg-elev); border-left: 1px solid var(--line);
    box-shadow: -20px 0 50px rgba(3, 6, 14, 0.4);
    padding: 3.4rem 1.6rem 1.8rem;
    transform: translateX(100%); transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sdrawer.is-open .sdrawer__panel { transform: translateX(0); }
  .sdrawer__close {
    position: absolute; top: 0.8rem; right: 0.8rem; z-index: 1;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    background: var(--bg-elev-2); border: 1px solid var(--line);
    color: var(--ink-soft); cursor: pointer; transition: color 0.2s, border-color 0.2s;
  }
