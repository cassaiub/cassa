    mode: "In person",
    people: [
      { name: "Andrew L. Miller", aff: "Assistant Professor, ICTP-AP · University of Chinese Academy of Sciences, Beijing", email: "andrew.miller.ligo@ucas.ac.cn", web: "https://andrew-l-miller.github.io", ext: true, photo: "/people/miller.webp" },
      { name: "Syed Ashraf Uddin", aff: "Associate Professor, IUB · Core Member, CASSA", email: "uddinsa@iub.edu.bd", web: withBase("/people/uddin"), ext: false, photo: "/people/uddin.webp" },
      { name: "Khan Muhammad Bin Asad", aff: "Assistant Professor, IUB · Core Member, CASSA", email: "kasad@iub.edu.bd", web: withBase("/people/asad"), ext: false, photo: "/people/asad.webp" },
      { name: "Colin J. Burke", aff: "NSF AAPF Postdoctoral Fellow, Department of Astronomy, Yale University · incoming Assistant Professor, University of North Texas", email: "colin.j.burke@yale.edu", web: "https://burke86.github.io", ext: true, photo: "/people/burke.webp" },
    ],
  },
  {
    mode: "Online",
    people: [
      { name: "Dipen Bhattacharya", aff: "Gamma-ray astronomer · University of California, Riverside and Moreno Valley College, California", email: "", web: "https://www.thedailystar.net/author/dipen-bhattacharya", ext: true, photo: "/people/dipen.webp" },
      { name: "Payaswini Saikia", aff: "Associate Research Scientist, Department of Astronomy and Physics, Yale University · Associate Member, CASSA", email: "payaswini.saikia@yale.edu", web: withBase("/people/saikia"), ext: false, photo: "/people/saikia.jpg" },
      { name: "Md Redyan Ahmed", aff: "PhD candidate, University of Sydney · Graduate Member, CASSA", email: "mahm0320@uni.sydney.edu.au", web: "https://sites.google.com/view/md-redyan-ahmed", ext: true, photo: "/people/ahmed.webp" },
    ],
  },
];

const COMMITTEES = [
  {
    title: "Scientific Organizing Committee",
    people: [
      { name: "Syed Ashraf Uddin", aff: "Core Member, CASSA · Independent University, Bangladesh", email: "uddinsa@iub.edu.bd" },
      { name: "Khan Muhammad Bin Asad", aff: "Core Member, CASSA · Independent University, Bangladesh", email: "kasad@iub.edu.bd" },
    ],
  },
  {
    title: "Local Organizing Committee",
    people: [
      { name: "Muhammad Jobair Hasan", aff: "Science Manager, CASSA", email: "jobair@iub.edu.bd" },
    ],
  },
];

/* The four key sciences — one per day, Mon–Thu, mirroring the final PDF's
   day themes and key topics (SA Uddin, 14 Jul 2026); the About section
   renders them as a rail beside the lede. */
const SCIENCES = [
  {
    day: "Day 1 · Mon Sep 7",
    t: "Foundations of time-domain astronomy",
    d: "Survey astronomy, alert brokers, compact-object physics and the principles of gravitational-wave detection.",
  },
  {
    day: "Day 2 · Tue Sep 8",
    t: "Gravitational waves & multi-messenger events",
    d: "Binary mergers, gravitational-wave data analysis, AGN variability, TART — the Transient Array Radio Telescope — gap transients and an introduction to exoplanet science.",
  },
  {
    day: "Day 3 · Wed Sep 9",
    t: "X-ray binaries, pulsars & exoplanet science",
    d: "X-ray binaries, tidal disruption events, pulsars in the time domain, exoplanet transit photometry, atmospheric characterization and ground-based follow-up strategies.",
  },
  {
    day: "Day 4 · Thu Sep 10",
    t: "Stellar transients & data-science methods",
    d: "Gamma-ray astronomy, core-collapse and thermonuclear supernovae, fast radio bursts, machine learning for transient classification and real-time pipelines.",
  },
];
---

<BaseLayout
  title="TDMMA Workshop 2026 — CASSA"
  description="CASSA's workshop on Time-Domain and Multi-Messenger Astronomy (TDMMA), 7–11 September 2026 at Independent University, Bangladesh — five days of lectures and hands-on tutorials on the changing sky: transients and surveys, gravitational waves, pulsars and fast radio bursts, exoplanet follow-up, and future facilities."
  current="/tdmma-2026"
>
  <AnimatedHero
    theme="merger"
    eyebrow="CASSA Workshop · 7–11 September 2026"
    title="Time-Domain & Multi-Messenger Astronomy"
    lede="Five days on the astronomy of a changing sky — the transient universe, and the messengers that carry it to us — at Independent University, Bangladesh."
  >
    <Fragment slot="meta">
      <span>Sept 7–11, 2026</span><span aria-hidden="true">·</span>
      <span>10:00 AM – 6:00 PM</span><span aria-hidden="true">·</span>
      <span>IUB · ACI Centre, Dhaka</span><span aria-hidden="true">·</span>
      <span>Lectures · Tutorials · Participant talks</span>
    </Fragment>
  </AnimatedHero>

  <!-- Page submenu: sits directly under the hero, then pins beneath the site
       nav for the rest of the page. Active section tracked on scroll. -->
  <nav class="subnav" aria-label="On this page">
    <div class="wrap subnav__row">
      <a class="subnav__brand" href="#" aria-label="TDMMA 2026 — back to top">
        TDMMA<span>2026</span>
      </a>
      <div class="subnav__links">
        {[
          ["about", "About"],
          ["programme", "Programme"],
          ["venue", "Venue"],
          ["speakers", "Speakers"],
          ["organisers", "Organisers"],
        ].map(([id, label]) => (
          <a class="subnav__link" href={`#${id}`} data-sec={id}>{label}</a>
        ))}
      </div>
      <a class="subnav__cta" href="#apply" data-sec="apply">Apply</a>
    </div>
  </nav>

  <!-- ── Round-two notice ─────────────────────────────────────────────────
       The first thing on the page after the hero (user, 2026-08-28), because
       the only action left is the handful of remaining full-fee seats. It
       jumps to #apply, the same anchor the subnav pill uses. Delete this whole
       section once 5 September passes — the countdown below it will already
       have flipped to "Applications have closed". -->
  <section class="alert" aria-labelledby="alert-h">
    <div class="wrap alert__row">
      <div class="alert__body">
        <p class="alert__tag"><span class="alert__dot" aria-hidden="true"></span>Round 1 closed · a few seats left</p>
        <h2 class="alert__h" id="alert-h">
          Full-fee registration stays open until <strong>5 September 2026</strong>
        </h2>
        <p class="alert__p">
          The first round of applications closed on 18 August and its
          participants have been selected. A few seats remain — open to
          <strong>university students</strong> and to
          <strong>fully paid participants only</strong>, at the full
          BDT&nbsp;5,000 fee, with no waiver.
        </p>
      </div>
      <a class="btn alert__btn" href="#apply">Apply &amp; pay <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <!-- ── Overview ─────────────────────────────────────────────────────── -->
  <!-- Sections alternate plain / elevated down the page: about · programme ·
       venue · speakers · organisers · apply. The programme keeps --elev so the
       calendar's sticky time rail can mask scrolling cells with the same
       background. -->
  <section class="section" id="about">
    <div class="wrap">
      <Reveal><p class="eyebrow">About the workshop</p></Reveal>
      <div class="about">
        <Reveal delay={70}>
          <!-- The lede was rewritten 2026-09-01 from SA Uddin's markup on a
               print of this page ("TDMMA Workshop 2026 — CASSA.pdf", 31 Aug
               2026): "still"→"static", the GW clause →"the ripples of
               spacetime", the closing clause →"multiple messengers providing
               crucial information…", a new capacity/infrastructure paragraph,
               "The workshop features local and foreign experts.", Uddin named
               convener, Saikia's line cut to the science, "participants
               leave"→"participants who complete this workshop will be", and
               "science"→"astrophysics". Momen struck out. Speaker order and
               the affiliation-free phrasing are the user's (2026-09-01):
               Miller · Uddin · Asad, then Burke · Saikia, each described by
               what they work on — titles, institutions and CASSA memberships
               belong to the speaker cards below and are not repeated here. -->
          <div class="about__lede">
            <Prose>
              <h2>One sky, many messengers</h2>
              <p>
                Astronomy no longer watches a static sky. Surveys like ZTF and
                the upcoming Rubin&nbsp;LSST catch the universe changing night
                by night, while gravitational-wave detectors listen to the
                ripples of spacetime. <strong>Time-Domain and Multi-Messenger
                Astronomy (TDMMA)</strong> is where those signals meet. The
                <strong>time domain is this workshop's centre of
                gravity</strong> — the changing sky, and everything we learn by
                watching it change — with multiple messengers providing crucial
                information to understand the astrophysics of these objects.
              </p>
              <p>
                With the growing demand to follow up these transients, CASSA is
                building the infrastructure to do it — manpower and observing
                facilities alike. This workshop aims to build a cohort of
                dedicated people who want to contribute to TDMMA.
              </p>
              <p>
                The workshop features local and foreign experts, some in the
                room and some joining online. In person, the visiting lecturer
                for the week is
                <strong>Dr.&nbsp;Andrew&nbsp;L. Miller</strong>, who searches
                gravitational-wave data for the signals of compact objects and
                of dark matter, and who comes to CASSA for the
                gravitational-wave portion of the programme. He is joined by
                <strong>Dr.&nbsp;Syed&nbsp;Ashraf&nbsp;Uddin</strong>, the
                convener of this workshop, whose expertise is Type&nbsp;Ia
                supernova cosmology and observational astronomy — he uses
                Type&nbsp;Ia supernovae as standard candles to probe dark energy
                and the Hubble tension;
                <strong>Dr.&nbsp;Khan&nbsp;Muhammad&nbsp;Bin&nbsp;Asad</strong>
                on the radio time domain — pulsars and fast radio bursts with
                MeerKAT and LOFAR; and
                <strong>Dr.&nbsp;Colin&nbsp;J. Burke</strong>, who hunts
                massive black holes in the variability of wide-field time-domain
                surveys.
              </p>
              <p>
                Joining online are
                <strong>Dr.&nbsp;Dipen&nbsp;Bhattacharya</strong>, a gamma-ray
                astronomer who has observed the high-energy sky with
                balloon-borne telescopes flown above the atmosphere, and a
                Bengali science-fiction writer;
                <strong>Dr.&nbsp;Payaswini&nbsp;Saikia</strong>, who studies
                accretion onto black holes and neutron stars and the jets they
                launch, from radio to X-ray; and
                <strong>Md&nbsp;Redyan&nbsp;Ahmed</strong>, a doctoral
                researcher in radio astronomy and galaxy evolution. Session
                speakers and further facilitators will be announced before the
                workshop.
              </p>
              <p>
                The goal is capacity building: participants who complete this
                workshop will be able to read a transient light curve, follow a
                gravitational-wave alert, and start research in time-domain
                astronomy and the multi-messenger astrophysics that grows out of
                it.
              </p>
            </Prose>
          </div>
        </Reveal>

        <Reveal delay={130}>
          <aside class="about__sci" aria-label="The four key sciences">
            <p class="about__sci-h">Four key sciences · four days</p>
            <ol class="sci">
              {SCIENCES.map((s) => (
                <li>
                  <span class="sci__day">{s.day}</span>
                  <span class="sci__t">{s.t}</span>
                  <p class="sci__d">{s.d}</p>
                </li>
              ))}
            </ol>
            <p class="sci__coda">
              The fifth day looks outward — Einstein Telescope, SKA and
              Rubin&nbsp;LSST — then crosses town to the ACI&nbsp;Centre for
              participant talks, the closing ceremony and the workshop dinner.
            </p>
          </aside>
        </Reveal>
      </div>

      <div class="facts">
        {[
          ["Dates", "September 7–11, 2026 (Mon–Fri)"],
          ["Hours", "10:00 AM – 6:00 PM · lunch 1:00–2:30 PM"],
          ["Venue", "Digital Classroom, IUB (days 1–4 and Friday morning) · ACI Centre, Tejgaon (Friday afternoon)"],
          ["Format", "Lectures · Hands-on tutorials · Participant talks"],
          ["Certificates", "Awarded at the closing ceremony"],
        ].map(([k, v], i) => (
          <Reveal delay={100 + i * 60}>
            <div class="fact"><span class="fact__k">{k}</span><span class="fact__v">{v}</span></div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The five days ────────────────────────────────────────────────── -->
  <!-- ── Programme calendar ───────────────────────────────────────────── -->
  <section class="section section--elev" id="programme">
    <div class="wrap">
      <Reveal><p class="eyebrow">Programme</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>The week, hour by hour</h2></Reveal>
      <Reveal delay={100}>
        <div class="legend" aria-hidden="true">
          {(["lec", "tut", "disc", "cer"] as const)
            .filter((k) => all.some((x) => x.k === k))
            .map((k) => <span class={`lg s--${k}`}>{typeLabel[k]}</span>)}
          <span class="lg s--brk">Break</span>
        </div>
      </Reveal>
    </div>

    <Reveal delay={140}>
      <div class="cal-scroll wrap" role="region" aria-label="Workshop programme calendar" tabindex="0">
        <div class="cal" style={`grid-template-rows:auto ${rowsTemplate}`}>
          {/* Day headers — each column is titled by its day's theme, so the
              calendar alone carries the arc of the week. */}
          <div class="cal__corner"><span>Time</span></div>
          {DAYS.map((d, i) => (
            <div class="cal__day">
              <span class="cal__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="cal__wd">{d.wd} · {d.date}</span>
              <span class="cal__short">{d.short}</span>
              <span class="cal__theme">{d.theme}</span>
              <span class="cal__venue"><span aria-hidden="true">◉</span> {d.venue}</span>
            </div>
          ))}

          {/* slot rules + per-slot time labels on the rail */}
          {BOUNDS.map((b, i) => (
            <Fragment>
              <div class="cal__rule" style={`grid-row:${row(b)}`} aria-hidden="true"></div>
              <div class="cal__time" style={`grid-row:${row(b)} / span ${boundSpan(i)}`}>{b}</div>
            </Fragment>
          ))}

          {/* breaks shared by a run of days — one band across those columns */}
          {BREAK_SPANS.map((sp) => (
            <div class="s s--brk s--span" style={`grid-column:${sp.from + 2} / ${sp.to + 3};grid-row:${row(sp.b.s)} / ${row(sp.b.e)}`}>
              <span class="s__title">{sp.b.t}</span>
            </div>
          ))}

          {/* sessions, one column per day — click opens the detail drawer */}
          {DAYS.map((d, di) =>
            d.sessions.filter((x) => !isSpannedBreak(x)).map((x, si) => (
              x.k === "brk" ? (
                /* a break only this day has (Mon's 11:15 coffee, Fri's early
                   lunch and its coach) — a quiet label, not a clickable cell */
                <div
                  class="s s--brk"
                  style={`grid-column:${di + 2};grid-row:${row(x.s)} / ${row(x.e)};--d:${di * 70 + si * 45}ms`}
                >
                  <span class="s__title">{x.t}</span>
                </div>
              ) : (
              <button
                type="button"
                class:list={["s", `s--${x.k}`, { "s--sm": mins(x.e) - mins(x.s) <= 30, "s--xs": mins(x.e) - mins(x.s) <= 15 }]}
                style={`grid-column:${di + 2};grid-row:${row(x.s)} / ${row(x.e)};--d:${di * 70 + si * 45}ms`}
                data-session
                data-title={x.t}
                data-day={`${d.wd} · ${d.date} — ${d.theme} · ${venueOf(d, x)}`}
                data-time={`${x.s}–${x.e}`}
                data-type={typeLabel[x.k]}
                data-role={tbdRole[x.k] ?? ""}
                data-who={x.who ?? ""}
                data-ta={x.ta ?? ""}
                data-topics={(x.d ?? []).join("¦")}
                data-link={x.link ? withBase(x.link.href) : ""}
                data-link-label={x.link?.label ?? ""}
                aria-haspopup="dialog"
              >
                <span class="s__title">{x.t}</span>
                {x.who && (
                  <span class="s__who">
                    <span class="s__dot" aria-hidden="true"></span>
                    <span class="s__name">{x.who}</span>
                    {x.ta && <span class="s__ta">TA {x.ta}</span>}
                  </span>
                )}
              </button>
              )
            ))
          )}
        </div>
      </div>
    </Reveal>

    <div class="wrap">
      <div class="stats">
        {[
          ["5", "days"],
          [String(nSes), "sessions"],
          [String(nLec), "lectures"],
          [String(nTut), "hands-on tutorials"],
        ].map(([n, l], i) => (
          <Reveal delay={150 + i * 60}>
            <div class="stat"><span class="stat__n">{n}</span><span class="stat__l">{l}</span></div>
          </Reveal>
        ))}
      </div>
      <Reveal delay={160}>
        <p class="cal-note">
          Click a session for details; on phones, swipe the calendar sideways.
          Friday lunches early and moves across town: a coach leaves IUB at
          2:00&nbsp;PM for the ACI Centre, and the day closes with the workshop
          dinner at 7:00&nbsp;PM.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- Session-detail drawer (opened by any [data-session] cell) -->
  <div id="session-drawer" class="sdrawer" hidden>
    <div class="sdrawer__scrim" data-sdrawer-close></div>
    <aside class="sdrawer__panel" role="dialog" aria-modal="true" aria-label="Session details" tabindex="-1">
      <button type="button" class="sdrawer__close" data-sdrawer-close aria-label="Close session details">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <p class="sdrawer__type" data-sd="type"></p>
      <h3 class="sdrawer__title" data-sd="title"></h3>
      <dl class="sdrawer__meta">
        <div><dt>Day</dt><dd data-sd="day"></dd></div>
        <div><dt>Time</dt><dd data-sd="time"></dd></div>
        <div data-sd-role-row><dt data-sd="role">Instructor</dt><dd data-sd="who">To be announced</dd></div>
        <div data-sd-ta-row hidden><dt>Teaching assistant</dt><dd data-sd="ta"></dd></div>
      </dl>
      <div class="sdrawer__topics">
        <p class="sdrawer__topics-h">In this session</p>
        <ul data-sd-topics></ul>
      </div>
      <a class="sdrawer__link" data-sd-link hidden>→ <span data-sd="linkLabel"></span></a>
      <button type="button" class="sdrawer__pdf" disabled>
        Session materials (PDF) — available after the workshop
      </button>
    </aside>
  </div>

  <!-- ── Venue ────────────────────────────────────────────────────────── -->
  <section class="section" id="venue">
    <div class="wrap">
      <Reveal><p class="eyebrow">Venue & logistics</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>Where the week happens</h2>
          <p>
            The workshop runs across <strong>two venues</strong>. The first four
            days — and Friday morning — are held in the
            <strong>Digital Classroom</strong> at
            <strong>Independent University, Bangladesh</strong>, home of CASSA.
            On Friday the workshop lunches early and moves across town: a coach
            leaves IUB at 2:00 PM for the <strong>ACI Centre</strong> in
            Tejgaon, where the afternoon runs from 3:00 PM. Sessions run 10:00 AM
            to 6:00 PM with a 90-minute lunch break, and Friday closes with the
            workshop dinner at 7:00 PM. The week falls in the semester break,
            and participants completing the workshop receive certificates.
          </p>
        </Prose>
      </Reveal>
      <div class="vn">
        {VENUES.map((v, i) => (
          <Reveal delay={120 + i * 70}>
            <article class="vn__card">
              <p class="vn__days">{v.days}</p>
              <h3 class="vn__name">{v.name}</h3>
              <p class="vn__addr">{v.addr}</p>
              <p class="vn__note">{v.note}</p>
              <a class="vn__map" href={v.map} target="_blank" rel="noopener">
                Open in Google&nbsp;Maps <span aria-hidden="true">↗</span>
              </a>
            </article>
          </Reveal>
        ))}
      </div>
      <Reveal delay={270}>
        <p class="vn__spon">
          <span class="vn__spon-k">Sponsor</span>
          <span>
            <strong>ACI</strong> is kindly sponsoring the final day of the
            workshop at the ACI Centre, and the workshop dinner with special
            guests.
          </span>
        </p>
      </Reveal>
    </div>
  </section>

  <!-- ── Speakers ─────────────────────────────────────────────────────── -->
  <section class="section section--elev" id="speakers">
    <div class="wrap">
      <Reveal><p class="eyebrow">Resource people</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Invited speakers</h2></Reveal>
      {SPEAKER_GROUPS.map((g) => (
        <div class="spk-group">
          <Reveal delay={80}><h3 class="spk-group__h">{g.mode}</h3></Reveal>
          <div class="spk">
            {g.people.map((p, i) => (
              <Reveal delay={100 + i * 50}>
                <article class="spk__card">
                  <img class="spk__photo" src={withBase(p.photo)} alt={p.name} width="480" height="480" loading="lazy" />
                  <div class="spk__body">
                    <h4 class="spk__name">
                      <a
                        href={p.web}
                        target={p.ext ? "_blank" : undefined}
                        rel={p.ext ? "noopener" : undefined}
                      >{p.name}{p.ext && <span class="spk__ext" aria-hidden="true"> ↗</span>}</a>
                    </h4>
                    <p class="spk__aff">{p.aff}</p>
                    {p.email && <a class="spk__mail" href={`mailto:${p.email}`}>{p.email}</a>}
                  </div>
                </article>
              </Reveal>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Organisers ───────────────────────────────────────────────────── -->
  <section class="section" id="organisers">
    <div class="wrap">
      <Reveal><p class="eyebrow">Organisation</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Organisers</h2></Reveal>
      <div class="orgs">
        {COMMITTEES.map((g, gi) => (
          <Reveal delay={100 + gi * 60}>
            <div class="org">
              <h3 class="org__title">{g.title}</h3>
              <ul class="org__list">
                {g.people.map((p) => (
                  <li>
                    <span class="org__name">{p.name}</span>
                    <span class="org__aff">{p.aff}</span>
                    {p.email && <a class="org__mail" href={`mailto:${p.email}`}>{p.email}</a>}
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Registration ─────────────────────────────────────────────────── -->
  <section class="section section--elev" id="apply">
    <div class="wrap cta">
      <Reveal><p class="eyebrow">Take part</p></Reveal>
      <Reveal delay={60}><h2 style={h2}>Applications & registration</h2></Reveal>
      <Reveal delay={100}>
        <p class="cta__p">
          <strong>The first round is done.</strong> Applications closed on
          <strong>18 August 2026</strong> and the selected participants were
          announced on 21 August. What is left is a small block of seats, held
          open until <strong>5 September 2026</strong> for
          <strong>university students from Bangladesh and beyond</strong>.
        </p>
        <p class="cta__p">
          These remaining seats are for <strong>fully paid participants
          only</strong>: the <strong>BDT&nbsp;5,000</strong> registration fee is
          paid online with the application, and a seat is confirmed once that
          payment clears. The <strong>20% and 50%</strong> merit- and need-based
          waivers belonged to the first round and are no longer available.
        </p>
      </Reveal>
      <Reveal delay={115}>
        <div class="cta__count">
          <Countdown client:idle closesAt={APPLY_CLOSES} liveUrl={TDMMA_FORM_META_URL} />
        </div>
      </Reveal>
      <Reveal delay={130}>
        <div class="dl">
          {DEADLINES.map(([k, v]) => (
            <div class="dl__item">
              <span class="dl__k">{k}</span>
              <span class="dl__v">{v}</span>
            </div>
          ))}
        </div>
      </Reveal>
      <Reveal delay={160}>
