/* Calendar geometry: 10:00 to the last thing that happens all week, in 15-min
   grid rows (row 1 = day headers). The end is derived rather than fixed at
   18:00, because Friday's dinner sits at 19:00 (user, 2026-09-06). */
const mins = (hm: string) => { const [h, m] = hm.split(":").map(Number); return h * 60 + m; };
const row = (hm: string) => (mins(hm) - 600) / 15 + 2;

/* A break that several adjacent days share renders ONCE as a band across just
   those columns, instead of five identical cells. Since 2026-09-06 the week no
   longer breaks in step — Friday lunches early at 12:30 and has no afternoon
   coffee — so the span is computed per break over the run of days that carry
   it, rather than assuming all five. A break only one day has (Monday's 11:15
   coffee, Friday's early lunch and its coach to ACI) falls through to the
   normal per-day cell path below. */
const brKey = (x: Session) => `${x.s}|${x.e}|${x.t}`;
const BREAK_SPANS = [...new Map(
  DAYS.flatMap((d) => d.sessions).filter((x) => x.k === "brk").map((x) => [brKey(x), x] as const),
).values()]
  .map((b) => {
    const on = DAYS.map((d, i) => (d.sessions.some((y) => brKey(y) === brKey(b)) ? i : -1)).filter((i) => i >= 0);
    return { b, from: on[0], to: on[on.length - 1], n: on.length };
  })
  .filter((x) => x.n > 1 && x.to - x.from + 1 === x.n);
const isSpannedBreak = (x: Session) => x.k === "brk" && BREAK_SPANS.some((sp) => brKey(sp.b) === brKey(x));

const all = DAYS.flatMap((d) => d.sessions);
const nSes = all.filter((x) => x.k !== "brk").length;
const nLec = all.filter((x) => x.k === "lec").length;
const nTut = all.filter((x) => x.k === "tut").length;

const END = all.map((x) => x.e).reduce((a, b) => (mins(b) > mins(a) ? b : a));
const NROWS = (mins(END) - 600) / 15;

/* The time rail carries one label per slot boundary — every distinct start AND
   end, each spanning down to the next boundary. Ends matter because a few are
   nobody's start: 18:00, where Mon–Thu finish, and 20:00 at the foot. */
const BOUNDS = [...new Set(all.flatMap((x) => [x.s, x.e]))].sort((a, b) => mins(a) - mins(b));
const boundSpan = (i: number) => (i === BOUNDS.length - 1 ? 1 : (mins(BOUNDS[i + 1]) - mins(BOUNDS[i])) / 15);

/* Lunch is indicative, not proportional: a 15-min row in which NO day is
   teaching gets a compressed height, so the long midday band renders as a slim
   strip. Stated as "nobody is in session" rather than "this is lunch" because
   the five days no longer break together — Friday lunches 12:30–14:00 and then
   travels 14:00–15:00 while the others are still at lunch, and only the rows
   every day has free may be squeezed. */
const idle = (m: number) =>
  !DAYS.some((d) => d.sessions.some((x) => x.k !== "brk" && mins(x.s) <= m && mins(x.e) > m));
const rowsTemplate = Array.from({ length: NROWS }, (_, i) =>
  idle(600 + i * 15) ? "var(--unit-lunch)" : "var(--unit)",
).join(" ");

/* Instructors now ride in the calendar cells as well as the drawer (user,
