---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/immersive/AnimatedHero.astro";
import AnimatedBand from "../components/immersive/AnimatedBand.astro";
import Reveal from "../components/immersive/Reveal.astro";
import Prose from "../components/immersive/Prose.astro";
import { getCollection } from "astro:content";
import { withBase } from "../data/site-nav.ts";
import { OPP_CATEGORIES, pathForKind } from "../data/opportunities.ts";

const all = await getCollection("opportunities", ({ data }) => data.status !== "draft");
const now = new Date();
const isOpen = (o: (typeof all)[number]) => !o.data.outcome && (!o.data.deadline || o.data.deadline >= now);
const openCount = (kind: string) => all.filter((o) => o.data.kind === kind && isOpen(o)).length;
---

<BaseLayout
  title="Opportunities — CASSA"
  description="Three ways to join the Center for Astronomy, Space Science and Astrophysics (CASSA), IUB — vacancies, research internships and volunteerships."
  current="/opportunities"
>
  <AnimatedHero
    theme="cosmic"
    eyebrow="Opportunities"
    title="Join CASSA"
    lede="Research assistantships, internships and volunteer roles at the Center for Astronomy, Space Science and Astrophysics — find the route that fits you."
  />

  <!-- Three routes (elevated, right after the dark hero — rule 19) -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Three ways in</p></Reveal>
      <Reveal delay={60}>
        <Prose>
          <h2>Find your route into the Center</h2>
          <p>
            CASSA grows through the people who join it — as paid researchers and staff, as student
            interns learning the craft, and as volunteers who bring astronomy to the public. Each route
            has its own page below, with how it works and every open and past circular.
          </p>
        </Prose>
      </Reveal>

      <div class="opcards">
        {OPP_CATEGORIES.map((cat, i) => {
          const n = openCount(cat.kind);
          return (
            <Reveal class="opcards__wrap" delay={100 + i * 60}>
              <a class="opcard" href={withBase(pathForKind(cat.kind))}>
                <span class="opcard__name">{cat.label}</span>
                <span class="opcard__blurb">{cat.blurb}</span>
                <span class:list={["opcard__status", { "opcard__status--live": n > 0 }]}>
                  {n > 0 ? `${n} open now` : "No open roles right now"}
                </span>
                <span class="opcard__more">Explore <span aria-hidden="true">→</span></span>
              </a>
            </Reveal>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Closing band -->
  <AnimatedBand theme="lensing">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Not sure where you fit?</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:26ch">Meet the people already here, or write to us</h2>
    </Reveal>
  </AnimatedBand>

  <section class="section section--elev">
    <div class="wrap" style="display:flex;gap:1rem;flex-wrap:wrap">
      <a class="btn" href={withBase('/people')}>The CASSA people</a>
      <a class="btn" href={withBase('/research')}>Research areas</a>
      <a class="btn" href="mailto:cassa@iub.edu.bd">cassa@iub.edu.bd</a>
    </div>
  </section>
</BaseLayout>

<style>
  .opcards { display:grid; grid-template-columns:repeat(3, 1fr); gap:1rem; margin-top:2.2rem; }
  @media (max-width: 860px) { .opcards { grid-template-columns:1fr; } }

  .opcard {
    display:flex; flex-direction:column; gap:.45rem; height:100%;
    background:var(--bg-elev-2); border:1px solid var(--line); border-left:3px solid var(--accent);
    border-radius:14px; padding:1.3rem 1.4rem; transition:border-color .2s, transform .2s;
  }
  .opcard:hover { border-color:color-mix(in srgb,var(--accent) 45%,transparent); transform:translateY(-3px); }
  [data-theme="light"] .opcard { box-shadow:0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }

  .opcard__name { font-size:1.3rem; font-weight:700; color:var(--ink); line-height:1.25; }
  .opcard__blurb { font-size:.92rem; color:var(--ink-soft); line-height:1.6; flex-grow:1; }
  .opcard__status {
    font-size:.62rem; letter-spacing:.14em; text-transform:uppercase; font-weight:700;
    color:var(--ink-faint); margin-top:.3rem;
  }
  .opcard__status--live { color:var(--accent); }
  .opcard__more { font-size:.84rem; font-weight:600; color:var(--accent); margin-top:.2rem; }
  .opcard:hover .opcard__more { opacity:.8; }
</style>
