---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import AnimatedBand from "../../components/immersive/AnimatedBand.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import Prose from "../../components/immersive/Prose.astro";

// Durbin Management Team — name · CASSA role · Durbin responsibility
// (Constitution cl. 33 / Appendix F; via knb/outreach/summary.md). Pay/hours omitted.
const team = [
  { name: "Khan Muhammad Bin Asad", role: "Director", resp: "Evaluates team proposals and initiatives and determines final outcomes." },
  { name: "Muhammad Jobair Hasan", role: "Manager (Science)", resp: "Oversees programme funds and their punctual disbursement, under the Director's authorization." },
  { name: "Farzana Akter Lima", role: "Project Manager", resp: "Activity and partnership planning, volunteer communications, expenditure tracking, and reporting to IUB and the funder." },
  { name: "Ahmad Al-Imtiaz", role: "Graduate RA", resp: "Assesses scientific content and coordinates publication across platforms." },
  { name: "Farhana Ferdous", role: "Undergraduate Research Intern", resp: "IR/VR content, English-language anchoring at events, school outreach, and English web text." },
  { name: "Ashratul Zannati Purnota", role: "Outreach Ambassador", resp: "Maintains the Durbin webpages, public-event logistics, and volunteer assignments." },
  { name: "Md Shahadat Hossain Shahal", role: "Postbac RA", resp: "Maintenance and imaging on the 8-inch telescope, and the image-processing pipeline for small telescopes." },
];
---

<BaseLayout
  title="The Durbin Manual — CASSA"
  description="How CASSA's volunteer astronomy-outreach programme, Durbin, is governed — management, the volunteer model, and safeguarding — under the CASSA Constitution (cl. 33, Appendices E & F)."
  current="/outreach"
>
  <AnimatedHero
    theme="galaxy"
    eyebrow="Outreach · Durbin"
    title="The Durbin Manual"
    lede="How CASSA's volunteer astronomy-outreach programme is run — governance, the volunteer model, and safeguarding, under the CASSA Constitution."
  />

  <!-- Purpose -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Purpose</p></Reveal>
      <Reveal delay={60}><h2 class="dm-h2">A volunteer programme, by design</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            <strong>Durbin</strong> — Bangla for binoculars or a telescope — is CASSA's public
            astronomy-outreach programme: astrophotography, immersive science communication, school
            visits, and public Astronomy Nights. It was founded on <strong>9 March 2023</strong> by
            Dr. Lamiya Mowla.
          </p>
          <p>
            The Constitution makes one principle binding: Durbin <em>"shall always remain an outreach
            program conducted by volunteers under the supervision of the Directors of CASSA"</em>
            (cl. 33.1). Changes to its funding or affiliation are managed by the Durbin Management
            Team in consultation with the Directors.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- Governance -->
  <section class="section">
    <div class="wrap">
      <Reveal><p class="eyebrow">Governance</p></Reveal>
      <Reveal delay={60}><h2 class="dm-h2">The Durbin Management Team</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            Durbin operates under the <strong>Durbin Management Team (DMT)</strong>, within the
            Center's outreach mission (Constitution cl. 33; Outreach Manual, Appendix F). Scientific
            supervision is provided by <strong>Dr. Lamiya Mowla</strong>, <strong>Dr. Syed Ashraf
            Uddin</strong>, and <strong>Syeda Lammim Ahad</strong>.
          </p>
        </Prose>
      </Reveal>

      <div class="dm-team">
        {team.map((m, i) => (
          <div class="dm-member" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 50}ms`}>
            <p class="dm-member__name">{m.name}</p>
            <p class="dm-member__role">{m.role}</p>
            <p class="dm-member__resp">{m.resp}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Volunteer model -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Taking part</p></Reveal>
      <Reveal delay={60}><h2 class="dm-h2">The volunteer model</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            Volunteers form <strong>fixed teams</strong> for each programme cycle — once a team is
            constituted, members are not transferred between teams. Across a cycle, teams:
          </p>
          <ul>
            <li>develop lasting materials — text, imagery, audiovisual and immersive — from Durbin astrophotography;</li>
            <li>operate telescopes at Durbin events and Astronomy Nights, and run remote imaging camps;</li>
            <li>produce physical prints and visual-art installations of deep-sky imagery.</li>
          </ul>
          <p>
            CASSA covers pre-authorized costs. Volunteers who complete a cycle receive a
            <strong> Letter of Experience</strong>, and winning teams at public exhibitions receive prizes.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- Safeguarding band -->
  <AnimatedBand theme="cosmic">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Safeguarding</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:26ch">Everyone is safe at a Durbin event</h2>
    </Reveal>
  </AnimatedBand>

  <!-- Safeguarding -->
  <section class="section section--elev-2">
    <div class="wrap">
      <Reveal><p class="eyebrow">Appendix E</p></Reveal>
      <Reveal delay={60}><h2 class="dm-h2">A zero-tolerance-to-inaction commitment</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            All Durbin activity with minors is governed by the <strong>CASSA Safeguarding Policy</strong>
            (Constitution Appendix E), which takes a zero-tolerance-to-inaction stance on abuse and on
            sexual exploitation, abuse and harassment. Safeguarding is overseen by a <strong>Central
            Safeguarding Focal Point (CSFP)</strong> — currently the Research Affiliate Rafia Rokaiya
            Hossain — and a <strong>Project Safeguarding Focal Point (PSFP)</strong> for the programme.
          </p>
          <p>Core rules at every Durbin and Astronomy Night activity:</p>
          <ul>
            <li>at least <strong>two CASSA representatives</strong> are present at every evening or rooftop event;</li>
            <li>no one is ever alone with a child in a closed or unlit space — activities run in pairs or groups;</li>
            <li>photography of a minor requires prior <strong>written consent</strong> from the parent and the child;</li>
            <li>all communication uses official CASSA/IUB channels;</li>
            <li>anyone working with children is vetted (reference checks and a boundary interview).</li>
          </ul>
          <p>
            Concerns can be raised with the PSFP or CSFP, or directly with the IUB Gender &amp; Sexual
            Harassment Committee (<a href="mailto:safeplace@iub.edu.bd">safeplace@iub.edu.bd</a>) or the
            Proctorial Committee (<a href="mailto:proctor@iub.edu.bd">proctor@iub.edu.bd</a>). The
            approach is survivor-centred, and severe cases are reported to IUB within 24 hours. The
            policy aligns with IUB policy and Bangladeshi law, including the Children Act 2013.
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- Funding & governing document -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Funding &amp; governance</p></Reveal>
      <Reveal delay={60}><h2 class="dm-h2">Support, and the governing document</h2></Reveal>
      <Reveal delay={100}>
        <Prose>
          <p>
            Durbin was seeded by the University of Toronto's <strong>Dunlap Institute for Astronomy &amp;
            Astrophysics</strong>, and from May 2026 is supported by a <strong>British Council
            Bangladesh</strong> grant through Women of the World. Under the Constitution, Durbin is
            transitioned or wound down only on dissolution of the Center (cl. 28).
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .dm-h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); letter-spacing: -.015em; margin: .3rem 0 0; color: var(--ink); }

  .dm-team { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; margin-top: 2.2rem; }
  @media (max-width: 720px) { .dm-team { grid-template-columns: 1fr; } }
  .dm-member {
    background: var(--bg-elev-2); border: 1px solid var(--line); border-left: 3px solid var(--accent);
    border-radius: 14px; padding: 1.2rem 1.35rem;
  }
  [data-theme="light"] .dm-member { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }
  .dm-member__name { color: var(--ink); font-weight: 700; font-size: 1.05rem; margin: 0; line-height: 1.3; }
  .dm-member__role { color: var(--accent); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; margin: .35rem 0 0; }
  .dm-member__resp { color: var(--ink-soft); font-size: .9rem; line-height: 1.6; margin: .6rem 0 0; }
</style>
