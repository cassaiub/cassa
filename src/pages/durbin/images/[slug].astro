---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ImmersiveHero from "../../../components/immersive/ImmersiveHero.astro";
import ImmersiveHeroSlider from "../../../components/immersive/ImmersiveHeroSlider.astro";
import Prose from "../../../components/immersive/Prose.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../../data/site-nav.ts";

export async function getStaticPaths() {
  const items = await getCollection("astrophotography", ({ data }) => data.status !== "draft");
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const objType = d.categories.find((c) => !["Durbin", "Featured"].includes(c)) ?? d.categories[0];
const eyebrow = `Astrophotography${objType ? ` · ${objType}` : ""}`;

// The Astrophotographic ("how it was captured") table, built from one capture
// block. Each slide carries its own, so a multi-author entry attributes the
// right capture details to the photographer whose image is showing.
type Capture = NonNullable<typeof d.astrophoto>;
const photoRowsOf = (a: Capture): [string, string | undefined][] =>
  (
    [
      ["Photographer", a.photographer],
      ["Observing location", a.location],
      ["Observation date", a.date],
      ["Exposure", a.exposure],
      ["Telescope", a.telescope],
      ["Camera", a.camera],
      ["Field of view", a.fov],
      ["Image processing", a.processing],
      ["Processing method", a.processingMethod],
    ] as [string, string | undefined][]
  ).filter(([, v]) => v);

// The person shown on a slide (no verb) — for dot labels and table captions.
const nameOf = (a: Capture, fallback?: string) =>
  a.photographer ?? a.processing ?? fallback ?? undefined;
// The full attribution line shown in the hero — distinguishes who captured vs
// who only processed, so a processing-only contributor isn't mislabelled.
const attributionOf = (a: Capture, fallback?: string): string | undefined => {
  const cap = a.photographer;
  const proc = a.processing;
  if (cap && proc) return cap === proc ? `Captured & processed by ${cap}` : `Captured by ${cap} · processed by ${proc}`;
  if (cap) return `Captured by ${cap}`;
  if (proc) return `Processed by ${proc}`;
  return fallback ? `By ${fallback}` : undefined;
};

// Slides: the primary image first, then any additional captures of the same
// object. With 2+ the hero becomes a slider and the capture table swaps per slide.
const buildSlide = (image: typeof d.image, alt: string, a: Capture, fallback?: string) => ({
  image,
  alt,
  name: nameOf(a, fallback),
  attribution: attributionOf(a, fallback),
  photo: photoRowsOf(a),
});
const slides = [
  buildSlide(d.image, d.imageAlt ?? d.title, d.astrophoto ?? {}, d.credit ?? undefined),
  ...(d.slides ?? []).map((s) =>
    buildSlide(s.image, s.alt ?? d.imageAlt ?? d.title, s.astrophoto ?? {}, s.credit ?? undefined),
  ),
];
const multi = slides.length > 1;

const px = d.astrophysics ?? {};
const physRows: [string, string | undefined][] = [
  ["Object type", px.objectType],
  ["Constellation", px.constellation],
  ["Distance", px.distance],
  ["Angular size", px.angularSize],
  ["Physical size", px.physicalSize],
  ["Apparent magnitude", px.magnitude],
];
const phys = physRows.filter(([, v]) => v);
const bnParas = (d.essayBn ?? "").split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
---

<BaseLayout
  title={`${d.title} — CASSA Astrophotography`}
  description={d.caption ?? `${d.title}${objType ? ` — ${objType}` : ""}, imaged by CASSA's Durbin programme.`}
  current="/outreach"
  langToggle={bnParas.length > 0}
>
  {multi ? (
    <ImmersiveHeroSlider slides={slides} eyebrow={eyebrow} title={d.title} />
  ) : (
    <ImmersiveHero
      image={d.image}
      alt={d.imageAlt ?? d.title}
      eyebrow={eyebrow}
      title={d.catalog ? `${d.title}` : d.title}
      lede={d.caption}
      kenburns={false}
    />
  )}

  <!-- Essays (elevated section right after the hero) -->
  <section class="section section--elev">
    <div class="wrap gd">
      <div class="gd-essay" data-reveal data-lang="en">
        <p class="eyebrow">The object{d.catalog ? ` · ${d.catalog}` : ""}</p>
        <Prose><Content /></Prose>
      </div>

      {bnParas.length > 0 && (
        <div class="gd-essay" data-lang="bn" lang="bn">
          <p class="eyebrow">বাংলায়</p>
          <div class="prose-cassa">
            {bnParas.map((p) => <p>{p}</p>)}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Info tables -->
  <section class="section">
    <div class="wrap">
      <div class="gd-info">
        {/* One Astrophotographic card per slide; only the active slide's shows.
            The slider's `astro-hslide` event toggles them (see script below). */}
        {slides.map((s, i) => (
          s.photo.length > 0 && (
            <dl
              class="infocard"
              data-reveal={i === 0 ? true : undefined}
              data-photo-card={i}
              hidden={i !== 0}
            >
              <p class="infocard__cap">
                Astrophotographic information{multi && s.name ? ` · ${s.name}` : ""}
              </p>
              {s.photo.map(([k, v]) => (
                <div class="inforow"><dt>{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          )
        ))}
        {phys.length > 0 && (
          <dl class="infocard" data-reveal style="--reveal-delay:90ms">
            <p class="infocard__cap">Astrophysical information</p>
            {phys.map(([k, v]) => (
              <div class="inforow"><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        )}
      </div>
      <p class="gd-back"><a href={withBase("/durbin/images")}>← All objects</a></p>
    </div>
  </section>

  {multi && (
    <script>
      // Swap the Astrophotographic card to match the active slider image.
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-photo-card]"));
      document.addEventListener("astro-hslide", (e) => {
        const i = (e as CustomEvent<{ index: number }>).detail.index;
        cards.forEach((c) => { c.hidden = Number(c.dataset.photoCard) !== i; });
      });
    </script>
  )}
</BaseLayout>

<style>
  .gd { display: flex; flex-direction: column; gap: 2.6rem; }
  .gd-essay { max-width: 70ch; }

  .gd-info { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  @media (max-width: 760px) { .gd-info { grid-template-columns: 1fr; } }

  .infocard {
    margin: 0; background: var(--bg-elev-2); border: 1px solid var(--line);
    border-radius: 16px; padding: 1.5rem 1.7rem;
  }
  [data-theme="light"] .infocard { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }
  .infocard__cap {
    font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700;
    color: var(--accent); margin: 0 0 1rem; padding-bottom: .8rem; border-bottom: 1px solid var(--line);
  }
  .inforow {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr); gap: 1rem;
    padding: .65rem 0; border-bottom: 1px solid var(--line); align-items: baseline;
  }
  .inforow:last-child { border-bottom: 0; padding-bottom: 0; }
  .inforow dt { color: var(--ink-faint); font-size: .82rem; }
  .inforow dd { margin: 0; color: var(--ink); font-weight: 500; line-height: 1.5; }
  @media (max-width: 420px) { .inforow { grid-template-columns: 1fr; gap: .15rem; } }

  .gd-back { margin-top: 2.4rem; }
  .gd-back a { color: var(--accent); }
  .gd-back a:hover { opacity: .75; }
</style>
