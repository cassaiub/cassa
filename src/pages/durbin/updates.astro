---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import AnimatedBand from "../../components/immersive/AnimatedBand.astro";
import Reveal from "../../components/immersive/Reveal.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { withBase } from "../../data/site-nav.ts";

// Durbin Updates — Durbin-scoped news PLUS Durbin-scoped events, merged into one
// feed. New updates file themselves here automatically: a src/content/news/*.md
// or src/content/events/*.md entry with `category: "Durbin"` (or `durbin: true`)
// appears here, and stays in its own /news or /events listing too.
type Item = {
  href: string;
  date: Date;
  title: string;
  summary?: string;
  category: string;
  lang: string;
  hero?: ImageMetadata;
  heroAlt?: string;
};

const isDurbin = (data: { status?: string; category?: string; durbin?: boolean }) =>
  data.status !== "draft" && (data.category === "Durbin" || data.durbin === true);

const newsItems: Item[] = (await getCollection("news", ({ data }) => isDurbin(data))).map((p) => ({
  href: `/news/${p.id}`,
  date: p.data.date,
  title: p.data.title,
  summary: p.data.summary,
  category: p.data.category ?? "Durbin",
  lang: p.data.lang,
  hero: p.data.hero,
  heroAlt: p.data.heroAlt,
}));

const eventItems: Item[] = (await getCollection("events", ({ data }) => isDurbin(data))).map((e) => ({
  href: `/events/${e.id}`,
  date: e.data.start,
  title: e.data.title,
  summary: e.data.summary,
  category: e.data.category ?? "Durbin",
  lang: e.data.lang,
  hero: e.data.hero,
  heroAlt: e.data.heroAlt,
}));

const all = [...newsItems, ...eventItems].sort((a, b) => +b.date - +a.date);

const TZ = "Asia/Dhaka";
const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: TZ, day: "numeric", month: "short", year: "numeric" }).format(d);
const yearOf = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: TZ, year: "numeric" }).format(d);

const byYear = new Map<string, Item[]>();
for (const p of all) {
  const y = yearOf(p.date);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Durbin Updates — CASSA"
  description="Dispatches from Durbin, CASSA's volunteer astronomy-outreach programme — workshops, school visits, public astronomy nights, and calls for volunteers."
  current="/outreach"
>
  <AnimatedHero
    theme="galaxy"
    eyebrow="Outreach · Durbin"
    title="Durbin Updates"
    lede="Dispatches from Durbin — workshops, school visits, public astronomy nights, and open calls — as the programme brings the sky to people across Bangladesh."
  />

  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">The feed</p></Reveal>
      <Reveal delay={60}><h2 class="nf-h2">Latest from Durbin</h2></Reveal>

      {all.length === 0 ? (
        <p class="nf-empty">Durbin updates will appear here once posts are published.</p>
      ) : (
        years.map((yr) => (
          <div class="nfyear" data-year={yr}>
            <Reveal><h3 class="nfyear__h">{yr}</h3></Reveal>
            <ol class="nflist">
              {byYear.get(yr)!.map((p, i) => (
                <li>
                  <a
                    class:list={["nfrow", "nf-news", { "nfrow--media": p.hero }]}
                    href={withBase(p.href)}
                    data-reveal
                    style={`--reveal-delay:${Math.min(i, 6) * 40}ms`}
                  >
                    {p.hero && (
                      <span class="nfrow__thumb">
                        <Image src={p.hero} alt={p.heroAlt ?? ""} width={240} loading="lazy" />
                      </span>
                    )}
                    <span class="nfrow__body">
                      <span class="nfrow__meta">
                        <span class="nftag nf-news">{p.category}</span>
                        {p.lang === "bn" && <span class="nftag nftag--bn" lang="bn">বাংলা</span>}
                        <time class="nfrow__date" datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
                      </span>
                      <span class="nfrow__title">{p.title}</span>
                      {p.summary && <span class="nfrow__sum">{p.summary}</span>}
                      <span class="nfrow__more">Read <span aria-hidden="true">→</span></span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      )}
    </div>
  </section>

  <AnimatedBand theme="cosmic">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">More from Durbin</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:24ch">The wider programme</h2>
    </Reveal>
  </AnimatedBand>

  <section class="section">
    <div class="wrap" style="display:flex;gap:1rem;flex-wrap:wrap">
      <a class="btn" href={withBase('/durbin/images')}>Astrophotography</a>
      <a class="btn" href={withBase('/durbin/manual')}>The Durbin Manual</a>
      <a class="btn" href={withBase('/news')}>All CASSA news</a>
    </div>
  </section>
</BaseLayout>
