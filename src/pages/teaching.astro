---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/immersive/AnimatedHero.astro";
import AnimatedBand from "../components/immersive/AnimatedBand.astro";
import Reveal from "../components/immersive/Reveal.astro";
import Prose from "../components/immersive/Prose.astro";
import { withBase, EXTERNAL } from "../data/site-nav.ts";

const minorFacts = [
  { n: "15", label: "Credits" },
  { n: "2", label: "Core courses" },
  { n: "5", label: "Semesters" },
  { n: "UGC", label: "Approved", raw: true },
];

const tracks = [
  {
    code: "A&A",
    name: "Astronomy & Astrophysics",
    desc: "The core path through modern astronomy — light and telescopes, stars and the interstellar medium, galaxies, and the radio universe.",
    courses: "AST 201 · AST 301 · AST 402 · AST 403 · AST 410",
  },
  {
    code: "SPS",
    name: "Space & Planetary Science",
    desc: "From planetary systems and exoplanets to the Sun–Earth space environment and the physics of the heliosphere.",
    courses: "AST 201 · AST 301 · AST 401 · AST 410 · PHY 424",
  },
];
---

<BaseLayout
  title="Teaching — CASSA"
  description="CASSA runs the first and only Minor in Astronomy & Astrophysics in Bangladesh, plus the general-education course AST 100: Our Cosmic (Hi)story, with open course materials on Abekta."
  current="/teaching"
>
  <!-- ── Hero ───────────────────────────────────────────────────────────── -->
  <AnimatedHero
    theme="galaxy"
    eyebrow="Teaching"
    title="Teaching at CASSA"
    lede="The first and only Minor in Astronomy & Astrophysics in Bangladesh — taught with equal emphasis on theory and observation, and supported by open, bilingual course materials."
  />

  <!-- ── Sub-nav strip ──────────────────────────────────────────────────── -->
  <nav style="background:var(--bg-elev);border-bottom:1px solid var(--line)">
    <div class="wrap" style="display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;padding-block:.85rem">
      <a href={withBase('/teaching/minor')} style="font-size:.85rem;padding:.3rem .75rem;border-radius:999px;color:var(--ink-soft);border:1px solid var(--line)">Minor in A&amp;A</a>
      <a href={withBase(EXTERNAL.ast100)} style="font-size:.85rem;padding:.3rem .75rem;border-radius:999px;color:var(--ink-soft);border:1px solid var(--line)">AST 100 ↗</a>
      <a href={withBase(EXTERNAL.abekta)} style="font-size:.85rem;padding:.3rem .75rem;border-radius:999px;color:var(--ink-soft);border:1px solid var(--line)">Abekta ↗</a>
    </div>
  </nav>

  <!-- ── Section 1: The Minor ───────────────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">The flagship programme</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>The Minor in Astronomy &amp; Astrophysics</h2>
          <p>
            The <strong>Department of Physical Sciences</strong> at IUB offers the
            <strong>first and only Minor in astronomy and astrophysics in Bangladesh</strong> —
            open to any student with a background in the natural sciences and mathematics, and a
            natural complement to majors in physics, mathematics, engineering, and computer
            science. The courses are organised into two tracks: <strong>Astronomy &amp;
            Astrophysics (A&amp;A)</strong> and <strong>Space &amp; Planetary Science (SPS)</strong>.
          </p>
          <p>
            <strong>CASSA contributes to the Minor</strong> by assisting with its research
            components, and every course is taught by a CASSA member.
          </p>
        </Prose>
      </Reveal>

      <div class="facts">
        {minorFacts.map((f, i) => (
          <Reveal class="fact" delay={i * 70}>
            <span class="fact__n">{f.n}</span>
            <span class="fact__l">{f.label}</span>
          </Reveal>
        ))}
      </div>

      <Reveal delay={120}>
        <a href={withBase('/teaching/minor')} class="btn btn--solid" style="margin-top:2rem;display:inline-flex">
          Explore the Minor curriculum →
        </a>
      </Reveal>
    </div>
  </section>

  <!-- ── Band ───────────────────────────────────────────────────────────── -->
  <AnimatedBand theme="cosmic">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Astronomy for everyone</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:24ch">AST 100 — Our Cosmic (Hi)story</h2>
    </Reveal>
  </AnimatedBand>

  <!-- ── Section 2: AST 100 ─────────────────────────────────────────────── -->
  <section class="section section--elev-2">
    <div class="wrap">
      <Reveal><p class="eyebrow">General education</p></Reveal>
      <Reveal delay={60}>
        <Prose>
          <h2>A tour of the universe — no maths required</h2>
          <p>
            <strong>AST 100: Our Cosmic (Hi)story</strong> is offered for IUB students who do not
            have a maths and science background. It tells the 14-billion-year history of the
            universe from a human point of view — dividing cosmic time into seven ages and tracing
            the change, governed by chance and necessity, that drives the growth of complexity.
            Open to everyone and especially popular with students from business and liberal-arts
            backgrounds, it is offered <strong>every semester</strong>.
          </p>
          <p>
            Students take photos of deep-sky objects with a <strong>Unistellar eQuinox</strong>
            telescope; the objects are explained in interactive lectures, and students prepare
            reports and presentations as their midterm and final exams.
          </p>
          <p style="font-size:.95rem">
            <a href={withBase(EXTERNAL.ast100)} style="color:var(--accent);text-decoration:underline;text-underline-offset:3px">
              Visit the AST 100 course site ↗
            </a>
          </p>
        </Prose>
      </Reveal>
    </div>
  </section>

  <!-- ── Section 3: Tracks + Abekta ─────────────────────────────────────── -->
  <section class="section section--elev">
    <div class="wrap">
      <Reveal><p class="eyebrow">Three pathways</p></Reveal>
      <Reveal delay={60}><h2 class="section-h2">Concentration tracks in the Minor</h2></Reveal>

      <div class="pg" style="margin-top:2.2rem">
        {tracks.map((t, i) => (
          <Reveal class="card" delay={i * 90}>
            <div style="display:flex;align-items:baseline;gap:.6rem">
              <span class="pill pill--accent">{t.code}</span>
              <h3 style="font-size:1.2rem;color:var(--ink)">{t.name}</h3>
            </div>
            <p style="color:var(--ink-soft);margin-top:.8rem;font-size:.97rem;line-height:1.65">{t.desc}</p>
            <p style="color:var(--ink-faint);margin-top:1rem;font-size:.85rem">{t.courses}</p>
          </Reveal>
        ))}
      </div>

      <Reveal delay={140}>
        <div class="card" style="margin-top:2.5rem;border-left:3px solid var(--accent);max-width:74ch">
          <p class="eyebrow" style="font-size:.68rem">Open course materials</p>
          <h3 style="font-size:1.25rem;color:var(--ink);margin-top:.5rem">Abekta</h3>
          <p style="color:var(--ink-soft);margin-top:.7rem;font-size:.97rem;line-height:1.7">
            Lecture notes, problem sets, and full syllabi for the Minor's courses are published
            openly on <strong>Abekta</strong>, CASSA's course-material site. Each course below links
            to its Abekta page.
          </p>
          <p style="margin-top:1rem;font-size:.95rem">
            <a href={withBase(EXTERNAL.abekta)} style="color:var(--accent);text-decoration:underline;text-underline-offset:3px">Browse Abekta ↗</a>
          </p>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .section-h2 { font-size:clamp(1.6rem,3.4vw,2.3rem); letter-spacing:-.015em; margin:.3rem 0 0; color:var(--ink); }

  .facts { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-top:2.2rem; max-width:760px; }
  @media (max-width:540px) { .facts { grid-template-columns:repeat(2,1fr); } }
  .fact { background:var(--bg-elev-2); border:1px solid var(--line); border-radius:14px; padding:1.3rem 1rem; display:flex; flex-direction:column; gap:.3rem; }
  .fact__n { font-size:clamp(1.7rem,4vw,2.4rem); font-weight:700; letter-spacing:-.03em; color:var(--accent); line-height:1; }
  .fact__l { font-size:.72rem; text-transform:uppercase; letter-spacing:.12em; color:var(--ink-faint); font-weight:600; }

  .pg { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; max-width:860px; }
  @media (max-width:860px) { .pg { grid-template-columns:1fr; } }
</style>
