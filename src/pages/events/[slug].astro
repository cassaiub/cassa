---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import Prose from "../../components/immersive/Prose.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { withBase } from "../../data/site-nav.ts";
import { eventSchema, absoluteUrl } from "../../data/seo.ts";
import { capacityForVenue, seatCountUrl } from "../../data/venues.ts";
import SeatCounter from "../../components/SeatCounter.tsx";

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) => data.status !== "draft");
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const TZ = "Asia/Dhaka";
const fmt = (date: Date, o: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: TZ, ...o }).format(date);
const dateFull = (date: Date) => fmt(date, { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const timeLabel = (date: Date) => fmt(date, { hour: "numeric", minute: "2-digit", hour12: true });

const sameDay =
  d.end && fmt(d.start, { year: "numeric", month: "2-digit", day: "2-digit" }) ===
    fmt(d.end, { year: "numeric", month: "2-digit", day: "2-digit" });

let whenDate: string;
let whenTime: string | null = null;
if (d.timeNote) {
  // Explicit override — per-day windows differ; the date is shown as a range.
  whenDate = d.end && !sameDay ? `${dateFull(d.start)} – ${dateFull(d.end)}` : dateFull(d.start);
  whenTime = d.timeNote;
} else if (d.allDay) {
  whenDate = d.end && !sameDay ? `${dateFull(d.start)} – ${dateFull(d.end)}` : dateFull(d.start);
} else if (d.daily && d.end && !sameDay) {
  // Multi-day event with the same window each day (e.g. 3–6 PM on both days),
  // not one continuous run from start to end.
  whenDate = `${dateFull(d.start)} – ${dateFull(d.end)}`;
  whenTime = `${timeLabel(d.start)} – ${timeLabel(d.end)} daily`;
} else {
  whenDate = dateFull(d.start);
  whenTime = d.end
    ? sameDay
      ? `${timeLabel(d.start)} – ${timeLabel(d.end)}`
      : `${timeLabel(d.start)} – ${dateFull(d.end!)}, ${timeLabel(d.end!)}`
    : timeLabel(d.start);
}

const seriesLabel = d.category ?? d.series;

// Registration link: external URLs open in a new tab; internal paths get base-resolved.
const registerExternal = !!d.register && /^https?:\/\//.test(d.register);
const registerHref = d.register ? (registerExternal ? d.register : withBase(d.register)) : null;

// Seat tally: when the register link is an Inside form, show a live
// "N / capacity seats reserved" counter under the button. Capacity comes from
// the venue (or a `seats:` override); the Inside count API's capacity wins.
const countUrl = seatCountUrl(d.register);
const seatCapacity = d.seats ?? capacityForVenue(d.venue);

// SEO: Event structured data + canonical.
const canonical = absoluteUrl(withBase(`/events/${entry.id}`));
const eventLd = eventSchema({
  title: d.title,
  description: d.summary ?? undefined,
  url: canonical,
  start: d.start,
  end: d.end ?? undefined,
  venue: d.venue ?? undefined,
  online: !d.venue && !!d.link,
});
---

<BaseLayout
  title={`${d.title} — CASSA Events`}
  description={d.summary ?? d.title}
  current="/events"
  lang={d.lang === "bn" ? "bn" : "en"}
  ogType="article"
  canonical={canonical}
  jsonLd={eventLd}
>
  <AnimatedHero
    theme="cosmic"
    eyebrow={`Events · ${seriesLabel}`}
    title={d.title}
    lede={d.summary ?? undefined}
    cue={false}
  />

  <section class="section section--elev">
    <div class="wrap ev-detail">
      <aside class="ev-side" data-reveal>
        <div class="ev-meta">
        <div class="ev-meta__item">
          <p class="ev-meta__lbl">When</p>
          <p class="ev-meta__val">{whenDate}</p>
          {whenTime && <p class="ev-meta__sub">{whenTime}</p>}
        </div>
        {d.venue && (
          <div class="ev-meta__item">
            <p class="ev-meta__lbl">Where</p>
            <p class="ev-meta__val">{d.venue}</p>
          </div>
        )}
        {d.organizer && (
          <div class="ev-meta__item">
            <p class="ev-meta__lbl">Organizer</p>
            <p class="ev-meta__val">{d.organizer}</p>
          </div>
        )}
        <div class="ev-meta__item">
          <p class="ev-meta__lbl">Type</p>
          <p class="ev-meta__val">{seriesLabel}</p>
        </div>
        </div>
        {registerHref && (
          <a
            class="btn btn--solid ev-register"
            href={registerHref}
            target={registerExternal ? "_blank" : undefined}
            rel={registerExternal ? "noopener" : undefined}
          >
            Register{registerExternal ? " ↗" : ""}
          </a>
        )}
        {countUrl && <SeatCounter client:load countUrl={countUrl} capacity={seatCapacity} />}
        {d.rsvpComingSoon && (
          <button class="btn btn--solid ev-register ev-rsvp-soon" type="button" disabled aria-disabled="true">
            RSVP — coming soon
          </button>
        )}
      </aside>

      <div class="ev-content" data-reveal style="--reveal-delay:80ms">
        {d.hero && (
          <figure class="ev-figure">
            <Image src={d.hero} alt={d.heroAlt ?? d.title} widths={[480, 768, 1100]} sizes="(max-width:820px) 92vw, 60vw" loading="eager" />
          </figure>
        )}
        <Prose><Content /></Prose>
        {d.link && (
          <p class="ev-cta">
            <a class="btn btn--solid" href={d.link} target="_blank" rel="noopener">Event link ↗</a>
          </p>
        )}
        <p class="ev-back"><a href={withBase("/events")}>← All events</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ev-detail { display:grid; grid-template-columns:minmax(300px,1fr) minmax(0,2fr); gap:2.4rem; align-items:start; }
  @media (max-width:820px) { .ev-detail { grid-template-columns:1fr; gap:1.6rem; } }

  /* Left column: meta card + the RSVP form, stacked. */
  .ev-side { display:flex; flex-direction:column; gap:1.4rem; }

  .ev-meta {
    display:flex; flex-direction:column; gap:1.3rem;
    background:var(--bg-elev-2); border:1px solid var(--line); border-radius:16px;
    padding:1.5rem 1.6rem;
  }
  [data-theme="light"] .ev-meta { box-shadow:0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }
  .ev-meta__lbl { font-size:.58rem; letter-spacing:.16em; text-transform:uppercase; font-weight:700; color:var(--ink-faint); margin:0 0 .35rem; }
  .ev-meta__val { color:var(--ink); margin:0; line-height:1.5; font-weight:500; }
  .ev-meta__sub { color:var(--ink-soft); margin:.2rem 0 0; font-size:.9rem; font-variant-numeric:tabular-nums; }

  .ev-figure {
    margin:0 0 1.8rem; border-radius:16px; overflow:hidden;
    border:1px solid var(--line); background:var(--bg-elev-2);
  }
  .ev-figure :global(img) { width:100%; height:auto; display:block; }
  [data-theme="light"] .ev-figure { box-shadow:0 1px 2px rgba(12,18,34,.05), 0 8px 18px rgba(12,18,34,.04); }

  /* Registration button under the meta card (left column). */
  .ev-register { width:100%; justify-content:center; text-align:center; }

  /* Live seat tally under the Register button (SeatCounter island). */
  .ev-side :global(.seat-counter) {
    margin:.65rem 0 0; font-size:.85rem; color:var(--ink-soft);
    font-variant-numeric:tabular-nums; text-align:center;
  }
  .ev-side :global(.seat-counter strong) { color:var(--ink); }
  .ev-side :global(.seat-counter__bar) {
    display:block; height:4px; border-radius:2px; background:var(--line);
    overflow:hidden; margin-bottom:.45rem;
  }
  .ev-side :global(.seat-counter__fill) {
    display:block; height:100%; border-radius:2px; background:var(--accent);
    transition:width .6s ease;
  }
  .ev-side :global(.seat-counter--full .seat-counter__fill) { background:var(--ink-faint); }

  /* Interim RSVP affordance — disabled until the new RSVP system ships. */
  .ev-rsvp-soon { opacity:.55; cursor:not-allowed; pointer-events:none; }

  .ev-cta { margin-top:1.8rem; }
  .ev-back { margin-top:1.8rem; }
  .ev-back a { color:var(--accent); }
  .ev-back a:hover { opacity:.75; }
</style>
