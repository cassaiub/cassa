---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/immersive/AnimatedHero.astro";
import OpportunityCirculars from "../../components/OpportunityCirculars.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../data/site-nav.ts";

const items = (await getCollection("opportunities", ({ data }) => data.status !== "draft" && data.kind === "job"))
  .sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout
  title="Vacancies — CASSA Opportunities"
  description="Paid research assistantships and staff roles at the Center for Astronomy, Space Science and Astrophysics (CASSA), IUB — current openings and the archive of past job circulars."
  current="/opportunities/vacancies"
>
  <AnimatedHero
    theme="cosmic"
    eyebrow="Opportunities · Vacancies"
    title="Vacancies"
    lede="Paid research assistantships and staff roles at CASSA — every current opening, with the archive of past circulars below."
  />

  <!-- Hero doubles as the open-positions heading, so the open calls lead
       immediately (leadHeading={false} hides the component's own heading). -->
  <OpportunityCirculars items={items} leadHeading={false}>
    <Fragment slot="empty">
      There are no open vacancies right now. New job circulars are posted here and announced in the
      <a href={withBase('/news')}> news feed</a> — check back, or write to
      <a href="mailto:cassa@iub.edu.bd">cassa@iub.edu.bd</a> to register your interest. Browse past
      circulars below to see the kinds of roles CASSA recruits for.
    </Fragment>
  </OpportunityCirculars>
</BaseLayout>
