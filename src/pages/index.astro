---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/immersive/Reveal.astro";
import Prose from "../components/immersive/Prose.astro";
import AnimatedBand from "../components/immersive/AnimatedBand.astro";
import FeatureSlider, { type Slide } from "../components/FeatureSlider.tsx";
import { Image } from "astro:assets";
import { withBase } from "../data/site-nav";
import { getCollection } from "astro:content";
import { isBanglaSeries } from "../data/bangla-series.ts";

// ── Hero slider ─────────────────────────────────────────────────────────────
// Top recent research / colloquia feature stories. Each slide's background is an
// ORIGINAL, code-generated animation (SkyCanvas), thematically tied to the story
// — never a static photo (rules 16 & 17).
const fallbackSlides: Slide[] = [
  {
    theme: "cosmic",
    eyebrow: "Cosmology · April 2026",
    title: "A 1% Measurement of the Universe's Expansion",
    excerpt:
      "A global collaboration — including CASSA's Syed Ashraf Uddin — wove many independent distance indicators into one network, sharpening H₀ and deepening the Hubble tension.",
    href: "https://cassa.bd/local-expansion-rate/",
  },
  {
    theme: "lensing",
    eyebrow: "Gravitational Lensing · February 2026",
    title: "The Hubble Constant from a Lensed Quasar",
    excerpt:
      "In TDCOSMO XXIII, CASSA's Anowar J. Shajib and collaborators time the flicker of the doubly lensed quasar HE 1104−1805 to clock how fast the Universe expands.",
    href: "https://cassa.bd/paic-2026/",
  },
  {
    theme: "galaxy",
    eyebrow: "Early Galaxies · May 2025",
    title: "Starbursting Clumps in a Protocluster at z = 7.88",
    excerpt:
      "With JWST, CASSA's Anowar J. Shajib and collaborators resolve sub-kiloparsec starbursts enriching a galaxy protocluster just 650 million years after the Big Bang.",
    href: "https://cassa.bd/morishita-2025/",
  },
];

const monthYear = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Dhaka", month: "long", year: "numeric" }).format(d);

// Featured items feeding the hero carousel come from BOTH news and opportunities
// (a flagged vacancy can headline the home page). Merge, newest-first, cap at 3.
type FeaturedSlide = Slide & { date: Date };
const featuredNews: FeaturedSlide[] = (
  await getCollection("news", ({ data }) => data.status !== "draft" && data.featured === true)
).map((p) => ({
  date: p.data.date,
  theme: p.data.theme ?? "cosmic",
  eyebrow: `${p.data.category ?? "News"} · ${monthYear(p.data.date)}`,
  title: p.data.title,
  excerpt: p.data.summary ?? "",
  href: withBase(`/news/${p.id}`),
}));
const featuredOpps: FeaturedSlide[] = (
  await getCollection("opportunities", ({ data }) => data.status !== "draft" && data.featured === true)
).map((o) => ({
  date: o.data.date,
  theme: o.data.theme ?? "cosmic",
  eyebrow: `Opportunity · ${monthYear(o.data.date)}`,
  title: o.data.title,
  excerpt: o.data.summary ?? "",
  href: withBase(`/opportunities/${o.id}`),
}));
const featuredSlides: Slide[] = [...featuredNews, ...featuredOpps]
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 3)
  .map(({ theme, eyebrow, title, excerpt, href }) => ({ theme, eyebrow, title, excerpt, href }));
const slides: Slide[] = featuredSlides.length > 0 ? featuredSlides : fallbackSlides;

// ── Latest strip: 3 events (upcoming first, backfilled with recent) + latest 3 news ──
const nowD = new Date();
const allEvents = await getCollection("events", ({ data }) => data.status !== "draft");
const endOf = (e: (typeof allEvents)[number]) => e.data.end ?? e.data.start;
const upcoming = allEvents
  .filter((e) => endOf(e) >= nowD)
  .sort((a, b) => +a.data.start - +b.data.start);
const recentPast = allEvents
  .filter((e) => endOf(e) < nowD)
  .sort((a, b) => +b.data.start - +a.data.start);
// Always surface 3: soonest upcoming first, then most-recent past to fill the column.
const featuredEvents = [...upcoming, ...recentPast].slice(0, 3);
// The very next upcoming event gets the glowing timeline node.
const nextEventId = upcoming[0]?.id;

// Latest institutional news — same feed as /news (excludes the Bengali series and Durbin updates).
const recentNews = (await getCollection("news", ({ data }) =>
  data.status !== "draft" && !isBanglaSeries(data.category) && data.category !== "Durbin"))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const TZ = "Asia/Dhaka";
const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("en-GB", { timeZone: TZ, ...o }).format(d);
const dDay = (d: Date) => fmt(d, { day: "2-digit" });
const dMon = (d: Date) => fmt(d, { month: "short" });
const dWkd = (d: Date) => fmt(d, { weekday: "short" });
const dTime = (d: Date) => fmt(d, { hour: "numeric", minute: "2-digit", hour12: true });
const newsDate = (d: Date) => fmt(d, { day: "numeric", month: "short", year: "numeric" });
const seriesLabel = (e: (typeof allEvents)[number]) => e.data.category ?? e.data.series;

// The three missions (Constitution cl. 30) — each routes to its hub.
const MISSIONS = [
  {
    k: "Research",
    d: "Research spanning radio astronomy, cosmology and time-domain astronomy — across simulation, instrumentation, theory and observation.",
    href: withBase("/research"),
    go: "Explore research",
  },
  {
    k: "Teaching",
    d: "IUB's UGC-approved Minor in Astronomy & Astrophysics and the AST 100 general-education course, plus summer and winter schools.",
    href: withBase("/teaching"),
    go: "Teaching at CASSA",
  },
  {
    k: "Outreach",
    d: "Durbin — astrophotography and science communication — and the Bangladesh Olympiad on Astronomy & Astrophysics (BDOAA).",
    href: withBase("/outreach"),
    go: "Outreach & Durbin",
  },
];
---

<BaseLayout
  title="CASSA — Center for Astronomy, Space Science and Astrophysics"
  description="The Center for Astronomy, Space Science and Astrophysics (CASSA) at Independent University, Bangladesh — pursuing astronomy and astrophysics through research, teaching and outreach."
  current="/"
>
  <!-- 1 · HERO — fullscreen research-story carousel over living SkyCanvas backdrops -->
  <FeatureSlider slides={slides} client:load />

  <!-- 2 · NEWS & EVENTS — the lead section right after the hero (elevated, rule 19) -->
  <section class="section section--elev hp-latest" aria-label="News and events">
    <div class="wrap">
      <div class="hp-duo">
        <!-- Upcoming events — vertical timeline -->
        <section class="hp-col" aria-labelledby="hp-events-h" data-reveal>
          <div class="hp-col__head">
            <p class="eyebrow eyebrow--sm">What's on</p>
            <h3 id="hp-events-h" class="hp-col__h">Upcoming &amp; recent events</h3>
          </div>
          {featuredEvents.length > 0 ? (
            <ol class="hp-tl">
              {featuredEvents.map((e) => (
                <li>
                  <a
                    class:list={["hp-tl__item", { "is-next": e.id === nextEventId, "is-past": endOf(e) < nowD }]}
                    href={withBase(`/events/${e.id}`)}
                  >
                    <span class="hp-tl__node" aria-hidden="true"></span>
                    <span class="hp-tl__date">
                      {dWkd(e.data.start)} {dDay(e.data.start)} {dMon(e.data.start)} · {e.data.allDay ? "All day" : dTime(e.data.start)}
                    </span>
                    <span class="hp-tl__title">{e.data.title}</span>
                    <span class="hp-tl__meta">{seriesLabel(e)}{e.data.venue ? ` · ${e.data.venue}` : ""}</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="hp-empty">Events will appear here soon.</p>
          )}
          <a class="hp-more" href={withBase('/events')}>All events <span aria-hidden="true">→</span></a>
        </section>

        <!-- Recent news — image-forward cards -->
        <section class="hp-col" aria-labelledby="hp-news-h" data-reveal style="--reveal-delay:90ms">
          <div class="hp-col__head">
            <p class="eyebrow eyebrow--sm">Latest</p>
            <h3 id="hp-news-h" class="hp-col__h">Recent news</h3>
          </div>
          {recentNews.length > 0 ? (
            <ul class="hp-news">
              {recentNews.map((p) => (
                <li>
                  <a class="hp-news__item" href={withBase(`/news/${p.id}`)}>
                    <span class="hp-news__img">
                      {p.data.hero ? (
                        <Image src={p.data.hero} alt={p.data.heroAlt ?? ""} width={340} loading="lazy" />
                      ) : (
                        <span class="hp-news__ph">
                          <span class="hp-news__ph-d">{dDay(p.data.date)}</span>
                          <span class="hp-news__ph-m">{dMon(p.data.date)}</span>
                        </span>
                      )}
                    </span>
                    <span class="hp-news__body">
                      <span class="hp-news__title">{p.data.title}</span>
                      {p.data.summary && <span class="hp-news__x">{p.data.summary}</span>}
                      <span class="hp-news__meta">{p.data.category ? `${p.data.category} · ` : ""}{newsDate(p.data.date)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="hp-empty">News will appear here soon.</p>
          )}
          <a class="hp-more" href={withBase('/news')}>All news <span aria-hidden="true">→</span></a>
        </section>
      </div>
    </div>
  </section>

  <!-- 3 · WHAT IS CASSA — condensed identity + the three missions -->
  <section class="section section--elev-2">
    <div class="wrap">
      <Reveal><p class="eyebrow">What is CASSA</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>Astronomy, astrophysics &amp; space science — pursued from Bangladesh</h2>
          <p>
            Founded in 2025, the Center for Astronomy, Space Science and Astrophysics
            (CASSA) is an autonomous, multidisciplinary research center of
            <a href="https://iub.ac.bd/" target="_blank" rel="noopener">Independent University, Bangladesh</a>,
            working under the Office of the Vice Chancellor. Its work runs on three
            missions — <strong>research, teaching and outreach</strong> — with the
            vision to be a pathfinder in Bangladesh, impactful in South Asia, and part
            of the international community in these fields.
          </p>
        </Prose>
      </Reveal>
      <Reveal delay={120}>
        <p class="hp-about"><a class="btn" href={withBase("/about")}>The full CASSA story <span aria-hidden="true">→</span></a></p>
      </Reveal>

      <ul class="hp-missions">
        {MISSIONS.map((m, i) => (
          <li>
            <a class="hp-mission" href={m.href} data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="hp-mission__k">{m.k}</span>
              <span class="hp-mission__d">{m.d}</span>
              <span class="hp-mission__go">{m.go} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · GET INVOLVED — closing band over a living SkyCanvas galaxy (rule 17) -->
  <AnimatedBand theme="galaxy">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Get involved</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.8rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:18ch">The sky belongs to everyone</h2>
      <p style="color:rgba(255,255,255,.86);max-width:54ch;margin-top:1rem">
        From public astronomy nights and the national olympiad to research
        assistantships and volunteering — there's a way in for students,
        educators and collaborators across Bangladesh.
      </p>
      <div class="stats-cta">
        <a class="btn-dark" href={withBase('/opportunities')}>Opportunities <span aria-hidden="true">→</span></a>
        <a class="btn-dark" href={withBase('/outreach')}>Outreach &amp; Durbin <span aria-hidden="true">→</span></a>
        <a class="btn-dark" href={withBase('/about')}>Get in touch <span aria-hidden="true">→</span></a>
      </div>
    </Reveal>
  </AnimatedBand>
</BaseLayout>

<style>
  /* ── News & Events — the lead section after the hero ───────────────────── */
  .hp-latest { position: relative; overflow: hidden; }
  /* soft accent glow behind the header — immersive depth, legible in both themes */
  .hp-latest::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(52% 42% at 50% -4%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 72%);
  }
  .hp-latest .wrap { position: relative; z-index: 1; }

  /* minmax(0,…): let each column shrink below its content (the nowrap venue
     line would otherwise force the events column wide and squeeze the news). */
  .hp-duo { display: grid; gap: clamp(1.6rem, 4vw, 3rem); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 820px) { .hp-duo { grid-template-columns: 1fr; gap: 2.8rem; } }

  .hp-col__head { margin-bottom: 1.3rem; }
  .hp-col__h { font-size: clamp(1.3rem, 2.6vw, 1.7rem); letter-spacing: -.015em; margin: .2rem 0 0; color: var(--ink); }
  .eyebrow--sm { font-size: .72rem; }

  /* ── Events — a quiet vertical timeline (no card boxes) ─────────────────── */
  .hp-tl { list-style: none; margin: 0; padding: 0; position: relative; }
  /* the rail: accent near "now" at the top, dissolving into the past below */
  .hp-tl::before {
    content: ""; position: absolute; left: 5px; top: 12px; bottom: 8px; width: 1px;
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--accent) 55%, transparent),
      color-mix(in srgb, var(--accent) 14%, transparent) 62%,
      transparent);
  }
  .hp-tl li + li { margin-top: 2.4rem; }
  .hp-tl__item { position: relative; display: block; padding-left: 2.1rem; min-height: 88px; }
  .hp-tl__node {
    position: absolute; left: 0; top: 3px; width: 11px; height: 11px; border-radius: 999px;
    background: var(--bg-elev); border: 2px solid var(--accent);
    transition: border-color .2s, box-shadow .2s;
  }
  /* the very next event: filled node with a breathing halo */
  .hp-tl__item.is-next .hp-tl__node {
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent);
    animation: hp-pulse 2.8s ease-in-out infinite;
  }
  @keyframes hp-pulse {
    0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
    50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 7%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) { .hp-tl__item.is-next .hp-tl__node { animation: none; } }
  .hp-tl__date {
    display: block; font-size: .72rem; letter-spacing: .15em; text-transform: uppercase;
    font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums;
  }
  .hp-tl__item.is-past .hp-tl__date { color: var(--ink-faint); }
  .hp-tl__item.is-past .hp-tl__node { border-color: color-mix(in srgb, var(--ink-faint) 55%, transparent); }
  .hp-tl__title {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin-top: .4rem; font-size: 1.08rem; font-weight: 600; color: var(--ink);
    line-height: 1.35; letter-spacing: -.008em; transition: color .2s;
  }
  .hp-tl__item:hover .hp-tl__title { color: var(--accent); }
  .hp-tl__item:hover .hp-tl__node { border-color: var(--ink); }
  .hp-tl__item.is-next:hover .hp-tl__node { border-color: var(--accent); }
  .hp-tl__meta {
    display: block; margin-top: .35rem; font-size: .78rem; color: var(--ink-faint);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* ── News — borderless editorial rows, image-forward ────────────────────── */
  .hp-news { list-style: none; margin: 0; padding: 0; }
  .hp-news li + li { margin-top: 1.55rem; }
  .hp-news__item { display: flex; gap: 1.15rem; align-items: flex-start; min-height: 88px; }
  .hp-news__img {
    flex-shrink: 0; width: clamp(122px, 15vw, 156px); aspect-ratio: 3 / 2;
    border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--bg-elev);
  }
  .hp-news__img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .hp-news__item:hover .hp-news__img :global(img) { transform: scale(1.05); }
  .hp-news__ph {
    width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
    line-height: 1; background: linear-gradient(158deg, color-mix(in srgb, var(--accent) 20%, var(--bg-elev)), var(--bg-elev));
  }
  .hp-news__ph-d { font-size: 1.5rem; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .hp-news__ph-m { font-size: .62rem; text-transform: uppercase; letter-spacing: .12em; color: var(--accent); font-weight: 700; margin-top: .2rem; }
  .hp-news__body { display: flex; flex-direction: column; min-width: 0; }
  .hp-news__title {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 1.08rem; font-weight: 600; color: var(--ink);
    line-height: 1.35; letter-spacing: -.008em; transition: color .2s;
  }
  .hp-news__item:hover .hp-news__title { color: var(--accent); }
  .hp-news__x {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin-top: .35rem; font-size: .88rem; color: var(--ink-soft); line-height: 1.5;
  }
  .hp-news__meta {
    display: block; margin-top: .45rem; font-size: .7rem; letter-spacing: .13em;
    text-transform: uppercase; font-weight: 600; color: var(--ink-faint);
  }
  @media (max-width: 480px) {
    .hp-news__item { gap: .9rem; }
    .hp-news__img { width: 108px; }
    .hp-news__x { display: none; }
  }

  .hp-empty { color: var(--ink-soft); margin-top: 1.3rem; line-height: 1.7; }
  .hp-more { display: inline-block; margin-top: 1.3rem; color: var(--accent); font-weight: 600; font-size: .9rem; }
  .hp-more:hover { opacity: .75; }

  @media (prefers-reduced-motion: reduce) {
    .hp-item, .hp-thumb :global(img) { transition: none; }
    .hp-item:hover { transform: none; }
    .hp-item:hover .hp-thumb :global(img) { transform: none; }
  }

  /* ── What is CASSA — the three mission cards ───────────────────────────── */
  .hp-about { margin-top: 1.8rem; }
  .hp-missions {
    list-style: none; margin: 2.8rem 0 0; padding: 0;
    display: grid; gap: 1.2rem; grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 760px) { .hp-missions { grid-template-columns: 1fr; } }
  .hp-mission {
    display: flex; flex-direction: column; gap: .55rem; height: 100%;
    background: var(--bg-elev); border: 1px solid var(--line); border-radius: 16px;
    padding: 1.5rem; transition: border-color .2s, transform .2s;
  }
  .hp-mission::before {
    content: ""; display: block; width: 30px; height: 3px; border-radius: 2px;
    background: var(--accent); margin-bottom: .5rem; opacity: .9;
  }
  .hp-mission:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); transform: translateY(-3px); }
  [data-theme="light"] .hp-mission { box-shadow: 0 1px 2px rgba(12,18,34,.05), 0 10px 24px rgba(12,18,34,.05); }
  .hp-mission__k { font-size: 1.25rem; font-weight: 700; color: var(--ink); letter-spacing: -.01em; }
  .hp-mission__d { font-size: .95rem; color: var(--ink-soft); line-height: 1.6; flex: 1; }
  .hp-mission__go { font-size: .86rem; font-weight: 600; color: var(--accent); margin-top: .3rem; }
  .hp-mission:hover .hp-mission__go { text-decoration: underline; }

  /* CTA buttons used on the dark bands (closing) */
  .stats-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.8rem; }
  .btn-dark {
    display: inline-block; padding: .6rem 1.15rem; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.4); color: #fff; font-weight: 600; font-size: .92rem;
    transition: background .2s, border-color .2s;
  }
  .btn-dark:hover { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.7); }
  /* Day theme: the closing band goes pale (band--sky), so the outline CTAs flip to ink. */
  :global([data-theme="light"]) .btn-dark { border-color: rgba(12,18,34,.38); color: var(--ink); }
  :global([data-theme="light"]) .btn-dark:hover { background: rgba(12,18,34,.08); border-color: var(--ink); }
</style>
