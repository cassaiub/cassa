---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/immersive/Reveal.astro";
import Prose from "../components/immersive/Prose.astro";
import AnimatedBand from "../components/immersive/AnimatedBand.astro";
import FeatureSlider, { type Slide } from "../components/FeatureSlider.tsx";
import { Image } from "astro:assets";
import { withBase } from "../data/site-nav";
import { getCollection } from "astro:content";
import { isBanglaSeries } from "../data/bangla-series.ts";
import { recentPublications } from "../data/recent-publications.ts";

// The 7 most recent CASSA papers (same local ADS snapshot as /research/publications).
// Each gets a plain one-sentence credit: "<lead> et al., CASSA author: <name>".
const recentPapers = recentPublications(7).map((p) => {
  const lead = `${p.firstAuthor}${p.etAl ? " et al." : ""}`;
  const extra = p.cassaAuthors.filter((a) => a !== p.firstAuthor); // drop the lead if they're the CASSA member
  let credit = lead;
  if (extra.length > 0) credit = `${lead}, CASSA author${extra.length > 1 ? "s" : ""}: ${extra.join(", ")}`;
  else if (p.cassaAuthors.length > 0) credit = `${lead} (CASSA author)`; // the lead is themselves the CASSA member
  return { ...p, credit };
});

// ── Hero slider ─────────────────────────────────────────────────────────────
// Top recent research / colloquia feature stories. Each slide's background is an
// ORIGINAL, code-generated animation (SkyCanvas), thematically tied to the story
// — never a static photo (rules 16 & 17).
const fallbackSlides: Slide[] = [
  {
    theme: "cosmic",
    eyebrow: "Cosmology · April 2026",
    title: "A 1% Measurement of the Universe's Expansion",
    excerpt:
      "A global collaboration — including CASSA's Syed Ashraf Uddin — wove many independent distance indicators into one network, sharpening H₀ and deepening the Hubble tension.",
    href: "https://cassa.bd/local-expansion-rate/",
  },
  {
    theme: "lensing",
    eyebrow: "Gravitational Lensing · February 2026",
    title: "The Hubble Constant from a Lensed Quasar",
    excerpt:
      "In TDCOSMO XXIII, CASSA's Anowar J. Shajib and collaborators time the flicker of the doubly lensed quasar HE 1104−1805 to clock how fast the Universe expands.",
    href: "https://cassa.bd/paic-2026/",
  },
  {
    theme: "galaxy",
    eyebrow: "Early Galaxies · May 2025",
    title: "Starbursting Clumps in a Protocluster at z = 7.88",
    excerpt:
      "With JWST, CASSA's Anowar J. Shajib and collaborators resolve sub-kiloparsec starbursts enriching a galaxy protocluster just 650 million years after the Big Bang.",
    href: "https://cassa.bd/morishita-2025/",
  },
];

const monthYear = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Dhaka", month: "long", year: "numeric" }).format(d);

// Featured items feeding the hero carousel come from BOTH news and opportunities
// (a flagged vacancy can headline the home page). Merge, newest-first, cap at 3.
type FeaturedSlide = Slide & { date: Date };
const featuredNews: FeaturedSlide[] = (
  await getCollection("news", ({ data }) => data.status !== "draft" && data.featured === true)
).map((p) => ({
  date: p.data.date,
  theme: p.data.theme ?? "cosmic",
  eyebrow: `${p.data.category ?? "News"} · ${monthYear(p.data.date)}`,
  title: p.data.title,
  excerpt: p.data.summary ?? "",
  href: withBase(`/news/${p.id}`),
}));
const featuredOpps: FeaturedSlide[] = (
  await getCollection("opportunities", ({ data }) => data.status !== "draft" && data.featured === true)
).map((o) => ({
  date: o.data.date,
  theme: o.data.theme ?? "cosmic",
  eyebrow: `Opportunity · ${monthYear(o.data.date)}`,
  title: o.data.title,
  excerpt: o.data.summary ?? "",
  href: withBase(`/opportunities/${o.id}`),
}));
// A flagged event (e.g. a marquee colloquium) can also headline the hero. Keyed
// on the event's start date so an upcoming event sorts to the front.
const featuredEventSlides: FeaturedSlide[] = (
  await getCollection("events", ({ data }) => data.status !== "draft" && data.featured === true)
).map((e) => ({
  date: e.data.start,
  theme: e.data.theme ?? "cosmic",
  eyebrow: `${e.data.category ?? "Event"} · ${monthYear(e.data.start)}`,
  title: e.data.title,
  excerpt: e.data.summary ?? "",
  href: withBase(`/events/${e.id}`),
}));
const featuredSlides: Slide[] = [...featuredNews, ...featuredOpps, ...featuredEventSlides]
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 3)
  .map(({ theme, eyebrow, title, excerpt, href }) => ({ theme, eyebrow, title, excerpt, href }));
// TDMMA 2026 — a bespoke page, not a collection entry, so it can't carry a
// `featured` flag; pinned here by hand as the lead slide while applications
// are open (through 7 Aug 2026). Remove after the workshop.
const tdmmaSlide: Slide = {
  theme: "merger",
  eyebrow: "Workshop · 7–11 September 2026",
  title: "Time-Domain & Multi-Messenger Astronomy",
  excerpt:
    "Five days on the astronomy of a changing sky — lectures and hands-on tutorials at IUB, with visiting lecturer Andrew L. Miller. Applications close 14 August 2026.",
  href: withBase("/tdmma-2026"),
  cta: "Explore & apply",
};
const slides: Slide[] = [tdmmaSlide, ...(featuredSlides.length > 0 ? featuredSlides : fallbackSlides)];

// ── Latest strip: 3 events (upcoming first, backfilled with recent) + latest 3 news ──
const nowD = new Date();
const allEvents = await getCollection("events", ({ data }) => data.status !== "draft");
const endOf = (e: (typeof allEvents)[number]) => e.data.end ?? e.data.start;
const upcoming = allEvents
  .filter((e) => endOf(e) >= nowD)
  .sort((a, b) => +a.data.start - +b.data.start);
const recentPast = allEvents
  .filter((e) => endOf(e) < nowD)
  .sort((a, b) => +b.data.start - +a.data.start);
// Always surface 3: soonest upcoming first, then most-recent past to fill the column.
const featuredEvents = [...upcoming, ...recentPast].slice(0, 3);
// The very next upcoming event gets the glowing timeline node.
const nextEventId = upcoming[0]?.id;

// Latest institutional news — same feed as /news (excludes the Bengali series).
const recentNews = (await getCollection("news", ({ data }) =>
  data.status !== "draft" && !isBanglaSeries(data.category)))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const TZ = "Asia/Dhaka";
const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("en-GB", { timeZone: TZ, ...o }).format(d);
const dDay = (d: Date) => fmt(d, { day: "2-digit" });
const dMon = (d: Date) => fmt(d, { month: "short" });
const dWkd = (d: Date) => fmt(d, { weekday: "short" });
const dTime = (d: Date) => fmt(d, { hour: "numeric", minute: "2-digit", hour12: true });
const newsDate = (d: Date) => fmt(d, { day: "numeric", month: "short", year: "numeric" });
const seriesLabel = (e: (typeof allEvents)[number]) => e.data.category ?? e.data.series;

// The three missions (Constitution cl. 30) — each routes to its hub.
const MISSIONS = [
  {
    k: "Research",
    d: "Research spanning radio astronomy, cosmology and time-domain astronomy — across simulation, instrumentation, theory and observation.",
    href: withBase("/research"),
    go: "Explore research",
  },
  {
    k: "Teaching",
    d: "IUB's UGC-approved Minor in Astronomy & Astrophysics and the AST 100 general-education course, plus summer and winter schools.",
    href: withBase("/teaching"),
    go: "Teaching at CASSA",
  },
  {
    k: "Outreach",
    d: "Durbin — astrophotography and science communication — and the Bangladesh Olympiad on Astronomy & Astrophysics (BDOAA).",
    href: withBase("/outreach"),
    go: "Outreach & Durbin",
  },
];
---

<BaseLayout
  title="CASSA — Center for Astronomy, Space Science and Astrophysics"
  description="The Center for Astronomy, Space Science and Astrophysics (CASSA) at Independent University, Bangladesh — pursuing astronomy and astrophysics through research, teaching and outreach."
  current="/"
>
  <!-- 1 · HERO — fullscreen research-story carousel over living SkyCanvas backdrops -->
  <FeatureSlider slides={slides} client:load />

  <!-- 2 · NEWS & EVENTS — the lead section right after the hero (elevated, rule 19) -->
  <section class="section section--elev hp-latest" aria-label="News and events">
    <div class="wrap">
      <div class="hp-duo">
        <!-- Upcoming events — vertical timeline -->
        <section class="hp-col" aria-labelledby="hp-events-h" data-reveal>
          <div class="hp-col__head">
            <p class="eyebrow eyebrow--sm">What's on</p>
            <h3 id="hp-events-h" class="hp-col__h"><a class="hp-col__link" href={withBase('/events')}>Upcoming &amp; recent events</a></h3>
          </div>
          {featuredEvents.length > 0 ? (
            <ol class="hp-tl">
              {featuredEvents.map((e) => (
                <li>
                  <a
                    class:list={["hp-tl__item", { "is-next": e.id === nextEventId, "is-past": endOf(e) < nowD }]}
                    href={withBase(`/events/${e.id}`)}
                  >
                    <span class="hp-tl__node" aria-hidden="true"></span>
                    <span class="hp-tl__date">
                      {dWkd(e.data.start)} {dDay(e.data.start)} {dMon(e.data.start)} · {e.data.allDay ? "All day" : dTime(e.data.start)}
                    </span>
                    <span class="hp-tl__title">{e.data.title}</span>
                    <span class="hp-tl__meta">{seriesLabel(e)}{e.data.venue ? ` · ${e.data.venue}` : ""}</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="hp-empty">Events will appear here soon.</p>
          )}
          <a class="hp-more" href={withBase('/events')}>All events <span aria-hidden="true">→</span></a>
        </section>

        <!-- Recent news — image-forward cards -->
        <section class="hp-col" aria-labelledby="hp-news-h" data-reveal style="--reveal-delay:90ms">
          <div class="hp-col__head">
            <p class="eyebrow eyebrow--sm">Latest</p>
            <h3 id="hp-news-h" class="hp-col__h"><a class="hp-col__link" href={withBase('/news')}>Recent news</a></h3>
          </div>
          {recentNews.length > 0 ? (
            <ul class="hp-news">
              {recentNews.map((p) => (
                <li>
                  <a class="hp-news__item" href={withBase(`/news/${p.id}`)}>
                    <span class="hp-news__img">
                      {p.data.hero ? (
                        <Image src={p.data.hero} alt={p.data.heroAlt ?? ""} width={340} loading="lazy" />
                      ) : (
                        <span class="hp-news__ph">
                          <span class="hp-news__ph-d">{dDay(p.data.date)}</span>
                          <span class="hp-news__ph-m">{dMon(p.data.date)}</span>
                        </span>
                      )}
                    </span>
                    <span class="hp-news__body">
                      <span class="hp-news__title">{p.data.title}</span>
                      {p.data.summary && <span class="hp-news__x">{p.data.summary}</span>}
                      <span class="hp-news__meta">{p.data.category ? `${p.data.category} · ` : ""}{newsDate(p.data.date)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="hp-empty">News will appear here soon.</p>
          )}
          <a class="hp-more" href={withBase('/news')}>All news <span aria-hidden="true">→</span></a>
        </section>
      </div>
    </div>
  </section>

  <!-- 2.5 · RECENT PUBLICATIONS — the 7 newest CASSA papers (BG tone: sits between
       the elevated News&Events above and the elev-2 What-is-CASSA below) -->
  <section class="section hp-pubs" aria-label="Recent publications">
    <div class="wrap">
      <div class="hp-col__head" data-reveal>
        <p class="eyebrow eyebrow--sm">From the journals</p>
        <h3 class="hp-col__h"><a class="hp-col__link" href={withBase('/research/publications')}>Recent publications</a></h3>
      </div>

      {recentPapers.length > 0 && (
        <div class="rp-outer" data-reveal style="--reveal-delay:80ms">
          <button class="rp-btn" id="rp-prev" type="button" aria-label="Newer papers" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>

          <div class="rp-scroll" id="rp-scroll" tabindex="0" aria-label="Recent publications timeline — newest first; drag or pan right for older">
            <div class="rp-track" id="rp-track">
              {recentPapers.map((p) => (
                <div class="rp-col">
                  <div class="rp__above">
                    {p.pubMonth && <span class="rp__mon">{p.pubMonth}</span>}
                    <span class="rp__yr">{p.year}</span>
                  </div>
                  <div class="rp__node"></div>
                  <a
                    class="rp__card"
                    href={p.doiUrl ?? withBase('/research/publications')}
                    target={p.doiUrl ? "_blank" : undefined}
                    rel={p.doiUrl ? "noopener noreferrer" : undefined}
                  >
                    <span class="rp__journal">{p.journal}</span>
                    <span class="rp__title">{p.title}</span>
                    <span class="rp__by">{p.credit}</span>
                    <span class="rp__foot">
                      <span class="rp__cite">{p.reference}</span>
                      <span class="rp__go" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
                      </span>
                    </span>
                  </a>
                </div>
              ))}
            </div>
          </div>

          <button class="rp-btn" id="rp-next" type="button" aria-label="Older papers">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      )}
      <div class="rp-bar" aria-hidden="true"><div class="rp-bar__thumb" id="rp-bar-thumb"></div></div>
      <a class="hp-more" href={withBase('/research/publications')}>All publications <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 3 · WHAT IS CASSA — condensed identity + the three missions -->
  <section class="section section--elev-2">
    <div class="wrap">
      <Reveal><p class="eyebrow">What is CASSA</p></Reveal>
      <Reveal delay={70}>
        <Prose>
          <h2>Astronomy, astrophysics &amp; space science — pursued from Bangladesh</h2>
          <p>
            Founded in 2025, the Center for Astronomy, Space Science and Astrophysics
            (CASSA) is an autonomous, multidisciplinary research center of
            <a href="https://iub.ac.bd/" target="_blank" rel="noopener">Independent University, Bangladesh</a>,
            working under the Office of the Vice Chancellor. Its work runs on three
            missions — <strong>research, teaching and outreach</strong> — with the
            vision to be a pathfinder in Bangladesh, impactful in South Asia, and part
            of the international community in these fields.
          </p>
        </Prose>
      </Reveal>
      <Reveal delay={120}>
        <p class="hp-about"><a class="btn" href={withBase("/about")}>The full CASSA story <span aria-hidden="true">→</span></a></p>
      </Reveal>

      <ul class="hp-missions">
        {MISSIONS.map((m, i) => (
          <li>
            <a class="hp-mission" href={m.href} data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="hp-mission__k">{m.k}</span>
              <span class="hp-mission__d">{m.d}</span>
              <span class="hp-mission__go">{m.go} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · GET INVOLVED — closing band over a living SkyCanvas galaxy (rule 17) -->
  <AnimatedBand theme="galaxy">
    <Reveal>
      <p class="eyebrow" style="color:#fff;opacity:.85">Get involved</p>
      <h2 style="color:#fff;font-size:clamp(1.7rem,4vw,2.8rem);letter-spacing:-.02em;margin:.4rem 0 0;max-width:18ch">The sky belongs to everyone</h2>
      <p style="color:rgba(255,255,255,.86);max-width:54ch;margin-top:1rem">
        From public astronomy nights and the national olympiad to research
        assistantships and volunteering — there's a way in for students,
        educators and collaborators across Bangladesh.
      </p>
      <div class="stats-cta">
        <a class="btn-dark" href={withBase('/opportunities')}>Opportunities <span aria-hidden="true">→</span></a>
        <a class="btn-dark" href={withBase('/outreach')}>Outreach &amp; Durbin <span aria-hidden="true">→</span></a>
        <a class="btn-dark" href={withBase('/about')}>Get in touch <span aria-hidden="true">→</span></a>
      </div>
    </Reveal>
  </AnimatedBand>
</BaseLayout>

<script>
  // Recent-publications horizontal timeline: arrows / keyboard / wheel / drag,
  // progress thumb, spine-fill on reveal, and start at the newest (right) end.
  const scroll = document.getElementById("rp-scroll");
  const track  = document.getElementById("rp-track");
  const prev   = document.getElementById("rp-prev") as HTMLButtonElement | null;
  const next   = document.getElementById("rp-next") as HTMLButtonElement | null;
  const thumb  = document.getElementById("rp-bar-thumb");
  if (scroll && prev && next) {
    const JUMP = 300 * 2;
    prev.addEventListener("click", () => scroll.scrollBy({ left: -JUMP, behavior: "smooth" }));
    next.addEventListener("click", () => scroll.scrollBy({ left:  JUMP, behavior: "smooth" }));
    scroll.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft")  { e.preventDefault(); scroll.scrollBy({ left: -JUMP, behavior: "smooth" }); }
      if (e.key === "ArrowRight") { e.preventDefault(); scroll.scrollBy({ left:  JUMP, behavior: "smooth" }); }
    });
    scroll.addEventListener("wheel", (e) => {
      if (Math.abs(e.deltaX) > 4) return;
      e.preventDefault();
      scroll.scrollBy({ left: e.deltaY * 1.4, behavior: "smooth" });
    }, { passive: false });
    let drag = false, sx = 0, sl = 0;
    scroll.addEventListener("mousedown", (e) => { drag = true; sx = e.pageX; sl = scroll.scrollLeft; scroll.style.cursor = "grabbing"; });
    window.addEventListener("mouseup", () => { drag = false; scroll.style.cursor = ""; });
    window.addEventListener("mousemove", (e) => { if (drag) scroll.scrollLeft = sl - (e.pageX - sx); });
    const updateUI = () => {
      const max = scroll.scrollWidth - scroll.clientWidth;
      prev.disabled = scroll.scrollLeft <= 1;
      next.disabled = scroll.scrollLeft >= max - 1;
      if (thumb && max > 0) {
        const w = (scroll.clientWidth / scroll.scrollWidth) * 100;
        thumb.style.width = w + "%";
        thumb.style.left = ((scroll.scrollLeft / max) * (100 - w)) + "%";
      }
    };
    scroll.addEventListener("scroll", updateUI, { passive: true });
    window.addEventListener("resize", updateUI, { passive: true });
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (track) {
      if (reduced) track.style.setProperty("--rp-fill", "100%");
      else {
        const obs = new IntersectionObserver(([en]) => {
          if (!en.isIntersecting) return;
          obs.disconnect();
          let start: number | null = null;
          const D = 1600;
          const anim = (ts: number) => { if (start === null) start = ts; const pct = Math.min(100, ((ts - start) / D) * 100); track.style.setProperty("--rp-fill", pct + "%"); if (pct < 100) requestAnimationFrame(anim); };
          requestAnimationFrame(anim);
        }, { threshold: 0.25 });
        obs.observe(track);
      }
    }
    // Default view = newest (leftmost); pan right for older.
    requestAnimationFrame(updateUI);
  }
</script>

<style>
  /* ── Recent publications — full-width immersive paper cards ─────────────── */
  .hp-pubs { position: relative; overflow: hidden; }
  .hp-pubs::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(48% 40% at 88% -6%, color-mix(in srgb, var(--accent-2) 12%, transparent), transparent 70%);
  }
  .hp-pubs .wrap { position: relative; z-index: 1; }

  /* Horizontal pannable publication timeline (drag / wheel / arrows / keys). */
  .rp-outer { display: flex; align-items: stretch; gap: 10px; margin-top: 2rem; }
  .rp-btn {
    flex-shrink: 0; width: 42px; border-radius: 12px; align-self: center; height: 42px;
    border: 1px solid var(--line-strong); background: var(--bg-elev); color: var(--ink);
    cursor: pointer; display: grid; place-items: center; z-index: 4;
    transition: border-color .2s, transform .15s, opacity .2s;
  }
  .rp-btn:hover:not(:disabled) { border-color: var(--accent); transform: scale(1.1); }
  .rp-btn:disabled { opacity: .22; cursor: default; }
  [data-theme="light"] .rp-btn { box-shadow: 0 1px 4px rgba(12,18,34,.08); }

  .rp-scroll { flex: 1; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; cursor: grab; outline: none; border-radius: 4px; -webkit-overflow-scrolling: touch; }
  .rp-scroll::-webkit-scrollbar { display: none; }
  .rp-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* align-items: stretch → every column (and its card) grows to the tallest
     card's natural height: equal-size cards, minimal whitespace, no cropping,
     fully dynamic across screens/fonts (no fixed pixel height). */
  .rp-track { display: flex; align-items: stretch; position: relative; padding: 0 28px; --rp-fill: 0%; }
  /* the spine + its old→new glowing fill */
  .rp-track::before { content: ""; position: absolute; top: 62px; left: 0; right: 0; height: 2px; background: var(--line-strong); z-index: 0; }
  .rp-track::after {
    content: ""; position: absolute; top: 62px; left: 0; width: var(--rp-fill); height: 2px;
    background: linear-gradient(to right, var(--accent-2), var(--accent));
    box-shadow: 0 0 16px color-mix(in srgb, var(--accent) 60%, transparent); z-index: 1;
  }

  .rp-col { width: 300px; flex-shrink: 0; padding: 0 12px; display: flex; flex-direction: column; align-items: center; }
  .rp__above { height: 56px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: .05rem; padding-bottom: 12px; }
  .rp__mon { font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--accent); }
  .rp__yr { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -.02em; color: var(--ink-soft); font-variant-numeric: tabular-nums; line-height: 1; }

  .rp__node {
    width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; z-index: 2; position: relative;
    background: var(--bg); border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent); transition: transform .2s;
  }
  /* newest (first / leftmost column) pulses */
  .rp-col:first-child .rp__node { background: var(--accent); animation: rp-pulse 2.6s ease-in-out infinite; }
  @keyframes rp-pulse { 0%,100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); } 50% { box-shadow: 0 0 0 12px color-mix(in srgb, var(--accent) 0%, transparent); } }
  @media (prefers-reduced-motion: reduce) { .rp-col:first-child .rp__node { animation: none; } }
  .rp-col:hover .rp__node { transform: scale(1.28); }

  /* flex:1 → the card fills its (stretched) column, so all cards match the
     tallest card's height. Variable parts are clamped (journal 2, title 3,
     author lines 1) so the tallest is bounded; footer pins to the bottom. */
  .rp__card {
    margin-top: 14px; width: 100%; flex: 1; display: flex; flex-direction: column;
    position: relative; overflow: hidden;
    background: var(--bg-elev); border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.15rem;
    transition: border-color .22s, transform .22s, box-shadow .22s;
  }
