---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import HeroIdent from "./HeroIdent.astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  kenburns?: boolean;
  cue?: boolean;
}
const {
  image,
  alt,
  eyebrow,
  title,
  lede,
  kenburns = true,
  cue = true,
} = Astro.props;
---

<header class="hero">
  <HeroIdent />
  <div class:list={["hero__media", { kenburns }]}>
    <Image
      src={image}
      alt={alt}
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      fetchpriority="high"
      loading="eager"
    />
  </div>
  <div class="hero__scrim"></div>

  <div class="wrap hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">{title}</h1>
    {lede && <p class="hero__lede">{lede}</p>}
  </div>

  {cue && (
    <div class="hero__cue" aria-hidden="true"><span></span></div>
  )}
</header>
