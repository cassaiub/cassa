---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}
const { image, alt } = Astro.props;
---

<section class="band">
  <div class="band__media">
    <Image src={image} alt={alt} widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" />
  </div>
  <div class="band__scrim"></div>
  <div class="wrap band__inner"><slot /></div>
</section>
