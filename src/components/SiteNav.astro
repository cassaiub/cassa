---
import { NAV, withBase } from "../data/site-nav";
import ThemeToggle from "./ThemeToggle.tsx";

interface Props {
  current?: string;
  lang?: "en" | "bn";
  altHref?: string;
  langToggle?: boolean;
}
const { current = "", lang = "en", altHref, langToggle = false } = Astro.props;
const items = NAV.filter((n) => n.href !== "/");

/** True when the current path is inside this nav item's subtree.
    Sections gather pages from outside their own path prefix (Newsroom → /news,
    About → /coc), and every page now names itself precisely in `current` so the
    right dropdown entry highlights — so also match any listed descendant. */
function isSectionActive(n: (typeof items)[number], cur: string): boolean {
  if (!cur) return false;
  if (n.href !== "/" && (cur === n.href || cur.startsWith(n.href + "/"))) return true;
  if (n.children?.some((c) => c.href === cur)) return true;
  return (
    n.groups?.some((g) => g.href === cur || g.children.some((c) => c.href === cur)) ?? false
  );
}

/** Stable id for the panel a top-level button controls (aria-controls). */
const panelId = (label: string) =>
  "nav-menu-" + label.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<nav class="nav" id="site-nav" aria-label="Primary">
  <div class="wrap nav__row">
    <a class="nav__brand" href={withBase("/")} aria-label="CASSA — home">
      <img class="nav__logo nav__logo--white" src={withBase("/brand/CASSA-Logo_White.svg")} alt="CASSA" width="87" height="30" />
      <img class="nav__logo nav__logo--color" src={withBase("/brand/CASSA-Logo_Color.svg")} alt="" aria-hidden="true" width="87" height="30" />
    </a>

    <div class="nav__right">
      <div class="nav__panel" id="nav-panel">
        {
          items.map((n) => {
            const active = isSectionActive(n, current);
            if (!n.live) {
              return <span class="nav__link nav__link--soon" title="Coming soon">{n.label}</span>;
            }
            if (n.groups && n.groups.length > 0) {
              return (
                <div class="nav__item" data-has-children>
                  <button
                    class:list={["nav__link", "nav__link--parent", { "nav__link--active": active }]}
                    type="button"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={panelId(n.label)}
                  >
                    {n.label}
                  </button>
                  <div class="nav__megamenu" id={panelId(n.label)} role="menu">
                    {n.groups.map((group) => (
                      <div class="nav__megamenu-col">
                        {group.href ? (
                          <a
                            class:list={["nav__megamenu-col-head", "nav__megamenu-col-head--link", { "nav__submenu-link--active": current === group.href }]}
                            href={withBase(group.href)}
                            role="menuitem"
                            aria-current={current === group.href ? "page" : undefined}
                          >{group.label}</a>
                        ) : (
                          <p class="nav__megamenu-col-head">{group.label}</p>
                        )}
                        {group.children.map((child) => (
                          child.live === false ? (
                            <span class="nav__submenu-link nav__submenu-link--soon" title="Coming soon">{child.label}</span>
                          ) : (
                            <a
                              class:list={["nav__submenu-link", { "nav__submenu-link--active": current === child.href }]}
                              href={withBase(child.href)}
                              role="menuitem"
                              aria-current={current === child.href ? "page" : undefined}
                            >{child.label}</a>
                          )
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              );
            }
            if (n.children && n.children.length > 0) {
              return (
                <div class="nav__item" data-has-children>
                  <button
                    class:list={["nav__link", "nav__link--parent", { "nav__link--active": active }]}
                    type="button"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={panelId(n.label)}
                  >
                    {n.label}
                  </button>
                  <div class="nav__submenu" id={panelId(n.label)} role="menu">
                    {n.children.map((child) => (
                      <a
                        class:list={[
                          "nav__submenu-link",
                          { "nav__submenu-link--active": current === child.href },
                        ]}
                        href={withBase(child.href)}
                        role="menuitem"
                        target={child.href.startsWith("http") ? "_blank" : undefined}
                        rel={child.href.startsWith("http") ? "noopener" : undefined}
                        aria-current={current === child.href ? "page" : undefined}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              );
            }
            return (
              <a
                class:list={["nav__link", { "nav__link--active": active }]}
                href={withBase(n.href)}
                aria-current={current === n.href ? "page" : undefined}
              >
                {n.label}
              </a>
            );
          })
        }
      </div>

      <button class="nav__burger" id="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-panel">
        <svg class="nav__burger-icon nav__burger-icon--open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        <svg class="nav__burger-icon nav__burger-icon--close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>

      {altHref && (
        <a
          class="toggle lang-toggle"
          href={withBase(altHref)}
          aria-label={lang === "en" ? "বাংলায় পড়ুন — read this page in Bangla" : "Read this page in English"}
          title={lang === "en" ? "বাংলা" : "English"}
        >{lang === "en" ? "BN" : "EN"}</a>
      )}

      {!altHref && langToggle && (
        <button
          class="toggle lang-toggle"
          id="essay-lang-toggle"
          type="button"
          aria-pressed="false"
          aria-label="বাংলায় পড়ুন — read this page in Bangla"
          title="বাংলা"
        >BN</button>
      )}

      <ThemeToggle client:load />
    </div>
  </div>
</nav>

<script>
  /* ── Scroll shrink ─────────────────────────────────────────────────── */
  const nav = document.getElementById("site-nav");
  const onScroll = () =>
    nav && nav.classList.toggle("is-scrolled", window.scrollY > 24);
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });

  /* ── Burger / mobile panel ─────────────────────────────────────────── */
  const burger = document.getElementById("nav-burger");
  const panel = document.getElementById("nav-panel");
  const setMenu = (open: boolean) => {
    panel?.classList.toggle("is-open", open);
    // Lock page scroll + neutralise the nav's backdrop-filter while open.
    document.documentElement.classList.toggle("nav-open", open);
    burger?.setAttribute("aria-expanded", String(open));
    burger?.setAttribute("aria-label", open ? "Close menu" : "Menu");
    if (!open) {
      // Collapse any expanded sections so the menu reopens clean.
      panel?.querySelectorAll(".nav__item.is-open").forEach((i) => {
        i.classList.remove("is-open");
        i.querySelector(".nav__link--parent")?.setAttribute("aria-expanded", "false");
      });
    }
  };
  burger?.addEventListener("click", () =>
    setMenu(!panel?.classList.contains("is-open")),
  );
  // Close the mobile menu after following a link.
  panel?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false)),
  );
  const closeItem = (item: Element) => {
    item.classList.remove("is-open");
    item.querySelector(".nav__link--parent")?.setAttribute("aria-expanded", "false");
  };
  const openItem = (item: Element) => {
    item.classList.add("is-open");
    item.querySelector(".nav__link--parent")?.setAttribute("aria-expanded", "true");
    // One open panel at a time.
    document.querySelectorAll(".nav__item.is-open").forEach((other) => {
      if (other !== item) closeItem(other);
    });
  };

  // Escape closes the overlay and any open dropdown (returning focus to its button).
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (panel?.classList.contains("is-open")) setMenu(false);
    document.querySelectorAll(".nav__item.is-open").forEach((item) => {
      const hadFocus = item.contains(document.activeElement);
      closeItem(item);
      if (hadFocus) item.querySelector<HTMLButtonElement>(".nav__link--parent")?.focus();
    });
  });

  /* ── Top-level label: opens its dropdown, never navigates ──────────── */
  // A section label is a <button>, not a link. Every page in the section —
  // including its landing page — is listed inside the dropdown, so the button
  // has only one job: disclose the panel. Click/tap works at every width, which
  // is also the guaranteed path on touchscreens (tablets, IFPs, touch laptops).
  document.querySelectorAll<HTMLButtonElement>(".nav__link--parent").forEach((btn) => {
    const item = btn.closest(".nav__item");
    if (!item) return;
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (item.classList.contains("is-open")) closeItem(item);
      else openItem(item);
    });
    // Mouse users on desktop still get hover-to-open. Driving it from JS (rather
    // than a CSS :hover rule) keeps `is-open` the single source of truth, so a
    // click can always close what a hover opened.
    item.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType !== "mouse") return;
      if (!matchMedia("(min-width: 861px) and (hover: hover)").matches) return;
      openItem(item);
    });
    item.addEventListener("pointerleave", (e) => {
      if ((e as PointerEvent).pointerType !== "mouse") return;
      if (!matchMedia("(min-width: 861px) and (hover: hover)").matches) return;
      closeItem(item);
    });
  });

  /* ── Dropdowns: close on outside click/tap ─────────────────────────── */
  document.addEventListener("click", (e) => {
    document.querySelectorAll(".nav__item[data-has-children].is-open").forEach((item) => {
      if (!item.contains(e.target as Node)) closeItem(item);
    });
  });

  /* ── In-page language toggle ───────────────────────────────────────────
     On pages that hold both languages (e.g. an astrophotography entry with an
     English body + a Bengali essay), the top-right button flips the page
     between EN and BN in place instead of navigating. Markup opts in by
     marking blocks with `data-lang="en"` / `data-lang="bn"`; visibility is
     driven by the `data-page-lang` attribute on <html> (see global.css). */
  const essayToggle = document.getElementById("essay-lang-toggle");
  essayToggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const toBn = root.getAttribute("data-page-lang") !== "bn";
    root.setAttribute("data-page-lang", toBn ? "bn" : "en");
    essayToggle.textContent = toBn ? "EN" : "BN";
    essayToggle.setAttribute("aria-pressed", String(toBn));
    essayToggle.setAttribute("title", toBn ? "English" : "বাংলা");
    essayToggle.setAttribute(
      "aria-label",
      toBn ? "Read this page in English" : "বাংলায় পড়ুন — read this page in Bangla",
    );
  });
</script>

<style is:global>
  /* ── Dropdown wrapper ──────────────────────────────────────────────── */
  .nav__item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* ── Parent label (a button, not a link) ───────────────────────────── */
  /* Top-level sections do not navigate — the label only discloses the
     dropdown, which lists every page in the section including its landing
     page. No chevron: the panel itself is the affordance. Reset the UA button
     styling so it renders identically to the plain .nav__link items beside it. */
  .nav__link--parent {
    display: inline-flex;
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    margin: 0;
    padding: 0;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: inherit;
    text-align: left;
    cursor: pointer;
  }
  /* Open section reads as accented — the panel below is the real affordance. */
  .nav .nav__item.is-open > .nav__link--parent { color: var(--accent); }

  /* ── Dropdown panel (desktop) ──────────────────────────────────────── */
  .nav__submenu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 200px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
    padding: 0.45rem 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    z-index: 200;
  }

  /* Invisible bridge fills the 10px gap so the cursor never leaves
     .nav__item while moving from the parent link to the panel. */
  .nav__item[data-has-children]::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -20px;
    right: -20px;
    height: 12px;
  }

  /* Open state (desktop): `.is-open`, set by click/tap on the label button or
     by the JS mouse-hover handler, plus keyboard focus landing in the panel. */
  @media (min-width: 861px) {
    .nav__item.is-open .nav__submenu,
    .nav__submenu:focus-within {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
  }

  /* ── Submenu links ─────────────────────────────────────────────────── */
  .nav__submenu-link {
    display: block;
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.14s ease, color 0.14s ease;
    border-radius: 0;
  }

  .nav__submenu-link:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--ink);
  }

  .nav__submenu-link--active {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-weight: 600;
  }

  /* Coming-soon child (no link yet) */
  .nav__submenu-link--soon {
    color: var(--ink-faint);
    cursor: default;
    opacity: 0.7;
  }
  .nav__submenu-link--soon::after {
    content: "Soon";
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    margin-left: 0.5em;
    padding: 0.1em 0.45em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-faint);
    vertical-align: middle;
  }
  .nav__submenu-link--soon:hover { background: transparent; color: var(--ink-faint); }

  /* round top / bottom corners of first and last items */
  .nav__submenu-link:first-child {
    border-radius: 11px 11px 0 0;
  }

  .nav__submenu-link:last-child {
    border-radius: 0 0 11px 11px;
  }

  .nav__submenu-link:only-child {
    border-radius: 11px;
  }

  /* ── Megamenu (2-column, Research) ────────────────────────────────────── */
  .nav__megamenu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
    padding: 0.6rem 0.3rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(175px, 1fr);
    gap: 0 0.3rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 200;
  }
  @media (min-width: 861px) {
    .nav__item.is-open .nav__megamenu,
    .nav__megamenu:focus-within {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
  }
  .nav__megamenu-col { display: flex; flex-direction: column; }
  /* Group heads read as the headline of each megamenu column — larger, brighter
     and sentence-case so they stand out clearly above their child links. */
  .nav__megamenu-col-head {
    font-size: 1rem;
    letter-spacing: -0.005em;
    text-transform: none;
    font-weight: 800;
    color: var(--ink);
    padding: 0.3rem 1.1rem 0.45rem;
    margin: 0 0 0.2rem;
    border-bottom: 1px solid var(--line);
  }
  /* Clickable group head (e.g. BDOAA → its landing page) */
  .nav__megamenu-col-head--link {
    display: block;
    text-decoration: none;
    transition: color 0.14s ease;
  }
  .nav__megamenu-col-head--link:hover {
    color: var(--accent);
  }

  /* ── Active parent highlight ───────────────────────────────────────── */
  .nav__link--active {
    color: var(--accent) !important;
  }

  /* ── Language toggle — a circle identical to the theme toggle (reuses .toggle),
        showing the OTHER language's code (BN on English pages, EN on Bangla). ── */
  .lang-toggle {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  /* ── Mobile: immersive full-screen menu (≤860px) ───────────────────── */
  @media (max-width: 860px) {
    .nav__item {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      border-bottom: 1px solid var(--line);
    }
    .nav__panel > .nav__link,
    .nav__panel > .nav__link--soon {
      border-bottom: 1px solid var(--line);
    }
    .nav__item:last-child,
    .nav__panel > .nav__link:last-child {
      border-bottom: none;
    }

    /* Big, legible type for top-level entries. */
    .nav__link--parent,
    .nav__panel > .nav__link,
    .nav__panel > .nav__link--soon {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.015em;
      padding: 0.85rem 0;
    }

    /* Full-width tap target: the whole label line expands its section. */
    .nav__link--parent { width: 100%; }

    /* Collapsible nested lists — clearly legible over the solid overlay, set off
       by an accent rule and a modest indent (not pushed off to the left). */
    .nav__submenu,
    .nav__megamenu {
      position: static;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      box-shadow: none;
      border: none;
      border-left: 2px solid color-mix(in srgb, var(--accent) 45%, var(--line));
      border-radius: 0;
      background: transparent;
      min-width: 0;
      margin: 0 0 0.7rem 0.1rem;
      padding: 0.1rem 0 0.1rem 1.1rem;
      display: none;
      flex-direction: column;
      gap: 0;
    }
    .nav__item.is-open > .nav__submenu,
    .nav__item.is-open > .nav__megamenu {
      display: flex;
      animation: navSubReveal 0.26s ease both;
    }
    @keyframes navSubReveal {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: none; }
    }

    .nav__submenu-link {
      font-size: 1.08rem;
      font-weight: 500;
      color: var(--ink-soft);
      padding: 0.5rem 0.3rem;
      border-radius: 8px !important;
      white-space: normal;
    }
    .nav__submenu-link:hover,
    .nav__submenu-link:active { background: transparent; color: var(--ink); }
    .nav__submenu-link--active { background: transparent; color: var(--accent); }

    /* Megamenu group heads become uppercase subsection labels on mobile. */
    .nav__megamenu-col + .nav__megamenu-col { margin-top: 0.35rem; }
    .nav__megamenu-col-head {
      border-bottom: none;
      margin: 0;
      padding: 0.55rem 0.3rem 0.1rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .nav__megamenu-col-head--link { color: var(--ink-soft); }
    .nav__megamenu-col-head--link:hover { color: var(--accent); }
  }
</style>
