---
/* Reusable right slide-in drawer that shows a PersonCard. Any element on the
   page with `data-person="<slug>"` opens the matching card. Render once per
   page with the list of people whose cards should be available. The PersonCard
   is the same component used everywhere, so cards are identical site-wide. */
import PersonCard from "./PersonCard.astro";

interface Person {
  slug: string;
  name: string;
  title?: string;
  tier: string;
  interests?: string[];
  institution?: string;
  education?: string;
  research?: string;
  email?: string;
  photo?: string;
  links?: Record<string, string>;
  website?: string;
}
interface Props { people: Person[] }
const { people } = Astro.props;
---

{people.length > 0 && (
  <div id="person-drawer" class="pdrawer" hidden>
    <div class="pdrawer__scrim" data-pdrawer-close></div>
    <aside class="pdrawer__panel" role="dialog" aria-modal="true" aria-label="Profile" tabindex="-1">
      <button type="button" class="pdrawer__close" data-pdrawer-close aria-label="Close profile">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <div class="pdrawer__cards">
        {people.map((person) => (
          <div class="pdrawer__card" data-card={person.slug} hidden>
            <PersonCard
              name={person.name}
              title={person.title}
              tier={person.tier}
              interests={person.interests}
              institution={person.institution}
              education={person.education}
              research={person.research}
              email={person.email}
              photo={person.photo}
              links={person.links ?? {}}
              website={person.website}
            />
          </div>
        ))}
      </div>
    </aside>
  </div>
)}

<script is:inline>
  (function () {
    var drawer = document.getElementById("person-drawer");
    if (!drawer) return;
    var panel = drawer.querySelector(".pdrawer__panel");
    var cards = Array.prototype.slice.call(drawer.querySelectorAll(".pdrawer__card"));
    var closeBtn = drawer.querySelector(".pdrawer__close");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    var lastFocus = null;
    function open(slug, trigger) {
      var found = false;
      cards.forEach(function (c) {
        var m = c.getAttribute("data-card") === slug;
        c.hidden = !m;
        if (m) found = true;
      });
      if (!found) return false;
      lastFocus = trigger || null;
      drawer.hidden = false;
      requestAnimationFrame(function () { drawer.classList.add("is-open"); });
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
      return true;
    }
    function close() {
      if (drawer.hidden) return;
      drawer.classList.remove("is-open");
      document.body.style.overflow = "";
      var done = false;
      var finish = function () { if (done) return; done = true; drawer.hidden = true; };
      if (reduce.matches) finish();
      else { if (panel) panel.addEventListener("transitionend", finish, { once: true }); setTimeout(finish, 420); }
      if (lastFocus && lastFocus.focus) lastFocus.focus();
      lastFocus = null;
    }
    document.addEventListener("click", function (e) {
      var opener = e.target.closest && e.target.closest("[data-person]");
      if (opener) { if (open(opener.getAttribute("data-person"), opener)) e.preventDefault(); return; }
      if (e.target.closest && e.target.closest("[data-pdrawer-close]")) { e.preventDefault(); close(); }
    });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
  })();
</script>

<style>
  .pdrawer { position: fixed; inset: 0; z-index: 1000; }
  .pdrawer[hidden] { display: none; }
  .pdrawer__scrim { position: absolute; inset: 0; background: rgba(3, 6, 14, .58); opacity: 0; transition: opacity .3s ease; }
  .pdrawer.is-open .pdrawer__scrim { opacity: 1; }
  .pdrawer__panel {
    position: absolute; top: 0; right: 0; height: 100%;
    width: min(420px, 92vw); overflow-y: auto;
    background: var(--bg-elev); border-left: 1px solid var(--line);
    box-shadow: -20px 0 50px rgba(3, 6, 14, .4);
    padding: 3.2rem 1.3rem 1.6rem;
    transform: translateX(100%); transition: transform .32s cubic-bezier(.4, 0, .2, 1);
  }
  .pdrawer.is-open .pdrawer__panel { transform: translateX(0); }
  .pdrawer__close {
    position: absolute; top: .8rem; right: .8rem; z-index: 1;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; border-radius: 999px;
    background: var(--bg-elev-2); border: 1px solid var(--line);
    color: var(--ink-soft); cursor: pointer; transition: color .2s, border-color .2s;
  }
  .pdrawer__close:hover { color: var(--ink); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .pdrawer__card :global(.pcard) { background: var(--bg-elev-2); }
  @media (prefers-reduced-motion: reduce) {
    .pdrawer__scrim, .pdrawer__panel { transition: none; }
  }
</style>
